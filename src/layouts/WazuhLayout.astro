---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";
import Mascot from "../components/global/Mascot.astro";
import GoogleAnalytics from "../components/global/GoogleAnalytics.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { localizePath, localesFor } from "../i18n/config";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = "https://aisecurity.es/og-image.png"
} = Astro.props;

const SITE = "https://aisecurity.es";
const wazuhAlternates = localesFor("/wazuh").map((l) => ({
  locale: l,
  href: `${SITE}${localizePath("/wazuh", l)}`,
}));
---

<html
  lang="es"
  class="scroll-smooth selection:bg-accent-500 selection:text-white no-touchevents hydrated">
  <head>
    <GoogleAnalytics />
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
    />
    {wazuhAlternates.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://aisecurity.es/wazuh" />
  </head>
  <body class="bg-base-50 flex flex-col min-h-svh">
    <Navigation />
    <main class="grow"><slot /></main>
    <Footer />
    <Mascot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
