    publishDate: "2026-03-06",
    readTime: "10 min",
    tags: ["Wazuh", "Règles", "Alertes", "NAS", "SIEM", "Cybersécurité"],
    category: "Wazuh & Sécurité"
  },
  {
    slug: "flujo-logs-wazuh-decoders-reglas-alertas",
    title: "Flux des journaux dans Wazuh : décodeurs, règles et alertes",
    description: "Comprenez comment Wazuh traite les journaux : pré-décodeur, décodeur, règles et alertes. Configurez des notifications par e-mail, Discord ou Slack.",
    publishDate: "2026-03-04",
    readTime: "12 min",
    tags: ["Wazuh", "Décodeurs", "Règles", "Alertes", "SIEM", "Journaux"],
    category: "Wazuh & Sécurité"
  },
  {
    slug: "configurar-equipos-sin-agente-wazuh-syslog",
    title: "Surveiller des appareils sans agent dans Wazuh avec Syslog",
    description: "Surveillez routeurs, switchs, NAS et appareils sans agent en utilisant rsyslog comme collecteur. Configuration complète avec templates, filtres et intégration Wazuh.",
    publishDate: "2026-03-08",
    readTime: "8 min",
    tags: ["Wazuh", "Syslog", "rsyslog", "Sans agent", "SIEM", "Réseau"],
    category: "Wazuh & Sécurité"
  },
  {
    slug: "configuracion-de-grupos-en-wazuh",
    title: "Comment configurer des groupes d'agents dans Wazuh",
    description: "Apprenez à organiser vos agents en groupes (Windows, Linux, bases de données) et à pousser des configurations ossec.conf centralisées vers chaque agent du groupe.",
    publishDate: "2026-02-26",
    readTime: "10 min",
    tags: ["Wazuh", "Groupes", "Configuration", "SIEM", "Gestion", "Cybersécurité"],
    category: "Wazuh & Sécurité"
  },
  {
    slug: "que-es-wazuh-para-que-sirve",
    title: "Qu'est-ce que Wazuh et à quoi ça sert : SIEM/XDR open source [2026]",
    description: "Ce qu'est Wazuh, à quoi il sert et comment il protège votre entreprise : détection des menaces, conformité, surveillance des journaux sous Linux et Windows. Guide avec exemples réels.",
    publishDate: "2026-02-12",
    readTime: "10 min",
    tags: ["Wazuh", "SIEM", "XDR", "Cybersécurité", "Open Source", "Surveillance"],
    category: "Wazuh & Sécurité"
  },
  {
    slug: "como-instalar-wazuh-con-docker",
