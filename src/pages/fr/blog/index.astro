    publishDate: "2026-03-06",
    readTime: "12 min",
    tags: ["Wazuh", "Alertes", "Postfix", "Gmail", "SMTP", "E-mail", "ENS", "ISO 27001"],
    category: "Wazuh & Sécurité"
