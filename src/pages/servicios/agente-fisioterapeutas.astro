---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "IA para fisioterapeutas: citas y atención | AI Security";
const description = "Agente IA para clínicas de fisioterapia: atiende llamadas y WhatsApp, gestiona citas y ofrece reservas web. Descubre las demos y adáptalo a tu clínica.";
const canonical = "https://aisecurity.es/servicios/agente-fisioterapeutas";
const contact = "/presupuesto?plan=Agente-IA-Fisioterapeutas";
const faqs = [
  { q: "¿Qué puede hacer el agente IA para una clínica de fisioterapia?", a: "Puede atender consultas sobre horarios y servicios, recoger solicitudes de cita, gestionar cambios y enviar confirmaciones según las reglas de tu clínica. Las decisiones clínicas quedan en manos de los profesionales." },
  { q: "¿Pueden elegir con qué fisioterapeuta reservar?", a: "Sí. La reserva web permite seleccionar el servicio y el profesional. Configuramos la duración de las sesiones y la disponibilidad de cada miembro del equipo." },
  { q: "¿Se integra con la agenda que ya utilizamos?", a: "Primero revisamos tu calendario o software de gestión y sus posibilidades de integración. Te indicamos qué se puede conectar antes de preparar la propuesta." },
  { q: "¿Tengo que contratar llamadas, WhatsApp y web juntos?", a: "No. Puedes empezar por el canal que más necesita tu clínica y ampliar después. El alcance y el presupuesto se adaptan a los canales y las integraciones elegidas." },
  { q: "¿Las demos de esta página crean citas reales?", a: "No. Son ejemplos simulados con datos ficticios. Puedes probar los canales sin enviar datos de pacientes ni reservar una cita real." },
];
const benefits = [
  { n:"01", title:"Atiende sin interrumpir la sesión", text:"Responde a las preguntas habituales mientras tu equipo está con un paciente. Las consultas que necesitan una persona se derivan a la clínica." },
  { n:"02", title:"Una agenda con tus reglas", text:"Servicios, duración de las sesiones y disponibilidad por fisioterapeuta. El sistema se configura a partir de cómo trabajáis." },
  { n:"03", title:"Menos tareas entre pacientes", text:"Confirmaciones, recordatorios y cambios de cita. Reduce el trabajo repetitivo de recepción y facilita que el paciente avise a tiempo." },
];
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org", "@graph":[
      {"@type":"Service", name:"Agente IA para fisioterapeutas", url:canonical, description, serviceType:"Atención y gestión de citas para clínicas de fisioterapia", provider:{"@type":"Organization", name:"AI Security", url:"https://aisecurity.es"}},
      {"@type":"FAQPage", mainEntity:faqs.map(f=>({"@type":"Question",name:f.q,acceptedAnswer:{"@type":"Answer",text:f.a}}))}
    ]
  })} />
  <div class="physio">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">IA para clínicas de fisioterapia</p>
          <h1>Tú cuidas al paciente.<br/><span>Tu recepción sigue atendiendo.</span></h1>
          <p class="lead">Llamadas, WhatsApp y reservas web. Un asistente que organiza las citas de tu clínica mientras tu equipo se dedica a lo importante.</p>
          <a class="primary" href={contact}>Quiero verlo en mi clínica <span aria-hidden="true">↗</span></a>
          <div class="hero-notes"><span>Tu agenda</span><span>Tus profesionales</span><span>Tus horarios</span></div>
        </div>
        <div class="workspace" id="demo">
          <div class="workspace-top"><div class="clinic-mark" aria-hidden="true">f.</div><div><strong>Tu clínica, conectada</strong><small>Demostración · FisioVital</small></div><span class="example">Datos ficticios</span></div>
          <div class="tabs" role="tablist" aria-label="Canal de la demostración">
            <button id="tab-whatsapp" role="tab" aria-selected="true" aria-controls="panel-whatsapp" data-channel="whatsapp">WhatsApp</button>
            <button id="tab-llamada" role="tab" aria-selected="false" aria-controls="panel-llamada" tabindex="-1" data-channel="llamada">Llamadas</button>
            <button id="tab-web" role="tab" aria-selected="false" aria-controls="panel-web" tabindex="-1" data-channel="web">Reserva web</button>
          </div>
          <div id="panel-whatsapp" role="tabpanel" aria-labelledby="tab-whatsapp" class="demo-panel">
            <div class="panel-heading"><span class="status-dot" aria-hidden="true"></span>Recepción · FisioVital <small>Ejemplo de conversación</small></div>
            <div class="messages" id="wa-messages" aria-live="polite"><p class="bubble">Hola, soy el asistente de FisioVital. ¿Quieres reservar una cita o consultar nuestros horarios?</p><p class="bubble patient">¿Puedo reservar con Laura por la tarde?</p><p class="bubble">Sí. En esta demo tienes una sesión con Laura a las 16:30. ¿Te viene bien?</p></div>
            <div class="quick-replies" aria-label="Respuestas para probar"><button data-reply="reservar">Confirmar cita ↗</button><button data-reply="cambiar">Cambiar horario</button><button data-reply="horarios">Ver horarios</button></div>
            <p class="demo-note">Prueba las respuestas. No se envían mensajes reales.</p>
          </div>
          <div id="panel-llamada" role="tabpanel" aria-labelledby="tab-llamada" class="demo-panel" hidden>
            <div class="panel-heading">Atención telefónica · FisioVital <small>Simulación guiada</small></div>
            <div class="phone-layout">
              <div class="phone-shell">
                <div class="phone-screen">
                  <div class="phone-top" aria-hidden="true"><span>9:41</span><i></i><span>▮▮▮</span></div>
                  <div class="phone-contact"><div class="phone-avatar" aria-hidden="true">FV</div><h3>FisioVital</h3><p>Recepción de tu clínica</p></div>
                  <p id="call-status" role="status">Elige el motivo de tu llamada</p>
                  <div id="call-clock" class="phone-clock">00:00</div>
                  <div class="voice" aria-hidden="true"><i style="--i:0;--h:12px"></i><i style="--i:1;--h:29px"></i><i style="--i:2;--h:14px"></i><i style="--i:3;--h:31px"></i><i style="--i:4;--h:16px"></i><i style="--i:5;--h:33px"></i><i style="--i:6;--h:18px"></i><i style="--i:7;--h:35px"></i><i style="--i:8;--h:20px"></i><i style="--i:9;--h:37px"></i><i style="--i:10;--h:22px"></i><i style="--i:11;--h:39px"></i><i style="--i:12;--h:24px"></i></div>
                  <label class="field">Motivo de la llamada<select id="call-scenario"><option value="reservar">Reservar cita</option><option value="modificar">Cambiar cita</option><option value="pago">Servicios y tarifas</option></select></label>
                  <button id="call-play" class="phone-call" aria-label="Llamar a FisioVital (demostración)">
                    <span class="phone-call-icon"><svg width="25" height="25" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg></span>
                    <span id="call-label">Llamar</span>
                  </button><div class="phone-home" aria-hidden="true"></div>
                </div>
              </div>
              <div class="transcription-card"><div class="transcription-heading"><strong>Transcripción</strong><span id="transcript-state">En espera</span></div>
                <div class="transcript" id="transcript" role="log" aria-label="Transcripción de la llamada" aria-live="polite"><p>Selecciona un motivo y pulsa Llamar. Aquí podrás seguir la conversación.</p></div>
                <p class="transcription-foot">Paciente y recepción, paso a paso.</p>
              </div>
            </div>
            <p class="demo-note">Voz del navegador cuando esté disponible. Clínica y tarifas de ejemplo.</p>
          </div>
          <div id="panel-web" role="tabpanel" aria-labelledby="tab-web" class="demo-panel" hidden>
            <div class="panel-heading">Reserva en la web de tu clínica <small>Widget de ejemplo</small></div>
            <form id="booking">
              <div class="form-row"><label class="field">Servicio<select id="service"><option>Primera visita · 45 min</option><option>Sesión de fisioterapia · 50 min</option><option>Seguimiento · 30 min</option></select></label><label class="field">Profesional<select id="professional"><option>Laura</option><option>Marcos</option><option>Sin preferencia</option></select></label></div>
              <p class="availability">Selecciona un día y una hora</p>
              <div id="days" class="days" aria-label="Días de ejemplo"></div>
              <div class="times" aria-label="Horas de ejemplo"><button type="button" data-time="09:00" aria-pressed="false">09:00</button><button type="button" data-time="11:30" aria-pressed="false">11:30</button><button type="button" data-time="16:30" aria-pressed="false">16:30</button><button type="button" data-time="18:00" aria-pressed="false">18:00</button></div>
              <button type="submit" class="primary wide">Probar reserva <span aria-hidden="true">↗</span></button>
              <p id="booking-result" role="status" class="booking-result">Elige tu cita para ver la confirmación.</p>
            </form>
            <p class="demo-note">Disponibilidad simulada. No se crea ninguna cita real.</p>
          </div>
          <div class="workspace-foot"><span aria-hidden="true">↳</span> Una experiencia adaptada a tu clínica.</div>
        </div>
      </div>
      <div class="wrap channel-strip"><span>Una recepción. Tres formas de llegar.</span><p>Por teléfono <b>／</b> Por WhatsApp <b>／</b> Desde tu web</p></div>
    </section>
    <section class="section benefits">
      <div class="wrap"><div class="section-intro"><p class="eyebrow">Más tiempo para tratar. Menos tiempo para gestionar.</p><h2>La atención empieza<br/>antes de entrar en consulta.</h2></div>
        <div class="benefit-grid">{benefits.map(b=><article><span class="number">{b.n}</span><h3>{b.title}</h3><p>{b.text}</p></article>)}</div>
      </div>
    </section>
    <section class="section integration"><div class="wrap integration-grid">
      <div><p class="eyebrow">Así encaja en tu día a día</p><h2>Tu forma de trabajar.<br/><span>Sin empezar de cero.</span></h2><p class="lead">Desde una consulta individual hasta una clínica con varios profesionales. Definimos juntos qué puede resolver el asistente y cuándo debe intervenir recepción.</p><a class="text-link" href={contact}>Cuéntanos cómo organizas tu clínica ↗</a></div>
      <div class="steps">
        <article><span>01</span><div><h3>Revisamos tu agenda</h3><p>Estudiamos los canales, las preguntas frecuentes y las posibilidades de conexión de tu software.</p></div></article>
        <article><span>02</span><div><h3>Configuramos tu recepción</h3><p>Servicios, profesionales, horarios y criterios de derivación. Todo con la información de tu clínica.</p></div></article>
        <article><span>03</span><div><h3>Probamos con tu equipo</h3><p>Validamos las conversaciones y las reservas antes de activar los canales acordados.</p></div></article>
      </div>
    </div></section>
    <section class="section faq"><div class="wrap faq-grid"><div><p class="eyebrow">Lo que conviene saber</p><h2>Antes de dar<br/>el siguiente paso.</h2><p>La IA ayuda con la recepción. El criterio clínico sigue siendo de tu equipo.</p></div><div>{faqs.map(f=><details><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div></div></section>
    <section class="closing"><div class="wrap closing-inner"><p class="eyebrow">Hablemos de tu clínica</p><h2>Una recepción más ágil.<br/><span>Un equipo más centrado.</span></h2><p>Cuéntanos qué tareas os quitan tiempo. Te proponemos por dónde empezar y qué integraciones tienen sentido.</p><a class="primary" href={contact}>Solicitar información <span aria-hidden="true">↗</span></a><a class="text-link" href="#demo">Volver a probar las demos ↑</a></div></section>
  </div>
</BaseLayout>

<style>
  .physio{--ink:#f1f5f9;--muted:#94a3b8;--line:rgba(255,255,255,.09);color:var(--ink);background:#0a0d14;font-family:inherit}
  .physio :is(h1,h2,h3,strong){color:var(--ink)}.physio p{color:var(--muted);line-height:1.7;margin:0;max-width:none}
  .wrap{width:min(1240px,calc(100% - 64px));margin-inline:auto}.hero{padding:78px 0 0;background:radial-gradient(ellipse at 82% 25%,rgba(99,102,241,.07),transparent 50%),#0a0d14;overflow:hidden}
  .hero-grid{display:grid;grid-template-columns:1fr 1.03fr;gap:64px;align-items:center}.eyebrow{font-size:12px!important;letter-spacing:.12em;color:#94a3b8!important;margin-bottom:22px!important}
  h1{font-size:clamp(38px,4.15vw,62px);font-weight:600;letter-spacing:-.045em;line-height:1.12;margin:0 0 25px}h1 span,h2 span{color:#cbd5e1}
  .lead{font-size:17px;margin-bottom:30px!important}.primary{display:inline-flex;align-items:center;justify-content:center;gap:26px;padding:15px 22px;border-radius:9px;background:#4f46e5;color:#fff!important;font-size:14px;font-weight:650;text-decoration:none;border:1px solid #6366f1;cursor:pointer;transition:background .2s,transform .2s}.primary:hover{background:#4338ca;transform:translateY(-2px)}.primary span{font-size:19px}.hero-notes{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:#94a3b8;margin-top:22px}.hero-notes span:before{content:'✓';margin-right:6px;color:#a5b4fc}
  .workspace{min-width:0;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:#161b25;box-shadow:0 35px 90px #0005;transform:rotate(-1deg)}.workspace-top{display:flex;align-items:center;gap:12px;padding:21px 23px;border-bottom:1px solid var(--line)}.clinic-mark{width:37px;height:37px;border-radius:11px;background:#a5b4fc;color:#172033;font-size:26px;display:grid;place-items:center;font-weight:700}.workspace-top strong{font-size:14px}.workspace-top small{display:block;color:#94a3b8;font-size:11px;margin-top:3px}.example{font-size:10px;color:#94a3b8;margin-left:auto}
  .tabs{display:flex;padding:14px 20px 0;gap:6px}.tabs button{flex:1;background:none;border:0;border-bottom:2px solid transparent;color:#b1b5c9;padding:12px 3px;font-size:13px;cursor:pointer}.tabs button[aria-selected=true]{color:#e2e8f0;border-color:#a5b4fc;background:linear-gradient(0deg,#a5b4fc10,transparent)}
  .demo-panel{padding:23px;min-height:380px}.demo-panel[hidden]{display:none}.panel-heading{font-size:12px;color:#e2e8f0;display:flex;align-items:center;gap:8px;margin-bottom:22px}.panel-heading small{margin-left:auto;color:#94a3b8;font-size:10px}.status-dot{width:6px;height:6px;background:#c1abfa;border-radius:50%}.messages{display:flex;flex-direction:column;gap:12px;height:232px;overflow-y:auto;padding-right:5px}.messages :global(.bubble){background:#202735;border-radius:12px 12px 12px 3px;padding:12px 15px;font-size:13px;max-width:88%!important;color:#e2e8f0!important}.messages :global(.bubble.patient){background:#25334d;align-self:flex-end;border-radius:12px 12px 3px 12px}.quick-replies{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px}.quick-replies button,.times button,.days :global(button){border:1px solid #465169;background:#a5b4fc09;border-radius:7px;color:#cbd5e1;padding:8px 10px;font-size:11px;cursor:pointer}.quick-replies button:hover,.times button:hover,.days :global(button):hover{background:#a5b4fc24}.demo-note{font-size:10px;margin-top:15px!important}.workspace-foot{border-top:1px solid var(--line);padding:14px 23px;font-size:11px;color:#b1b5c9}.workspace-foot span{color:#a5b4fc;margin-right:8px}
  .channel-strip{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding:27px 0;margin-top:64px;gap:20px;font-size:12px;color:#94a3b8}.channel-strip p{font-size:14px;color:#cbd5e1}.channel-strip b{color:#64748b;margin:0 13px}
  .section{padding:92px 0}h2{font-size:clamp(29px,3vw,43px);line-height:1.17;letter-spacing:-.035em;font-weight:550;margin:0 0 24px}.section-intro{text-align:center}.section-intro .eyebrow{margin-inline:auto}.benefits{background:#0f1117}.benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;margin-top:48px}.benefit-grid article{border-top:1px solid #394457;padding-top:25px}.number{font-size:12px;color:#a5b4fc}.benefit-grid h3{font-size:21px;line-height:1.35;letter-spacing:-.02em;margin:20px 0 13px}.benefit-grid p,.steps p{font-size:14px}
  .integration-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.text-link{display:inline-block;color:#a5b4fc!important;font-size:14px;text-decoration:none;border-bottom:1px solid #475569;padding-bottom:5px}.steps article{display:flex;gap:25px;padding:25px 0;border-bottom:1px solid var(--line)}.steps article>span{font-size:12px;color:#a5b4fc;padding-top:3px}.steps h3{font-size:18px;margin:0 0 10px}.faq{background:#0f1117}.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.faq-grid>div>p{font-size:15px}.faq details{border-bottom:1px solid var(--line);padding:20px 0}.faq summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:15px;list-style:none;color:#e2e8f0}.faq summary::-webkit-details-marker{display:none}.faq summary span{color:#a5b4fc;font-size:22px}.faq details[open] summary span{transform:rotate(45deg)}.faq details p{font-size:14px;padding:17px 22px 0 0}
  .closing{padding:90px 0;background:radial-gradient(ellipse at 50% 100%,#6366f114,transparent 70%),#0a0d14}.closing-inner{text-align:center}.closing p{max-width:540px;margin:0 auto 26px}.closing .eyebrow{max-width:none}.closing .text-link{display:block;width:fit-content;margin:24px auto 0;font-size:12px}
  .call-center{text-align:center;padding:0 0 15px}.call-center strong{font-size:13px;display:block;margin-top:12px}.voice{height:62px;display:flex;justify-content:center;align-items:center;gap:5px}.voice i{width:4px;height:var(--h);background:#a5b4fc;border-radius:5px}.playing .voice i{animation:voice 1s calc(var(--i)*.05s) infinite alternate}@keyframes voice{to{transform:scaleY(.3)}}.field{display:block;font-size:11px;color:#b1b5c9}.field select{display:block;width:100%;min-width:0;margin:8px 0 15px;padding:10px 8px;border:1px solid #465169;border-radius:7px;background:#181f32;color:#f1f5f9;font-size:12px}.wide{width:100%;padding:11px;font-size:12px}.transcript{height:95px;overflow-y:auto;margin-top:14px}.transcript :global(p){font-size:12px;margin-bottom:10px}.transcript :global(strong){color:#a5b4fc}.form-row{display:grid;grid-template-columns:1.3fr 1fr;gap:12px}.availability{font-size:12px;margin:7px 0 14px!important}.days{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}.days :global(button){font-size:12px;line-height:1.8}.times{display:flex;gap:8px;margin:16px 0}.times button{flex:1}.days :global(button)[aria-pressed=true],.times button[aria-pressed=true]{background:#4f46e5;color:#fff;border-color:#a5b4fc}.booking-result{font-size:12px;margin-top:14px!important;min-height:40px}.physio :is(a,button,summary,select):focus-visible{outline:2px solid #93c5fd;outline-offset:4px}
  @media(max-width:1000px){.hero-grid{gap:30px}.wrap{width:calc(100% - 40px)}.integration-grid{gap:45px}.faq-grid{gap:40px}.workspace{transform:none}.hero{padding-top:48px}}
  @media(max-width:760px){.hero-grid,.integration-grid,.faq-grid{grid-template-columns:1fr}.hero-copy{max-width:580px}.hero-grid{gap:35px}h1{font-size:42px}.workspace{width:100%}.channel-strip{flex-direction:column;align-items:flex-start;margin-top:35px;gap:9px}.benefit-grid{grid-template-columns:1fr;gap:28px}.section,.closing{padding:60px 0}.section-intro{text-align:left}.section-intro .eyebrow{text-align:left}.benefit-grid h3{margin-top:12px}.workspace-top{padding:18px}.demo-panel{padding:18px}.panel-heading small{font-size:9px}.example{font-size:9px}.tabs{padding-inline:13px}}
  @media(prefers-reduced-motion:reduce){.physio *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

  .phone-layout{display:grid;grid-template-columns:210px minmax(0,1fr);gap:16px;align-items:stretch}
  .phone-shell{background:#1f2633;border:1px solid #465169;border-radius:29px;padding:6px;box-shadow:0 12px 30px #0004}
  .phone-screen{background:linear-gradient(#121a29,#080b12);border-radius:23px;overflow:hidden;padding:10px 14px;display:flex;flex-direction:column;align-items:center;min-height:424px}
  .phone-top{display:flex;justify-content:space-between;align-items:center;width:100%;font-size:9px;color:#cbd5e1}.phone-top i{width:56px;height:13px;background:#04060c;border-radius:10px}
  .phone-contact{text-align:center;margin-top:15px}.phone-avatar{width:52px;height:52px;display:grid;place-items:center;margin:0 auto 8px;border-radius:50%;background:#25334d;color:#c7d2fe;font-size:19px;font-weight:600}
  .phone-contact h3{font-size:17px;margin:0 0 2px}.phone-contact p{font-size:10px}.phone-screen #call-status{font-size:10px;text-align:center;line-height:1.4;min-height:28px;margin-top:12px;color:#a5b4fc}.phone-clock{font-variant-numeric:tabular-nums;font-size:24px;color:#e2e8f0;font-weight:300;margin-top:3px}
  .phone-screen .voice{height:30px;gap:4px;margin:5px 0 10px;opacity:.35}.phone-screen .voice i{width:3px;max-height:24px}.playing .phone-screen .voice{opacity:1}
  .phone-screen .field{width:100%;font-size:10px}.phone-screen select{font-size:11px;padding:8px;margin:5px 0 8px}
  .phone-call{display:flex;flex-direction:column;align-items:center;gap:7px;border:none;background:none;color:#e2e8f0;font-size:10px;cursor:pointer;margin-top:auto;padding:3px 12px}
  .phone-call-icon{width:49px;height:49px;display:grid;place-items:center;background:#24644e;color:white;border:1px solid #408970;border-radius:50%;transition:background .2s}
  .playing .phone-call-icon{background:#963e48;border-color:#b85863}.playing .phone-call-icon svg{transform:rotate(135deg)}.phone-home{width:58px;height:3px;border-radius:3px;background:#64748b;margin-top:12px}
  .transcription-card{min-width:0;display:flex;flex-direction:column;border:1px solid var(--line);border-radius:13px;background:#111720;padding:15px 12px}
  .transcription-heading{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:6px;border-bottom:1px solid var(--line);padding-bottom:13px}.transcription-heading strong{font-size:12px}.transcription-heading span{font-size:9px;color:#94a3b8}
  .transcription-card .transcript{height:340px;margin-top:15px;scrollbar-width:thin;scrollbar-color:#465169 transparent}.transcription-card .transcript :global(p){font-size:12px;padding:10px;background:#202735;border-radius:8px;line-height:1.6;margin-bottom:10px}.transcription-card .transcript :global(strong){display:block;font-size:10px;margin-bottom:5px;color:#a5b4fc}.transcription-card .transcript :global(p.patient-line){background:#25334d}.transcription-foot{font-size:9px;line-height:1.4!important;margin-top:auto!important;padding-top:10px}
  .messages{scrollbar-width:thin;scrollbar-color:#465169 transparent}
  @media(min-width:761px) and (max-width:1100px){.phone-layout{grid-template-columns:175px minmax(0,1fr);gap:10px}.phone-screen{padding-inline:10px}.transcription-card{padding:12px 8px}}
  @media(max-width:460px){.phone-layout{grid-template-columns:1fr}.phone-shell{width:220px;justify-self:center}.transcription-card .transcript{height:210px}.transcription-card{min-height:270px}}
</style>
<script>
  // Guided examples only: browser speech matches the displayed transcript.
  const scenarios = {
      reservar: [
        { delay: 1000, speaker: 'AI', text: '¡Hola! Bienvenido a FisioVital. ¿En qué puedo ayudarte?' },
        { delay: 3000, speaker: 'User', text: 'Hola, tengo dolor en el hombro derecho desde hace una semana' },
        { delay: 4500, speaker: 'AI', text: 'Entiendo. ¿Has sufrido alguna lesión reciente o es un dolor progresivo?' },
        { delay: 6000, speaker: 'User', text: 'Fue después de jugar al pádel el fin de semana pasado' },
        { delay: 7500, speaker: 'AI', text: 'Perfecto. Te recomiendo una primera consulta de valoración. Tengo disponibilidad mañana a las 10:00 o pasado mañana a las 16:30. ¿Cuál prefieres?' },
        { delay: 9000, speaker: 'User', text: 'Mañana a las 10:00 me viene bien' },
        { delay: 10500, speaker: 'AI', text: '¡Excelente! He reservado tu cita para mañana a las 10:00 - Valoración de hombro. Te enviaré un SMS de confirmación. ¿Necesitas algo más?' },
      ],
      modificar: [
        { delay: 1000, speaker: 'AI', text: 'Buenos días, FisioVital. ¿En qué puedo ayudarle?' },
        { delay: 3000, speaker: 'User', text: 'Necesito cambiar mi cita del viernes porque me surgió un imprevisto' },
        { delay: 4500, speaker: 'AI', text: 'Sin problema. ¿Podría darme su nombre completo?' },
        { delay: 6000, speaker: 'User', text: 'Soy Carlos Martínez' },
        { delay: 7500, speaker: 'AI', text: 'Perfecto, Carlos. Veo que tiene una cita el viernes a las 11:00. ¿Qué día le vendría mejor?' },
        { delay: 9500, speaker: 'User', text: '¿Tenéis algo el lunes siguiente por la tarde?' },
        { delay: 11000, speaker: 'AI', text: 'Sí, tengo disponible el lunes a las 16:00 o a las 18:30. ¿Cuál prefiere?' },
        { delay: 12500, speaker: 'User', text: 'A las 18:30 me va perfecto' },
        { delay: 13500, speaker: 'AI', text: 'Listo, he modificado su cita al lunes 18:30. Le enviaré una confirmación por SMS.' },
      ],
      pago: [
        { delay: 1000, speaker: 'AI', text: 'FisioVital, ¿en qué puedo ayudarle?' },
        { delay: 3000, speaker: 'User', text: 'Quisiera saber cuánto cuesta una sesión de fisioterapia' },
        { delay: 5000, speaker: 'AI', text: 'Una sesión individual cuesta 35€. También tenemos bonos: 5 sesiones por 160€ (ahorra 15€) y 10 sesiones por 300€ (ahorra 50€). ¿Le gustaría información sobre algún tratamiento específico?' },
        { delay: 7500, speaker: 'User', text: 'Sí, ¿hacéis punción seca?' },
        { delay: 9000, speaker: 'AI', text: 'Sí, ofrecemos punción seca. El precio es de 40€ por sesión. ¿Le gustaría agendar una consulta de valoración?' },
        { delay: 11500, speaker: 'User', text: 'Sí, me interesa' },
        { delay: 12500, speaker: 'AI', text: 'Perfecto. ¿Qué día le vendría mejor para la consulta?' },
      ]
    };
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-channel]')];
  let inCall = false; let finishSpeech: (() => void) | undefined;
  let runId = 0; let callTimer: ReturnType<typeof setInterval> | undefined;
  const play = document.querySelector<HTMLButtonElement>('#call-play')!;
  function stopCall() {
    runId++; inCall=false; finishSpeech?.(); if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    document.querySelector('#panel-llamada')?.classList.remove('playing');
    clearInterval(callTimer); document.querySelector('#call-label')!.textContent='Llamar'; play.setAttribute('aria-label','Llamar a FisioVital (demostración)'); document.querySelector('#transcript-state')!.textContent='En espera';
    document.querySelector('#call-status')!.textContent = 'Escucha cómo atiende tu recepción';
  }
  function selectTab(tab: HTMLButtonElement) {
    stopCall();
    tabs.forEach(t => {const active=t===tab; t.setAttribute('aria-selected',String(active));t.tabIndex=active?0:-1;document.getElementById(t.getAttribute('aria-controls')!)!.hidden=!active;});
  }
  tabs.forEach((tab,index)=>{
    tab.addEventListener('click',()=>selectTab(tab));
    tab.addEventListener('keydown',e=>{
      const next=e.key==='ArrowRight'?(index+1)%tabs.length:e.key==='ArrowLeft'?(index+tabs.length-1)%tabs.length:e.key==='Home'?0:e.key==='End'?tabs.length-1:-1;
      if(next<0)return;e.preventDefault();selectTab(tabs[next]);tabs[next].focus();
    });
  });
  const messages=document.querySelector('#wa-messages')!;
  const replies:Record<string,[string,string]>={
    reservar:['Confirmo la cita de las 16:30.','Cita de ejemplo confirmada con Laura a las 16:30. En tu clínica, el paciente recibiría la confirmación por el canal configurado.'],
    cambiar:['¿Tenéis otra hora?','Puedes elegir las 18:00 en este ejemplo. En una integración real consultamos los huecos disponibles de tu agenda.'],
    horarios:['¿Cuál es vuestro horario?','El horario de esta clínica ficticia es de lunes a viernes, de 9:00 a 20:00. Respondemos con la información que tú configures.'],
  };
  document.querySelectorAll<HTMLButtonElement>('[data-reply]').forEach(button=>button.addEventListener('click',()=>{
    const pair=replies[button.dataset.reply!];pair.forEach((text,i)=>{const p=document.createElement('p');p.className='bubble'+(i===0?' patient':'');p.textContent=text;messages.append(p);});while(messages.children.length>9)messages.firstElementChild?.remove();messages.scrollTop=messages.scrollHeight;
  }));
  play.addEventListener('click',async()=>{
    if(inCall){stopCall();return;} inCall=true;
    const id=++runId; const log=document.querySelector('#transcript')!;log.replaceChildren();
    document.querySelector('#call-label')!.textContent='Colgar'; play.setAttribute('aria-label','Colgar llamada'); document.querySelector('#transcript-state')!.textContent='En llamada'; let seconds=0; document.querySelector('#call-clock')!.textContent='00:00'; callTimer=setInterval(()=>{seconds++;document.querySelector('#call-clock')!.textContent=String(Math.floor(seconds/60)).padStart(2,'0')+':'+String(seconds%60).padStart(2,'0');},1000);document.querySelector('#panel-llamada')!.classList.add('playing');
    document.querySelector('#call-status')!.textContent='Reproduciendo conversación';
    const key=document.querySelector<HTMLSelectElement>('#call-scenario')!.value as keyof typeof scenarios;
    for(const line of scenarios[key]){
      if(id!==runId)return;
      const p=document.createElement('p');if(line.speaker==='User')p.className='patient-line';const strong=document.createElement('strong');strong.textContent=line.speaker==='AI'?'Recepción: ':'Paciente: ';p.append(strong,document.createTextNode(line.text));log.append(p);log.scrollTop=log.scrollHeight;
      await new Promise<void>(resolve=>{
        let settled=false;
        const finish=()=>{if(settled)return;settled=true;clearTimeout(timer);finishSpeech=undefined;resolve();};
        const timer=setTimeout(()=>{if ('speechSynthesis' in window) window.speechSynthesis.cancel();finish();},Math.max(3500,line.text.length*95));
        finishSpeech=finish;
        if ('speechSynthesis' in window) {
          const utterance=new SpeechSynthesisUtterance(line.text);utterance.lang='es-ES';utterance.rate=1;utterance.pitch=line.speaker==='AI'?1.05:.9;
          utterance.onend=finish;
          utterance.onerror=()=>{if(id===runId)document.querySelector('#transcript-state')!.textContent='Modo texto';};
          window.speechSynthesis.speak(utterance);
        } else {document.querySelector('#transcript-state')!.textContent='Modo texto';}
      });
      if(id!==runId)return;
    }
    stopCall();document.querySelector('#call-status')!.textContent='Ejemplo finalizado. Puedes escuchar otra consulta.';
  });
  document.querySelector('#call-scenario')!.addEventListener('change',stopCall);
  window.addEventListener('pagehide',stopCall);
  let selectedDate='',selectedTime='';
  const days=document.querySelector('#days')!;
  const result=document.querySelector('#booking-result')!;
  const resetResult=()=>{result.textContent='Elige tu cita para ver la confirmación.';};
  for(let i=1;i<=5;i++){
    const date=new Date();date.setDate(date.getDate()+i);
    const button=document.createElement('button');button.type='button';
    const label=date.toLocaleDateString('es-ES',{weekday:'short',day:'numeric',month:'short'});
    button.textContent=date.toLocaleDateString('es-ES',{weekday:'short',day:'numeric'});button.setAttribute('aria-label',label);button.setAttribute('aria-pressed','false');
    button.addEventListener('click',()=>{days.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed','false'));button.setAttribute('aria-pressed','true');selectedDate=label;resetResult();});days.append(button);
  }
  document.querySelectorAll<HTMLButtonElement>('[data-time]').forEach(button=>button.addEventListener('click',()=>{
    document.querySelectorAll('[data-time]').forEach(b=>b.setAttribute('aria-pressed','false'));button.setAttribute('aria-pressed','true');selectedTime=button.dataset.time!;resetResult();
  }));
  document.querySelector('#booking')!.addEventListener('change',resetResult);
  document.querySelector('#booking')!.addEventListener('submit',e=>{
    e.preventDefault();if(!selectedDate||!selectedTime){result.textContent='Selecciona un día y una hora para continuar.';return;}
    const person=document.querySelector<HTMLSelectElement>('#professional')!.value;
    const service=document.querySelector<HTMLSelectElement>('#service')!.value;
    result.textContent='✓ Reserva de ejemplo: '+service+' · '+selectedDate+' a las '+selectedTime+' · '+person+'. No se ha creado una cita real.';
  });
</script>
