---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Consultoría ENS — Esquema Nacional de Seguridad para Empresas | AI Security";
const description = "Consultoría ENS integral: gestionamos la documentación y los controles técnicos (Wazuh, hardening, FIM) para que tu empresa obtenga la certificación del Esquema Nacional de Seguridad. ENS básico, medio y alto.";
const canonical = "https://aisecurity.es/consultoria-ens";
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Service",
        "@id": "https://aisecurity.es/consultoria-ens#service",
        "name": "Consultoría ENS — Esquema Nacional de Seguridad",
        "serviceType": "Consultoría de adecuación y certificación del Esquema Nacional de Seguridad",
        "description": "Gestionamos la adecuación al ENS (Real Decreto 311/2022) de forma integral: documentación (políticas, análisis de riesgos MAGERIT, plan de adecuación) y controles técnicos reales (SIEM Wazuh, hardening, gestión de incidentes). Niveles básico, medio y alto.",
        "provider": { "@id": "https://aisecurity.es/#organization" },
        "areaServed": { "@type": "Country", "name": "España" },
        "url": "https://aisecurity.es/consultoria-ens"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Qué es el Esquema Nacional de Seguridad (ENS)?",
            "acceptedAnswer": { "@type": "Answer", "text": "El ENS es el marco normativo español de seguridad de la información regulado por el Real Decreto 311/2022. Es obligatorio para todas las administraciones públicas y para las empresas privadas que prestan servicios o proveen soluciones tecnológicas al sector público." }
          },
          {
            "@type": "Question",
            "name": "¿Mi empresa está obligada a cumplir el ENS?",
            "acceptedAnswer": { "@type": "Answer", "text": "Sí, si tu empresa presta servicios digitales, desarrolla software, gestiona infraestructuras IT o provee cualquier solución tecnológica a una entidad pública española. El plazo de adaptación del RD 311/2022 venció en mayo de 2024; sin ENS, tu empresa queda excluida automáticamente de licitaciones públicas con cláusula ENS." }
          },
          {
            "@type": "Question",
            "name": "¿Cuánto cuesta la consultoría ENS?",
            "acceptedAnswer": { "@type": "Answer", "text": "Depende del nivel y del estado de partida de la empresa. Orientativamente: ENS básico 3.000-6.000 €, ENS medio 6.000-12.000 €. Si ya tienes ISO 27001, el esfuerzo se reduce un 20-30%. Ofrecemos tres modalidades: guía autogestionada, consultoría documental y servicio integral (documental + técnico con Wazuh)." }
          },
          {
            "@type": "Question",
            "name": "¿Cuánto tiempo tarda obtener la certificación ENS?",
            "acceptedAnswer": { "@type": "Answer", "text": "ENS básico: 2-3 meses. ENS medio: 3-5 meses (requiere auditoría externa por entidad acreditada ENAC). ENS alto: 5-8 meses o más. Los plazos dependen de la madurez de seguridad previa de la empresa." }
          },
          {
            "@type": "Question",
            "name": "¿Cuál es la diferencia entre ENS básico, medio y alto?",
            "acceptedAnswer": { "@type": "Answer", "text": "El nivel depende del impacto que un incidente de seguridad tendría sobre los servicios. Básico: impacto limitado, se certifica mediante declaración de conformidad propia. Medio: impacto grave, requiere auditoría externa por entidad acreditada ENAC. Alto: impacto muy grave o catastrófico, auditoría más exhaustiva." }
          },
          {
            "@type": "Question",
            "name": "¿Qué controles técnicos exige el ENS?",
            "acceptedAnswer": { "@type": "Answer", "text": "El Anexo II del RD 311/2022 incluye controles técnicos como monitorización continua de sistemas (op.mon), registro de actividad (op.acc.5), gestión de incidentes (op.exp.8), control de integridad de archivos y evaluación de configuración segura. Wazuh cubre directamente estos controles como SIEM open source certificable." }
          },
          {
            "@type": "Question",
            "name": "¿Wazuh es válido para cumplir el ENS?",
            "acceptedAnswer": { "@type": "Answer", "text": "Sí. Wazuh cubre los controles de monitorización continua, gestión de logs, detección de intrusiones, File Integrity Monitoring (FIM) y evaluación de configuración segura (SCA/hardening) que exige el ENS en niveles medio y alto. Es el SIEM open source más utilizado en proyectos de adecuación ENS en España." }
          }
        ]
      }
    ]
  }
  </script>

  <!-- ═══ HERO ═══ -->
  <section style="background:#020817;padding:6rem 0 5rem;position:relative;overflow:hidden;">
    <div class="absolute inset-0 pointer-events-none" style="background-image:linear-gradient(rgba(129,140,248,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(129,140,248,0.04) 1px,transparent 1px);background-size:56px 56px;"></div>
    <div class="absolute pointer-events-none" style="top:-200px;right:-100px;width:700px;height:700px;background:radial-gradient(circle,rgba(99,102,241,0.1),transparent 60%);border-radius:50%;"></div>
    <div class="absolute pointer-events-none" style="bottom:-150px;left:-100px;width:500px;height:500px;background:radial-gradient(circle,rgba(139,92,246,0.07),transparent 65%);border-radius:50%;"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 lg:px-24">
      <div class="max-w-3xl">
        <p style="font-size:0.72rem;letter-spacing:0.18em;color:#818cf8;margin-bottom:1.25rem;font-family:monospace;text-transform:uppercase;">Real Decreto 311/2022 · Plazo vencido: mayo 2024</p>

        <h1 class="font-bold leading-tight mb-6" style="font-size:clamp(2rem,3.8vw,3.8rem);letter-spacing:-0.03em;color:#f0f9ff;">
          Consultoría ENS:<br/>
          <span style="background:linear-gradient(135deg,#60a5fa 0%,#818cf8 50%,#c084fc 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">documentación y técnica</span>
        </h1>

        <p class="mb-6 leading-relaxed" style="color:#94a3b8;font-size:1.05rem;max-width:600px;">
          Si tu empresa presta servicios a la administración pública, el ENS ya no es opcional. Gestionamos la adecuación completa: políticas, análisis de riesgos, plan de adecuación e implementación técnica con Wazuh — lo que el resto de consultoras no hacen.
        </p>

        <!-- Alerta de urgencia -->
        <div class="mb-8 flex items-start gap-3 rounded-lg p-4" style="background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.2);">
          <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="#f87171" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <p style="font-size:0.85rem;color:#fca5a5;line-height:1.6;">
            <strong style="color:#f87171;">El plazo de adaptación venció en mayo de 2024.</strong> Si aparece la cláusula ENS en un pliego y no tienes certificación, la exclusión es automática — no es cuestión de puntuación.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/presupuesto?plan=consultoria-ens" style="color:white;background:linear-gradient(135deg,#4f46e5,#7c3aed);box-shadow:0 8px 32px rgba(139,92,246,0.3);" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl font-semibold text-sm transition-all hover:-translate-y-0.5">
            Solicitar diagnóstico gratuito
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="#modalidades" style="color:#a78bfa;border-color:rgba(167,139,250,0.25);background:rgba(139,92,246,0.06);" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl font-semibold text-sm border transition-all hover:-translate-y-0.5">
            Ver modalidades y precios →
