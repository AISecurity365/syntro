---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Calculadora de Ahorro IT y Ciberseguridad ¿Pagas de más? | AI Security";
const description = "Calculadora de Ahorro IT y Ciberseguridad: descubre si tu empresa paga un precio justo en Alicante y Comunidad Valenciana. Gratis y honesta.";
const canonical = "https://aisecurity.es/calculadora-it";
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <!-- ═══ HERO ═══ -->
  <section style="background:#020817;padding:5rem 0 3rem;position:relative;overflow:hidden;">
    <div class="calc-dotgrid absolute inset-0 pointer-events-none"></div>
    <div class="absolute pointer-events-none" style="top:-100px;right:-100px;width:500px;height:500px;background:radial-gradient(circle,rgba(139,92,246,0.1),transparent 65%);border-radius:50%;"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <h1 class="font-bold mb-4 leading-tight" style="font-size:clamp(1.9rem,3.2vw,3.2rem);letter-spacing:-0.02em;color:#f0f9ff;">
        ¿Estás pagando un precio justo<br/>por tu IT y ciberseguridad?
      </h1>
      <p style="color:#94a3b8;max-width:560px;margin:0 auto 2rem;line-height:1.7;">
        Te hacemos un análisis honesto basado en precios reales del mercado en Alicante y la Comunidad Valenciana. Sin vender humo — si estás bien, te lo decimos.
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-xs font-mono" style="color:#64748b;">
        <span>✓ Sin registro</span>
        <span>✓ Sin compromiso</span>
        <span>✓ Resultado inmediato</span>
      </div>
    </div>
  </section>

  <!-- ═══ CALCULATOR ═══ -->
  <section style="background:#020817;padding:0 0 6rem;">
    <div class="max-w-3xl mx-auto px-6">

      <!-- Progress bar -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-2">
          <span id="calc-step-label" class="text-xs font-mono" style="color:#64748b;">Paso 1 de 4</span>
          <span id="calc-step-pct" class="text-xs font-mono" style="color:#a78bfa;">25%</span>
        </div>
        <div class="h-1 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06);">
          <div id="calc-progress" class="h-full rounded-full transition-all duration-500" style="width:25%;background:linear-gradient(90deg,#4f46e5,#7c3aed);"></div>
        </div>
      </div>

      <!-- Steps container -->
      <div id="calc-form" class="space-y-0">

        <!-- ── STEP 1: Empresa ── -->
        <div class="calc-step" id="step-1">
          <div class="calc-panel">
            <div class="calc-panel-header">
              <span class="calc-step-num">01</span>
              <div>
                <div class="calc-panel-title">Tu empresa</div>
                <div class="calc-panel-sub">Para calibrar los precios de referencia</div>
              </div>
            </div>

            <div class="space-y-5">
              <div class="calc-field">
                <label class="calc-label">Número de empleados</label>
                <div class="flex items-center gap-4">
                  <input type="range" id="f-employees" min="1" max="200" value="15" class="calc-range flex-1">
                  <span id="f-employees-val" class="calc-range-val">15</span>
                </div>
              </div>

              <div class="calc-field">
                <label class="calc-label">Número de equipos (PCs, portátiles, servidores)</label>
                <div class="flex items-center gap-4">
                  <input type="range" id="f-devices" min="1" max="300" value="18" class="calc-range flex-1">
                  <span id="f-devices-val" class="calc-range-val">18</span>
                </div>
              </div>

              <div class="calc-field">
                <label class="calc-label">Sector</label>
                <select id="f-sector" class="calc-select">
                  <option value="general">General / Servicios</option>
                  <option value="health">Salud / Clínica</option>
                  <option value="legal">Despacho legal / Gestoría</option>
                  <option value="retail">Retail / Comercio</option>
                  <option value="public">Proveedor de AAPP (requiere ENS)</option>
                  <option value="finance">Financiero / Pagos (requiere PCI-DSS)</option>
                  <option value="industry">Industria / Manufactura</option>
                </select>
              </div>

              <div class="calc-field">
                <label class="calc-label">Facturación anual (€) <span style="font-size:0.7rem;color:#475569;font-weight:normal;">(opcional)</span></label>
                <input type="number" id="f-revenue" min="0" step="1000" placeholder="Ej: 500000" class="calc-input">
                <p style="font-size:0.71rem;color:#475569;margin-top:0.4rem;line-height:1.5;">Si lo indicas, calculamos si tu inversión IT es coherente con tu tamaño. Referencia: 5–10% de la facturación.</p>
              </div>
            </div>

            <div class="flex justify-end mt-6">
              <button class="calc-btn-next" data-next="2">Siguiente →</button>
            </div>
          </div>
        </div>

        <!-- ── STEP 2: Soporte IT ── -->
        <div class="calc-step hidden" id="step-2">
          <div class="calc-panel">
            <div class="calc-panel-header">
              <span class="calc-step-num">02</span>
              <div>
                <div class="calc-panel-title">Soporte IT</div>
                <div class="calc-panel-sub">Mantenimiento informático general</div>
              </div>
            </div>

            <div class="space-y-5">
              <div class="calc-field">
                <label class="calc-label">Personal IT en plantilla</label>
                <div class="flex gap-3 flex-wrap">
                  <label class="calc-radio-card flex-1"><input type="radio" name="it-staff" value="0" checked> Ninguno</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="it-staff" value="1"> 1 persona</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="it-staff" value="2"> 2-3 personas</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="it-staff" value="4"> 4+ personas</label>
                </div>
              </div>

              <div class="calc-field">
                <label class="calc-label">¿Tienes soporte IT contratado?</label>
                <div class="flex gap-3">
                  <label class="calc-radio-card flex-1">
                    <input type="radio" name="it-type" value="monthly" checked> Cuota mensual fija
                  </label>
                  <label class="calc-radio-card flex-1">
                    <input type="radio" name="it-type" value="hourly"> Bolsa de horas
                  </label>
                  <label class="calc-radio-card flex-1">
                    <input type="radio" name="it-type" value="none"> No tengo
                  </label>
                </div>
              </div>

              <div id="it-monthly-block" class="calc-field">
                <label class="calc-label">Coste mensual total de IT (€/mes)</label>
                <div class="flex items-center gap-4">
                  <input type="range" id="f-it-monthly" min="0" max="3000" step="50" value="400" class="calc-range flex-1">
                  <span id="f-it-monthly-val" class="calc-range-val">400 €/mes</span>
                </div>
              </div>

              <div id="it-hourly-block" class="calc-field hidden">
                <label class="calc-label">Horas/mes aproximadas</label>
                <div class="flex items-center gap-4">
                  <input type="range" id="f-it-hours" min="0" max="40" value="8" class="calc-range flex-1">
                  <span id="f-it-hours-val" class="calc-range-val">8 h/mes</span>
                </div>
                <label class="calc-label mt-4">Coste por hora (€/h)</label>
                <div class="flex items-center gap-4">
                  <input type="range" id="f-it-rate" min="20" max="120" step="5" value="50" class="calc-range flex-1">
                  <span id="f-it-rate-val" class="calc-range-val">50 €/h</span>
                </div>
              </div>

              <div class="calc-field">
                <label class="calc-label">¿El soporte IT incluye las actualizaciones de sistemas?</label>
                <div class="flex gap-3">
                  <label class="calc-radio-card flex-1"><input type="radio" name="it-updates" value="yes" checked> Sí</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="it-updates" value="no"> No / No sé</label>
                </div>
              </div>
            </div>

            <div class="flex justify-between mt-6">
              <button class="calc-btn-back" data-prev="1">← Atrás</button>
              <button class="calc-btn-next" data-next="3">Siguiente →</button>
            </div>
          </div>
        </div>

        <!-- ── STEP 3: Herramientas y licencias ── -->
        <div class="calc-step hidden" id="step-3">
          <div class="calc-panel">
            <div class="calc-panel-header">
              <span class="calc-step-num">03</span>
              <div>
                <div class="calc-panel-title">Herramientas y licencias</div>
                <div class="calc-panel-sub">Lo que pagas por software y seguridad</div>
              </div>
            </div>

            <div class="space-y-5">

              <!-- Microsoft 365 -->
              <div class="calc-block">
                <div class="calc-block-title">📧 Microsoft 365</div>
                <div class="calc-field">
                  <label class="calc-label">Licencias contratadas</label>
                  <div class="flex items-center gap-4">
                    <input type="range" id="f-m365-users" min="0" max="100" value="0" class="calc-range flex-1">
                    <span id="f-m365-users-val" class="calc-range-val">0 (no tengo)</span>
                  </div>
                </div>
                <div class="calc-field">
                  <label class="calc-label">Plan contratado</label>
                  <select id="f-m365-plan" class="calc-select">
                    <option value="0">No aplica</option>
                    <option value="6">Business Basic — 6 €/usuario/mes</option>
                    <option value="8.25">Apps for Business — 8,25 €/usuario/mes</option>
                    <option value="12.5">Business Standard — 12,50 €/usuario/mes</option>
                    <option value="22">Business Premium — 22 €/usuario/mes</option>
                    <option value="custom">Precio negociado — indícame el total</option>
                  </select>
                </div>
                <div class="calc-field hidden" id="m365-custom-block">
                  <label class="calc-label">Total Microsoft 365 al mes (€)</label>
                  <input type="number" id="f-m365-custom" placeholder="Ej: 350" class="calc-input">
                </div>
              </div>

              <!-- Google Workspace -->
              <div class="calc-block">
                <div class="calc-block-title">🔵 Google Workspace</div>
                <div class="calc-field">
                  <label class="calc-label">Licencias contratadas</label>
                  <div class="flex items-center gap-4">
                    <input type="range" id="f-gws-users" min="0" max="100" value="0" class="calc-range flex-1">
                    <span id="f-gws-users-val" class="calc-range-val">0 (no tengo)</span>
                  </div>
                </div>
                <div class="calc-field">
                  <label class="calc-label">Plan contratado</label>
                  <select id="f-gws-plan" class="calc-select">
                    <option value="0">No aplica</option>
                    <option value="5.75">Business Starter — 5,75 €/usuario/mes</option>
                    <option value="11.5">Business Standard — 11,50 €/usuario/mes</option>
                    <option value="17.25">Business Plus — 17,25 €/usuario/mes</option>
                  </select>
                </div>
              </div>

              <!-- Antivirus / EDR -->
              <div class="calc-block">
                <div class="calc-block-title">💻 Antivirus / Protección de endpoints</div>
                <div class="flex gap-3 mb-3">
                  <label class="calc-radio-card flex-1"><input type="radio" name="av-type" value="none" checked> Sin antivirus corporativo</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="av-type" value="basic"> Antivirus básico (&lt;3€/equipo)</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="av-type" value="business"> EDR/AV Business (3-8€/equipo)</label>
                </div>
                <div id="av-cost-block" class="calc-field hidden">
                  <label class="calc-label">Coste mensual por equipo (€)</label>
                  <div class="flex items-center gap-4">
                    <input type="range" id="f-av-cost" min="1" max="15" step="0.5" value="3" class="calc-range flex-1">
                    <span id="f-av-cost-val" class="calc-range-val">3 €/equipo</span>
                  </div>
                </div>
              </div>

              <!-- Firewall -->
              <div class="calc-block">
                <div class="calc-block-title">🔥 Firewall perimetral</div>
                <div class="flex gap-3 mb-3">
                  <label class="calc-radio-card flex-1"><input type="radio" name="fw-type" value="none" checked> Sin firewall / solo router</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="fw-type" value="basic"> Firewall básico (hardware)</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="fw-type" value="managed"> Gestionado con mantenimiento</label>
                </div>
                <div id="fw-cost-block" class="calc-field hidden">
                  <label class="calc-label">Coste mensual total de firewall (€/mes)</label>
                  <div class="flex items-center gap-4">
                    <input type="range" id="f-fw-cost" min="20" max="600" step="10" value="80" class="calc-range flex-1">
                    <span id="f-fw-cost-val" class="calc-range-val">80 €/mes</span>
                  </div>
                </div>
              </div>

              <!-- Backup -->
              <div class="calc-block">
                <div class="calc-block-title">💾 Backup</div>
                <div class="flex gap-3">
                  <label class="calc-radio-card flex-1"><input type="radio" name="backup-type" value="none" checked> Sin backup gestionado</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="backup-type" value="cloud"> Solo nube (M365/GDrive)</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="backup-type" value="managed"> Backup gestionado</label>
                </div>
                <div id="backup-cost-block" class="calc-field hidden mt-3">
                  <label class="calc-label">Coste mensual backup (€/mes)</label>
                  <div class="flex items-center gap-4">
                    <input type="range" id="f-backup-cost" min="10" max="400" step="10" value="50" class="calc-range flex-1">
                    <span id="f-backup-cost-val" class="calc-range-val">50 €/mes</span>
                  </div>
                </div>
              </div>

              <!-- Ciberseguridad adicional -->
              <div class="calc-block">
                <div class="calc-block-title">🛡️ Ciberseguridad adicional (SIEM, SOC, etc.)</div>
                <div class="flex gap-3">
                  <label class="calc-radio-card flex-1"><input type="radio" name="siem-type" value="none" checked> Ninguna</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="siem-type" value="basic"> Básica (&lt;200€/mes)</label>
                  <label class="calc-radio-card flex-1"><input type="radio" name="siem-type" value="advanced"> Avanzada (SIEM/SOC)</label>
                </div>
                <div id="siem-cost-block" class="calc-field hidden mt-3">
                  <label class="calc-label">Coste mensual ciberseguridad (€/mes)</label>
                  <div class="flex items-center gap-4">
                    <input type="range" id="f-siem-cost" min="50" max="2000" step="50" value="200" class="calc-range flex-1">
                    <span id="f-siem-cost-val" class="calc-range-val">200 €/mes</span>
                  </div>
                </div>
                <!-- Opción avanzada: desglose de herramientas -->
                <div id="siem-advanced-wrap" class="hidden mt-4">
                  <button id="siem-toggle-adv" type="button" style="font-size:0.75rem;color:#818cf8;background:none;border:none;cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:3px;">
                    ▾ Ver desglose de herramientas de ciberseguridad
                  </button>
                  <div id="siem-adv-detail" class="hidden mt-3" style="border:1px solid rgba(129,140,248,0.12);border-radius:8px;padding:1rem;">
                    <p style="font-size:0.72rem;color:#475569;margin-bottom:0.75rem;">Marca las herramientas que tienes contratadas o gestionadas actualmente:</p>
                    <div class="calc-adv-grid">
                      <label class="cs-adv-check"><input type="checkbox" value="wazuh"> SIEM / Wazuh</label>
                      <label class="cs-adv-check"><input type="checkbox" value="soc"> SOC gestionado</label>
                      <label class="cs-adv-check"><input type="checkbox" value="pentest"> Pen testing anual</label>
                      <label class="cs-adv-check"><input type="checkbox" value="waf"> WAF (Web App Firewall)</label>
                      <label class="cs-adv-check"><input type="checkbox" value="dns-filter"> DNS filtering</label>
                      <label class="cs-adv-check"><input type="checkbox" value="email-sec"> Email security avanzada</label>
                      <label class="cs-adv-check"><input type="checkbox" value="pam"> PAM (Acceso privilegiado)</label>
                      <label class="cs-adv-check"><input type="checkbox" value="xdr"> XDR / EDR avanzado</label>
                      <label class="cs-adv-check"><input type="checkbox" value="ddos"> Anti-DDoS</label>
                      <label class="cs-adv-check"><input type="checkbox" value="deception"> Honeypots / Deception</label>
                      <label class="cs-adv-check"><input type="checkbox" value="threat-intel"> Threat Intelligence</label>
                      <label class="cs-adv-check"><input type="checkbox" value="vuln-scan"> Análisis de vulnerabilidades</label>
                      <label class="cs-adv-check"><input type="checkbox" value="drp"> Plan de recuperación (DRP)</label>
                      <label class="cs-adv-check"><input type="checkbox" value="casb"> CASB / Shadow IT</label>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <div class="flex justify-between mt-6">
              <button class="calc-btn-back" data-prev="2">← Atrás</button>
              <button class="calc-btn-next" data-next="4">Ver mi resultado →</button>
            </div>
          </div>
        </div>

        <!-- ── STEP 4: RESULTS ── -->
        <div class="calc-step hidden" id="step-4">
          <div id="calc-results-content">
            <!-- Injected by JS -->
          </div>
          <div class="flex justify-center mt-6">
            <button class="calc-btn-back" data-prev="3">← Revisar datos</button>
          </div>
        </div>

      </div><!-- fin form -->
    </div>
  </section>

  <style>
    /* ── Dot grid ── */
    .calc-dotgrid {
      background-image: radial-gradient(circle, rgba(129,140,248,0.07) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* ── Base ── */
    .calc-panel {
      background: rgba(255,255,255,0.025);
      border: 1px solid rgba(255,255,255,0.08);
      border-left: 3px solid rgba(129,140,248,0.6);
      border-radius: 0 16px 16px 0;
      padding: 2rem;
      clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 0 100%);
    }
    .calc-panel-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.75rem;
    }
    .calc-step-num {
      font-family: monospace;
      font-size: 2.5rem;
      font-weight: 800;
      color: rgba(129,140,248,0.25);
      line-height: 1;
      flex-shrink: 0;
    }
    .calc-panel-title {
      font-weight: 700;
      font-size: 1.2rem;
      color: #e2e8f0;
    }
    .calc-panel-sub {
      font-size: 0.82rem;
      color: #64748b;
      margin-top: 2px;
    }

    /* Fields */
    .calc-field { display: flex; flex-direction: column; }
    .calc-label {
      font-size: 0.82rem;
      color: #94a3b8;
      margin-bottom: 0.5rem;
      font-weight: 500;
    }
    .calc-range {
      -webkit-appearance: none;
      height: 4px;
      border-radius: 2px;
      background: rgba(255,255,255,0.08);
      outline: none;
      cursor: pointer;
    }
    .calc-range::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #818cf8;
      cursor: pointer;
      border: 2px solid #020817;
      box-shadow: 0 0 8px rgba(129,140,248,0.5);
    }
    .calc-range-val {
      font-family: monospace;
      font-size: 0.85rem;
      color: #a78bfa;
      min-width: 90px;
      text-align: right;
    }
    .calc-select {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      color: #e2e8f0;
      padding: 0.6rem 0.9rem;
      font-size: 0.875rem;
      outline: none;
      cursor: pointer;
    }
    .calc-input {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      color: #e2e8f0;
      padding: 0.6rem 0.9rem;
      font-size: 0.875rem;
      outline: none;
      width: 100%;
    }

    /* Radio cards */
    .calc-radio-card {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 0.8rem;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.03);
      cursor: pointer;
      font-size: 0.8rem;
      color: #94a3b8;
      transition: all 0.15s;
    }
    .calc-radio-card:has(input:checked) {
      border-color: rgba(129,140,248,0.4);
      background: rgba(129,140,248,0.07);
      color: #a78bfa;
    }
    .calc-radio-card input { display: none; }

    /* Blocks */
    .calc-block {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 10px;
      padding: 1rem 1.2rem;
    }
    .calc-block-title {
      font-size: 0.82rem;
      font-weight: 600;
      color: #e2e8f0;
      margin-bottom: 0.75rem;
    }

    /* Buttons */
    .calc-btn-next {
      padding: 0.75rem 1.75rem;
      border-radius: 10px;
      background: linear-gradient(135deg,#4f46e5,#7c3aed);
      color: white;
      font-weight: 700;
      font-size: 0.9rem;
      border: none;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.15s;
    }
    .calc-btn-next:hover { opacity: 0.9; transform: translateY(-1px); }
    .calc-btn-back {
      padding: 0.75rem 1.25rem;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      color: #94a3b8;
      font-size: 0.875rem;
      cursor: pointer;
    }
    .calc-btn-back:hover { background: rgba(255,255,255,0.07); }

    /* Results */
    .result-score-ring {
      width: 120px;
      height: 120px;
      position: relative;
    }

    /* Advanced cybersecurity tool grid */
    .calc-adv-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.4rem;
    }
    .cs-adv-check {
      display: flex; align-items: center; gap: 0.5rem;
      font-size: 0.78rem; color: #94a3b8; cursor: pointer;
      padding: 0.4rem 0.7rem; border-radius: 6px;
      border: 1px solid rgba(255,255,255,0.05);
      background: rgba(255,255,255,0.02);
      transition: background 0.15s;
    }
    .cs-adv-check:has(input:checked) {
      background: rgba(129,140,248,0.07);
      border-color: rgba(129,140,248,0.22);
      color: #a78bfa;
    }
    .cs-adv-check input { display: none; }

    @media (max-width: 480px) { .calc-adv-grid { grid-template-columns: 1fr; } }

    /* Misc */
    .hidden { display: none; }

    @media (max-width: 640px) {
      .flex.gap-3 { flex-direction: column; }
    }
  </style>

  <script is:inline>
  (function() {
    // ── Step navigation ──
    function showStep(n) {
      document.querySelectorAll('.calc-step').forEach(s => s.classList.add('hidden'));
      const step = document.getElementById('step-' + n);
      if (step) step.classList.remove('hidden');

      const pct = Math.round((n / 4) * 100);
      document.getElementById('calc-progress').style.width = pct + '%';
      document.getElementById('calc-step-label').textContent = 'Paso ' + n + ' de 4';
      document.getElementById('calc-step-pct').textContent = pct + '%';

      if (n === 4) generateResults();
      document.getElementById('calc-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    document.querySelectorAll('.calc-btn-next').forEach(btn => {
      btn.addEventListener('click', () => showStep(parseInt(btn.dataset.next)));
    });
    document.querySelectorAll('.calc-btn-back').forEach(btn => {
      btn.addEventListener('click', () => showStep(parseInt(btn.dataset.prev)));
    });

    // ── Range display ──
    function bindRange(id, valId, fmt) {
      const r = document.getElementById(id);
      const v = document.getElementById(valId);
      if (!r || !v) return;
      r.addEventListener('input', () => { v.textContent = fmt(r.value); });
      v.textContent = fmt(r.value);
    }
    bindRange('f-employees', 'f-employees-val', v => v + ' personas');
    bindRange('f-devices',   'f-devices-val',   v => v + ' equipos');
    bindRange('f-it-monthly','f-it-monthly-val', v => v + ' €/mes');
    bindRange('f-it-hours',  'f-it-hours-val',   v => v + ' h/mes');
    bindRange('f-it-rate',   'f-it-rate-val',    v => v + ' €/h');
    bindRange('f-m365-users','f-m365-users-val', v => parseInt(v) === 0 ? '0 (no tengo)' : v + ' licencias');
    bindRange('f-gws-users', 'f-gws-users-val',  v => parseInt(v) === 0 ? '0 (no tengo)' : v + ' licencias');
    bindRange('f-av-cost',   'f-av-cost-val',    v => v + ' €/equipo');
    bindRange('f-fw-cost',   'f-fw-cost-val',    v => v + ' €/mes');
    bindRange('f-backup-cost','f-backup-cost-val',v => v + ' €/mes');
    bindRange('f-siem-cost', 'f-siem-cost-val',  v => v + ' €/mes');

    // ── Show/hide conditional blocks ──
    document.querySelectorAll('[name="it-type"]').forEach(r => {
      r.addEventListener('change', () => {
        const val = r.value;
        document.getElementById('it-monthly-block').classList.toggle('hidden', val !== 'monthly');
        document.getElementById('it-hourly-block').classList.toggle('hidden', val !== 'hourly');
      });
    });
    document.querySelectorAll('[name="av-type"]').forEach(r => {
      r.addEventListener('change', () => {
        document.getElementById('av-cost-block').classList.toggle('hidden', r.value === 'none');
      });
    });
    document.querySelectorAll('[name="fw-type"]').forEach(r => {
      r.addEventListener('change', () => {
        document.getElementById('fw-cost-block').classList.toggle('hidden', !['basic','managed'].includes(r.value));
      });
    });
    document.querySelectorAll('[name="backup-type"]').forEach(r => {
      r.addEventListener('change', () => {
        document.getElementById('backup-cost-block').classList.toggle('hidden', r.value !== 'managed');
      });
    });
    document.querySelectorAll('[name="siem-type"]').forEach(r => {
      r.addEventListener('change', () => {
        const val = document.querySelector('[name="siem-type"]:checked').value;
        document.getElementById('siem-cost-block').classList.toggle('hidden', val === 'none');
        document.getElementById('siem-advanced-wrap').classList.toggle('hidden', val !== 'advanced');
      });
    });
    document.getElementById('siem-toggle-adv').addEventListener('click', function() {
      const detail = document.getElementById('siem-adv-detail');
      const hidden = detail.classList.toggle('hidden');
      this.textContent = hidden
        ? '▾ Ver desglose de herramientas de ciberseguridad'
        : '▴ Ocultar desglose';
    });
    document.getElementById('f-m365-plan').addEventListener('change', function() {
      document.getElementById('m365-custom-block').classList.toggle('hidden', this.value !== 'custom');
    });

    // ── BENCHMARKS (Alicante / CV market — PLACEHOLDERS, actualizar con datos reales) ──
    // TODO: ajustar estos valores con el usuario antes de lanzar
    const BENCH = {
      // IT support mensual por empleado (€/empleado/mes) rango mercado CV
      itPerEmployee: { low: 18, fair: 28, high: 45 }, // <low = muy barato/sin servicio, >high = caro

      // IT por hora mercado CV
      itHourlyRate: { low: 30, fair: 45, high: 65 },

      // Microsoft 365: precio justo por licencia/mes (descuento por volumen esperado)
      // Si pagan más de un 15% sobre precio de lista → caro
      m365Premium: { recommended: 'Business Premium', minPrice: 22 },

      // Antivirus endpoint correcto para empresa
      avPerDevice: { minBusiness: 3, recommended: 5 },

      // Firewall: precio justo gestionado por tamaño empresa (€/mes)
      fw: (employees) => employees < 15 ? { fair: 60, max: 120 } : employees < 50 ? { fair: 120, max: 250 } : { fair: 250, max: 500 },

      // Backup gestionado mínimo
      backupMin: (employees) => employees < 20 ? 40 : employees < 50 ? 80 : 150,

      // Ciberseguridad básica mínima esperada por tamaño
      siemMin: (employees) => employees < 20 ? 0 : employees < 50 ? 150 : 300,
    };

    function getVal(id, fallback) {
      const el = document.getElementById(id);
      if (!el) return fallback;
      return parseFloat(el.value) || fallback;
    }
    function getRadio(name) {
      const checked = document.querySelector('[name="' + name + '"]:checked');
      return checked ? checked.value : null;
    }
    function getSelect(id) {
      const el = document.getElementById(id);
      return el ? el.value : null;
    }

    // ── Results ──
    function generateResults() {
      const employees = getVal('f-employees', 15);
      const devices   = getVal('f-devices', 18);
      const sector    = getSelect('f-sector') || 'general';
      const revenue   = getVal('f-revenue', 0);
      const itType    = getRadio('it-type') || 'none';
      const itUpdates = getRadio('it-updates') || 'no';

      // IT cost
      let itCostMonthly = 0;
      if (itType === 'monthly') {
        itCostMonthly = getVal('f-it-monthly', 0);
      } else if (itType === 'hourly') {
        itCostMonthly = getVal('f-it-hours', 0) * getVal('f-it-rate', 45);
      }

      // M365
      const m365Users = getVal('f-m365-users', 0);
      let m365PlanPrice = parseFloat(getSelect('f-m365-plan') || '0');
      let m365Monthly = 0;
      if (getSelect('f-m365-plan') === 'custom') {
        m365Monthly = getVal('f-m365-custom', 0);
      } else {
        m365Monthly = m365Users * m365PlanPrice;
      }

      // Google Workspace
      const gwsUsers = getVal('f-gws-users', 0);
      const gwsPlanPrice = parseFloat(getSelect('f-gws-plan') || '0');
      const gwsMonthly = gwsUsers * gwsPlanPrice;

      // AV
      const avType = getRadio('av-type') || 'none';
      let avMonthly = 0;
      if (avType !== 'none') avMonthly = getVal('f-av-cost', 3) * devices;

      // Firewall
      const fwType = getRadio('fw-type') || 'none';
      let fwMonthly = 0;
      if (fwType !== 'none') fwMonthly = getVal('f-fw-cost', 0);

      // Backup
      const backupType = getRadio('backup-type') || 'none';
      let backupMonthly = 0;
      if (backupType === 'managed') backupMonthly = getVal('f-backup-cost', 0);

      // SIEM
      const siemType = getRadio('siem-type') || 'none';
      let siemMonthly = 0;
      if (siemType !== 'none') siemMonthly = getVal('f-siem-cost', 0);

      const totalCurrent = itCostMonthly + m365Monthly + gwsMonthly + avMonthly + fwMonthly + backupMonthly + siemMonthly;

      // ── Análisis por categoría ──
      const issues = [];
      const goods  = [];
      let savings  = 0;
      let risks    = 0;

      // IT support
      if (itType === 'none') {
        risks++;
        issues.push({ area: 'Soporte IT', icon: '🖥️', level: 'risk', msg: 'Sin soporte IT contratado — cualquier incidencia puede parar tu empresa sin que nadie la resuelva rápido.', action: 'Contratar soporte IT' });
      } else {
        const itPerEmployee = itCostMonthly / employees;
        if (itType === 'hourly') {
          const rate = getVal('f-it-rate', 45);
          if (rate > BENCH.itHourlyRate.high) {
            const overcharge = (rate - BENCH.itHourlyRate.fair) * getVal('f-it-hours', 0);
            savings += overcharge;
            issues.push({ area: 'Soporte IT', icon: '🖥️', level: 'warn', msg: 'Pagas ' + rate + ' €/h. El mercado en Alicante/CV está entre ' + BENCH.itHourlyRate.low + '-' + BENCH.itHourlyRate.high + ' €/h. Posible sobreprecio de ~' + Math.round(overcharge) + ' €/mes.', action: 'Pedir segunda opinión' });
          } else if (rate < BENCH.itHourlyRate.low) {
            issues.push({ area: 'Soporte IT', icon: '🖥️', level: 'warn', msg: 'Pagas ' + rate + ' €/h — muy por debajo del mercado. Verifica que el servicio incluye todo lo que necesitas (SLA, respuesta, actualizaciones).', action: 'Revisar contrato' });
          } else {
            goods.push({ area: 'Soporte IT', icon: '🖥️', msg: 'Precio por hora dentro del rango de mercado (' + BENCH.itHourlyRate.low + '-' + BENCH.itHourlyRate.high + ' €/h).' });
          }
        } else {
          if (itPerEmployee > BENCH.itPerEmployee.high) {
            const over = Math.round((itPerEmployee - BENCH.itPerEmployee.fair) * employees);
            savings += over;
            issues.push({ area: 'Soporte IT', icon: '🖥️', level: 'warn', msg: 'Pagas ' + Math.round(itPerEmployee) + ' €/empleado/mes. El rango habitual en CV es ' + BENCH.itPerEmployee.low + '-' + BENCH.itPerEmployee.high + ' €. Posible ahorro de ~' + over + ' €/mes.', action: 'Comparar ofertas' });
          } else if (itPerEmployee < BENCH.itPerEmployee.low && employees > 3) {
            risks++;
            issues.push({ area: 'Soporte IT', icon: '🖥️', level: 'warn', msg: 'Precio muy bajo (' + Math.round(itPerEmployee) + ' €/empleado/mes). Verifica qué cubre exactamente: SLA, parches, actualizaciones de sistemas.', action: 'Revisar cobertura' });
          } else {
            goods.push({ area: 'Soporte IT', icon: '🖥️', msg: 'Coste IT razonable para tu empresa (' + Math.round(itPerEmployee) + ' €/empleado/mes).' });
          }
        }
      }

      // Updates
      if (itUpdates === 'no') {
        risks++;
        issues.push({ area: 'Actualizaciones', icon: '🔄', level: 'risk', msg: 'El soporte IT no incluye actualizaciones de sistemas. Los sistemas sin parchear son la principal causa de ransomware.', action: 'Ampliar contrato' });
      }

      // M365
      if (m365Users > 0) {
        if (m365PlanPrice > 0 && m365PlanPrice < 22) {
          if (sector === 'public' || sector === 'health' || sector === 'finance') {
            risks++;
            issues.push({ area: 'Microsoft 365', icon: '📧', level: 'risk', msg: 'Tu sector (' + sector + ') necesita Business Premium (22 €/usuario) para tener Defender for Business, Intune y controles de cumplimiento. Con el plan actual estás expuesto.', action: 'Actualizar a Premium' });
          } else {
            issues.push({ area: 'Microsoft 365', icon: '📧', level: 'info', msg: 'Plan actual OK para uso general. Considera Business Premium si quieres MFA avanzado, Intune y protección de email mejorada (Defender for M365).', action: 'Evaluar upgrade' });
          }
        } else if (m365PlanPrice >= 22) {
          goods.push({ area: 'Microsoft 365', icon: '📧', msg: 'Tienes Business Premium: buen nivel de protección de email, Intune y Defender for Business incluidos.' });
        }
      } else {
        if (employees > 3) {
          issues.push({ area: 'Microsoft 365 / Google', icon: '📧', level: 'info', msg: 'No tienes Microsoft 365 ni Google Workspace. Si usas email corporativo sin suite empresarial, el cifrado, backup y control de accesos pueden ser insuficientes.', action: 'Consultar opciones' });
        }
      }

      // Antivirus
      if (avType === 'none') {
        risks++;
        issues.push({ area: 'Antivirus / Endpoint', icon: '💻', level: 'risk', msg: 'Sin protección de endpoint corporativa. Windows Defender es insuficiente para una empresa — no tiene gestión centralizada ni detección de comportamiento (EDR).', action: 'Contratar EDR corporativo' });
      } else if (avType === 'basic') {
        issues.push({ area: 'Antivirus / Endpoint', icon: '💻', level: 'warn', msg: 'Antivirus básico (&lt;3€/equipo). Detecta firmas conocidas pero no comportamiento. Un ransomware nuevo puede pasar sin ser detectado.', action: 'Evaluar EDR' });
      } else {
        goods.push({ area: 'Antivirus / Endpoint', icon: '💻', msg: 'Tienes protección de endpoint con gestión centralizada. Bien.' });
      }

      // Firewall
      if (fwType === 'none') {
        risks++;
        issues.push({ area: 'Firewall', icon: '🔥', level: 'risk', msg: 'Sin firewall perimetral (solo router del ISP). Tu red está expuesta directamente a internet sin inspección de tráfico.', action: 'Implementar firewall UTM' });
      } else if (fwType === 'basic') {
        issues.push({ area: 'Firewall', icon: '🔥', level: 'info', msg: 'Tienes firewall básico (hardware sin gestión). Sin mantenimiento activo, las reglas pueden quedarse obsoletas y las actualizaciones de firmware sin aplicar.', action: 'Considerar gestión activa' });
      } else if (fwType === 'managed') {
        const bench = BENCH.fw(employees);
        if (fwMonthly > bench.max) {
          const over = Math.round(fwMonthly - bench.fair);
          savings += over;
          issues.push({ area: 'Firewall', icon: '🔥', level: 'warn', msg: 'Pagas ' + fwMonthly + ' €/mes por el firewall. Para una empresa de ' + employees + ' personas, el rango habitual en CV es ' + bench.fair + '-' + bench.max + ' €/mes.', action: 'Revisar oferta' });
        } else {
          goods.push({ area: 'Firewall', icon: '🔥', msg: 'Precio del firewall gestionado dentro del rango esperado para tu tamaño.' });
        }
      }

      // Backup
      if (backupType === 'none') {
        risks++;
        issues.push({ area: 'Backup', icon: '💾', level: 'risk', msg: 'Sin backup gestionado. Una pérdida de datos (ransomware, fallo de disco, borrado accidental) puede ser irreversible. El backup en nube del email no es suficiente para los datos de tu empresa.', action: 'Implementar backup' });
      } else if (backupType === 'cloud') {
        issues.push({ area: 'Backup', icon: '💾', level: 'info', msg: 'El backup de M365/GDrive cubre email y documentos en nube, pero no servidores locales, bases de datos ni equipos. Verifica qué datos críticos quedarían sin backup.', action: 'Completar cobertura' });
      } else {
        goods.push({ area: 'Backup', icon: '💾', msg: 'Tienes backup gestionado. Bien — verifica que se testea la restauración periódicamente.' });
      }

      // SIEM
      if (siemType === 'none' && (sector === 'public' || employees > 20)) {
        if (sector === 'public') {
          risks++;
          issues.push({ area: 'SIEM / Monitorización', icon: '🛡️', level: 'risk', msg: 'Eres proveedor de AAPP y el ENS exige monitorización de actividad (op.exp.8). Sin SIEM no puedes cumplir ni detectar intrusiones. Wazuh cubre este requerimiento.', action: 'Implementar Wazuh' });
        } else {
          issues.push({ area: 'SIEM / Monitorización', icon: '🛡️', level: 'info', msg: 'Sin SIEM ni monitorización de seguridad. Para una empresa de ' + employees + ' personas, un SIEM básico (Wazuh) por 200€/mes añade visibilidad crítica de amenazas.', action: 'Valorar Wazuh' });
        }
      } else if (siemType !== 'none') {
        goods.push({ area: 'Monitorización', icon: '🛡️', msg: 'Tienes algún nivel de monitorización de seguridad activa.' });
      }

      // ── Score ──
      const totalChecks = issues.length + goods.length;
      const goodCount = goods.length;
      const riskCount = risks;
      const score = totalChecks > 0 ? Math.round((goodCount / totalChecks) * 100) : 50;

      let scoreColor, scoreLabel, scoreMsg;
      if (riskCount >= 3 || score < 35) {
        scoreColor = '#ef4444'; scoreLabel = 'EXPOSICIÓN ALTA';
        scoreMsg = 'Tienes ' + riskCount + ' áreas sin cobertura crítica. Hay riesgo real de incidente que pare tu empresa.';
      } else if (riskCount >= 1 || score < 65) {
        scoreColor = '#f59e0b'; scoreLabel = 'PUEDE MEJORAR';
        scoreMsg = 'Tu empresa tiene protección parcial. Hay brechas concretas que un atacante podría aprovechar.';
      } else {
        scoreColor = '#4ade80'; scoreLabel = 'NIVEL RAZONABLE';
        scoreMsg = 'Tienes una base de seguridad adecuada. Hay ajustes que optimizarían coste o protección.';
      }

      // ── Build HTML ──
      let issuesHtml = issues.map(i => `
        <div style="display:flex;gap:1rem;align-items:flex-start;padding:1rem 1.2rem;border-radius:10px;background:rgba(255,255,255,0.02);border:1px solid ${i.level === 'risk' ? 'rgba(239,68,68,0.2)' : i.level === 'warn' ? 'rgba(245,158,11,0.2)' : 'rgba(96,165,250,0.15)'};">
          <div style="font-size:1.3rem;flex-shrink:0;line-height:1.2;">${i.icon}</div>
          <div style="flex:1;">
            <div style="font-weight:600;font-size:0.82rem;margin-bottom:4px;color:${i.level === 'risk' ? '#fca5a5' : i.level === 'warn' ? '#fcd34d' : '#93c5fd'};">${i.area}</div>
            <div style="font-size:0.8rem;color:#94a3b8;line-height:1.6;">${i.msg}</div>
          </div>
          ${i.action ? `<a href="/presupuesto?plan=ciberseguridad&ref=${encodeURIComponent(i.area)}" style="color:${i.level === 'risk' ? '#fca5a5' : '#fcd34d'};font-size:0.72rem;font-weight:600;white-space:nowrap;align-self:center;text-decoration:underline;">${i.action}</a>` : ''}
        </div>
      `).join('');

      let goodsHtml = goods.map(g => `
        <div style="display:flex;gap:0.75rem;align-items:center;padding:0.75rem 1rem;border-radius:8px;background:rgba(74,222,128,0.04);border:1px solid rgba(74,222,128,0.15);">
          <span style="font-size:1rem;">${g.icon}</span>
          <div>
            <span style="font-weight:600;font-size:0.75rem;color:#86efac;">${g.area}</span>
            <span style="font-size:0.75rem;color:#64748b;margin-left:0.5rem;">${g.msg}</span>
          </div>
        </div>
      `).join('');

      const savingsRound = Math.round(savings);

      const html = `
        <div style="background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.08);border-left:3px solid ${scoreColor};border-radius:0 16px 16px 0;padding:2rem;clip-path:polygon(0 0,calc(100% - 24px) 0,100% 24px,100% 100%,0 100%);">

          <!-- Score header -->
          <div style="display:flex;align-items:center;gap:1.5rem;margin-bottom:2rem;flex-wrap:wrap;">
            <div style="width:96px;height:96px;border-radius:50%;border:4px solid ${scoreColor};background:rgba(6,11,20,0.8);display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 0 24px ${scoreColor}33;flex-shrink:0;">
              <div style="font-family:monospace;font-size:1.8rem;font-weight:800;color:${scoreColor};line-height:1;">${score}</div>
              <div style="font-size:0.55rem;color:#64748b;letter-spacing:0.1em;">/ 100</div>
            </div>
            <div>
              <div style="font-family:monospace;font-size:0.75rem;letter-spacing:0.12em;color:${scoreColor};margin-bottom:6px;">${scoreLabel}</div>
              <div style="font-weight:700;font-size:1.15rem;color:#e2e8f0;margin-bottom:6px;">Análisis de tu empresa</div>
              <div style="font-size:0.85rem;color:#94a3b8;line-height:1.6;max-width:420px;">${scoreMsg}</div>
            </div>
          </div>

          <!-- Summary row -->
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;margin-bottom:2rem;">
            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:1rem;text-align:center;">
              <div style="font-family:monospace;font-size:1.4rem;font-weight:800;color:#e2e8f0;">${totalCurrent > 0 ? totalCurrent.toFixed(0) + ' €' : '—'}</div>
              <div style="font-size:0.72rem;color:#64748b;margin-top:4px;">gasto mensual total</div>
            </div>
            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:1rem;text-align:center;">
              <div style="font-family:monospace;font-size:1.4rem;font-weight:800;color:${savingsRound > 0 ? '#4ade80' : '#64748b'};">${savingsRound > 0 ? '~' + savingsRound + ' €' : '0 €'}</div>
              <div style="font-size:0.72rem;color:#64748b;margin-top:4px;">ahorro potencial/mes</div>
            </div>
            <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:10px;padding:1rem;text-align:center;">
              <div style="font-family:monospace;font-size:1.4rem;font-weight:800;color:${riskCount > 0 ? '#ef4444' : '#4ade80'};">${riskCount}</div>
              <div style="font-size:0.72rem;color:#64748b;margin-top:4px;">brechas críticas</div>
            </div>
          </div>

          <!-- Issues -->
          ${issues.length > 0 ? `
            <div style="margin-bottom:1.5rem;">
              <div style="font-size:0.75rem;font-family:monospace;letter-spacing:0.1em;color:#94a3b8;margin-bottom:0.75rem;">PUNTOS A REVISAR</div>
              <div style="display:flex;flex-direction:column;gap:0.75rem;">${issuesHtml}</div>
            </div>` : ''}

          <!-- Goods -->
          ${goods.length > 0 ? `
            <div style="margin-bottom:2rem;">
              <div style="font-size:0.75rem;font-family:monospace;letter-spacing:0.1em;color:#94a3b8;margin-bottom:0.75rem;">LO QUE YA TIENES BIEN</div>
              <div style="display:flex;flex-direction:column;gap:0.5rem;">${goodsHtml}</div>
            </div>` : ''}

          ${revenue > 0 ? (() => {
            const revLabel = revenue >= 1000000 ? (revenue/1000000).toFixed(1) + 'M€' : Math.round(revenue/1000) + 'k€';
            const benchLow = Math.round(revenue * 0.05 / 12);
            const benchHigh = Math.round(revenue * 0.10 / 12);
            const totalNow = Math.round(totalCurrent);
            const status = totalNow === 0 ? '' : totalNow < benchLow ? ' — <span style="color:#fcd34d;">por debajo del mínimo recomendado</span>' : totalNow > benchHigh ? ' — <span style="color:#fcd34d;">por encima del rango</span>' : ' — <span style="color:#86efac;">dentro del rango</span>';
            return '<div style="background:rgba(129,140,248,0.05);border:1px solid rgba(129,140,248,0.12);border-radius:8px;padding:0.9rem 1.1rem;margin-bottom:1rem;">'
              + '<p style="font-size:0.78rem;color:#94a3b8;line-height:1.6;margin:0;">'
