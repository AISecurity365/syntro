  }
  .cs-domain.open .cs-detail { max-height: 500px; padding: 0 1.5rem 1.5rem; }
  .cs-domain.open .cs-chev   { transform: rotate(180deg); }
  .cs-chev { transition: transform 0.2s; }

  .cs-di {
    background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);
    border-radius: 7px; padding: 0.7rem 0.9rem;
    font-size: 0.8rem; line-height: 1.6; color: #94a3b8;
  }

  /* Threat card icon */
  .cs-tc-icon { font-size: 1.8rem; margin-bottom: 0.6rem; display: block; line-height: 1; }

  /* ENS badge on domains */
  .cs-ens-badge {
    font-size: 0.55rem; font-family: monospace; font-weight: 800;
    letter-spacing: 0.1em; padding: 2px 5px; border-radius: 3px;
    background: rgba(129,140,248,0.12); border: 1px solid rgba(129,140,248,0.35);
    color: #818cf8; flex-shrink: 0; white-space: nowrap;
  }

  /* Threat cards */
  .cs-threat-card {
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.07);
    border-top: 2px solid var(--tc, #818cf8);
    border-radius: 10px; padding: 1.25rem;
    transition: background 0.2s, transform 0.2s;
  }
  .cs-threat-card:hover { background: rgba(255,255,255,0.04); transform: translateY(-2px); }
  .cs-tc-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 0.75rem; }
  .cs-tc-type { font-family: monospace; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; }
  .cs-tc-impact { font-size: 0.8rem; font-weight: 600; color: #e2e8f0; }
  .cs-tc-body { font-size: 0.8rem; color: #64748b; line-height: 1.6; margin-bottom: 0.75rem; }
  .cs-tc-foot { font-size: 0.72rem; color: #475569; }
  .cs-tc-foot span { color: #818cf8; font-weight: 600; }

  /* Ticker ciberseguridad */
  @keyframes cs-ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .cs-sec-ticker { animation: cs-ticker-scroll 48s linear infinite; }
  .cs-sec-ticker:hover { animation-play-state: paused; }

  @media (max-width: 640px) {
    .cs-num { display: none; }
    .cs-domain-header { padding: 1rem; gap: 0.75rem; flex-wrap: wrap; }
  }
</style>

<script is:inline>
  // Domain expand/collapse
  document.querySelectorAll('.cs-domain').forEach(d => {
    const h = d.querySelector('.cs-domain-header');
    if (h) h.addEventListener('click', () => d.classList.toggle('open'));
  });

  // Popup cards sincronizadas con los blips del radar
  (function() {
    var card = document.getElementById('cs-attack-card');
    var inner = document.getElementById('cs-ack-inner');
    var iconEl = document.getElementById('cs-ack-icon');
    var typeEl = document.getElementById('cs-ack-type');
    var provEl = document.getElementById('cs-ack-prov');
    if (!card) return;
    var hideTimer;
    var attacks = [
      // phishing: begin=0s dur=2.5s → llega en 2.5s, ciclo 6s
      { delay:2500,  cycle:6000,  icon:'🎣', type:'PHISHING',   prov:'Gmail · Outlook · Yahoo',  border:'rgba(239,68,68,0.45)' },
      // ddos: begin=1.5s dur=3s → llega en 4.5s, ciclo 8.5s
      { delay:4500,  cycle:8500,  icon:'💥', type:'DDoS',       prov:'8.3 Gbps · 12k req/s',    border:'rgba(239,68,68,0.45)' },
      // ransomware: begin=3s dur=2.8s → llega en 5.8s, ciclo 9s
      { delay:5800,  cycle:9000,  icon:'🔒', type:'RANSOMWARE', prov:'WinServer · OneDrive',    border:'rgba(239,68,68,0.45)' },
      // bruteforce: begin=4.5s dur=2.8s → llega en 7.3s, ciclo 7s
      { delay:7300,  cycle:7000,  icon:'🔑', type:'BRUTEFORCE', prov:'SSH · RDP · 2.847 int.',  border:'rgba(251,146,60,0.45)' },
      // malware: begin=6.5s dur=3s → llega en 9.5s, ciclo 10s
      { delay:9500,  cycle:10000, icon:'🐛', type:'MALWARE',    prov:'macro Office · endpoint', border:'rgba(239,68,68,0.45)' },
      // exploit: begin=8s dur=2.6s → llega en 10.6s, ciclo 8s
      { delay:10600, cycle:8000,  icon:'💻', type:'EXPLOIT',    prov:'Apache · WP · CVE-2024',  border:'rgba(251,146,60,0.45)' },
    ];
    function showCard(atk) {
      clearTimeout(hideTimer);
      iconEl.textContent = atk.icon;
      typeEl.textContent = atk.type;
      provEl.textContent = atk.prov;
      inner.style.borderColor = atk.border;
      card.style.opacity = '1';
      hideTimer = setTimeout(function() { card.style.opacity = '0'; }, 1600);
    }
    attacks.forEach(function(atk) {
      function fire() { showCard(atk); setTimeout(fire, atk.cycle); }
      setTimeout(fire, atk.delay);
    });
  })();

  // Fake threat counter
  const counterEl = document.getElementById('cs-counter');
  if (counterEl) {
    let n = 2800 + Math.floor(Math.random() * 600);
    counterEl.textContent = n.toLocaleString('es-ES');
    setInterval(() => {
      n += Math.floor(Math.random() * 4) + 1;
      counterEl.textContent = n.toLocaleString('es-ES');
    }, 3000 + Math.random() * 4000);
  }
</script>

