  /* Pulso monitor */
  @keyframes cs-pulse { 0%,100% { opacity:0.6; } 50% { opacity:1; } }

  /* Partículas flotantes */
  .cs-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .cs-particles span {
    position:absolute; display:block; border-radius:50%;
    background:rgba(129,140,248,0.15);
    animation: cs-float linear infinite;
  }
  .cs-particles span:nth-child(1)  { width:3px; height:3px; left:10%; animation-duration:18s; animation-delay:0s; }
  .cs-particles span:nth-child(2)  { width:2px; height:2px; left:25%; animation-duration:24s; animation-delay:-4s; }
  .cs-particles span:nth-child(3)  { width:4px; height:4px; left:40%; animation-duration:20s; animation-delay:-8s; }
  .cs-particles span:nth-child(4)  { width:2px; height:2px; left:55%; animation-duration:16s; animation-delay:-2s; }
  .cs-particles span:nth-child(5)  { width:3px; height:3px; left:70%; animation-duration:22s; animation-delay:-6s; }
  .cs-particles span:nth-child(6)  { width:2px; height:2px; left:80%; animation-duration:19s; animation-delay:-10s; }
  .cs-particles span:nth-child(7)  { width:3px; height:3px; left:15%; animation-duration:25s; animation-delay:-12s; }
  .cs-particles span:nth-child(8)  { width:2px; height:2px; left:60%; animation-duration:17s; animation-delay:-3s; }
  .cs-particles span:nth-child(9)  { width:4px; height:4px; left:88%; animation-duration:21s; animation-delay:-7s; }
  .cs-particles span:nth-child(10) { width:2px; height:2px; left:33%; animation-duration:23s; animation-delay:-14s; }
  @keyframes cs-float {
    0%   { bottom:-10px; opacity:0; transform:scale(0); }
    10%  { opacity:0.7; transform:scale(1); }
    90%  { opacity:0.3; }
    100% { bottom:100%; opacity:0; transform:scale(0.5) translateX(30px); }
  }

  /* Domain panels */
  .cs-domain {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.07);
    border-left: 2px solid rgba(129,140,248,0.5);
    border-radius: 0 10px 10px 0;
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
    transition: background 0.2s;
  }
  .cs-domain:hover { background: rgba(129,140,248,0.04); }
  .cs-domain.open  { border-left-color: rgba(167,139,250,0.8); }

  .cs-domain-header {
    display: flex; align-items: center; gap: 1rem;
    padding: 1.1rem 1.5rem; cursor: pointer;
  }
  .cs-num {
    font-family: monospace; font-size: 2rem; font-weight: 800;
