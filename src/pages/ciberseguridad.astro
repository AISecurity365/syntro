---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Ciberseguridad para Empresas en España | AI Security";
const description = "Ciberseguridad para empresas: protección integral PyMEs (firewall, servidores, email, M365, Google Workspace, endpoints, ENS). Consulte en Alicante y España.";
const canonical = "https://aisecurity.es/ciberseguridad";
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://aisecurity.es/ciberseguridad#service",
    "name": "Ciberseguridad Integral para Empresas",
    "serviceType": "Consultoría y gestión de ciberseguridad por capas",
    "description": "Protección completa por capas: perímetro, servidores, endpoints, Microsoft 365, Google Workspace, identidad y cumplimiento ENS para empresas en España.",
    "provider": { "@id": "https://aisecurity.es/#organization" },
    "areaServed": { "@type": "Country", "name": "España" },
    "url": "https://aisecurity.es/ciberseguridad"
  }
  </script>

  <!-- ═══ HERO ═══ -->
  <section style="background:#020817;min-height:92vh;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:stretch;justify-content:center;">

    <!-- Fondo: cuadrícula tenue + glow morado -->
    <div class="absolute inset-0 pointer-events-none" style="background-image:linear-gradient(rgba(129,140,248,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(129,140,248,0.05) 1px,transparent 1px);background-size:48px 48px;"></div>
    <div class="absolute pointer-events-none" style="top:-160px;left:50%;transform:translateX(-30%);width:800px;height:800px;background:radial-gradient(circle,rgba(139,92,246,0.12),transparent 60%);border-radius:50%;"></div>
    <div class="absolute pointer-events-none" style="bottom:-200px;right:-100px;width:600px;height:600px;background:radial-gradient(circle,rgba(99,102,241,0.09),transparent 65%);border-radius:50%;"></div>

    <!-- Partículas flotantes (CSS only) -->
    <div class="cs-particles" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-24 py-24 flex flex-col lg:flex-row items-center gap-16">

      <!-- ─── RADAR ─── -->
      <div class="flex-shrink-0 relative" style="width:clamp(280px,42vw,500px);height:clamp(280px,42vw,500px);">

        <!-- Contador de amenazas sobre el radar -->
        <div class="absolute z-20" style="top:-8px;left:0;right:0;display:flex;justify-center;gap:2rem;justify-content:center;">
          <div style="font-family:monospace;font-size:0.7rem;color:rgba(239,68,68,0.7);letter-spacing:0.08em;">
            <span id="cs-counter" style="font-size:1rem;font-weight:700;color:#f87171;">3.241</span> amenazas bloqueadas hoy
          </div>
        </div>

        <svg id="cs-radar" viewBox="0 0 400 400" style="width:100%;height:100%;overflow:visible;margin-top:1.5rem;">
          <defs>
            <radialGradient id="rg-bg-v" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(129,140,248,0.1)"/>
              <stop offset="100%" stop-color="rgba(2,8,23,0)"/>
            </radialGradient>
            <radialGradient id="rg-center-v" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="rgba(167,139,250,0.3)"/>
              <stop offset="60%" stop-color="rgba(129,140,248,0.1)"/>
              <stop offset="100%" stop-color="rgba(129,140,248,0)"/>
            </radialGradient>
            <filter id="glow-v">
              <feGaussianBlur stdDeviation="2.5" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="glow-big">
              <feGaussianBlur stdDeviation="5" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="glow-icon">
              <feGaussianBlur stdDeviation="1.5" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <!-- Paths de ataque -->
            <path id="v-ph"  d="M 340,50  Q 290,130 200,200"/>
            <path id="v-dd"  d="M 200,10  Q 200,100 200,200"/>
            <path id="v-rw"  d="M 390,180 Q 310,200 200,200"/>
            <path id="v-bf"  d="M 320,360 Q 270,290 200,200"/>
            <path id="v-ml"  d="M 80,380  Q 130,300 200,200"/>
            <path id="v-ex"  d="M 10,120  Q 90,160  200,200"/>
          </defs>

          <!-- Fondo del radar -->
          <circle cx="200" cy="200" r="188" fill="url(#rg-bg-v)"/>

          <!-- Anillos -->
          <circle cx="200" cy="200" r="48"  fill="none" stroke="rgba(129,140,248,0.2)" stroke-width="0.8"/>
          <circle cx="200" cy="200" r="96"  fill="none" stroke="rgba(129,140,248,0.15)" stroke-width="0.8"/>
          <circle cx="200" cy="200" r="144" fill="none" stroke="rgba(129,140,248,0.1)" stroke-width="0.8"/>
          <circle cx="200" cy="200" r="188" fill="none" stroke="rgba(129,140,248,0.07)" stroke-width="0.8"/>

          <!-- Líneas de cuadrícula -->
          <line x1="200" y1="12" x2="200" y2="388" stroke="rgba(129,140,248,0.08)" stroke-width="0.6"/>
          <line x1="12"  y1="200" x2="388" y2="200" stroke="rgba(129,140,248,0.08)" stroke-width="0.6"/>
          <line x1="66"  y1="66"  x2="334" y2="334" stroke="rgba(129,140,248,0.05)" stroke-width="0.6"/>
          <line x1="334" y1="66"  x2="66"  y2="334" stroke="rgba(129,140,248,0.05)" stroke-width="0.6"/>

          <!-- Etiquetas de anillo -->
          <text x="205" y="152" font-size="6.5" fill="rgba(129,140,248,0.4)" font-family="monospace">ENDPOINT</text>
          <text x="205" y="104" font-size="6.5" fill="rgba(129,140,248,0.3)" font-family="monospace">NETWORK</text>
          <text x="205" y="18"  font-size="6.5" fill="rgba(129,140,248,0.2)" font-family="monospace">INTERNET</text>

          <!-- Sweep arm -->
          <g id="cs-sweep" style="transform-origin:200px 200px;">
            <line x1="200" y1="200" x2="200" y2="14" stroke="rgba(167,139,250,0.7)" stroke-width="1.2" stroke-linecap="round"/>
            <path d="M200,200 L200,14 A186,186 0 0,1 220,16 Z" fill="rgba(167,139,250,0.06)"/>
          </g>

          <!-- ──────────── ATAQUES ──────────── -->

          <!-- PHISHING (top-right) — icono sobre, ciclo 6s, delay 0 -->
          <text x="352" y="42" font-size="7" fill="rgba(239,68,68,0.55)" font-family="monospace" font-weight="700">PHISHING</text>
          <g opacity="0" filter="url(#glow-icon)">
            <animateMotion id="ph-m" dur="2.5s" begin="0s;ph-m.end+3.5s" calcMode="spline" keySplines="0.4 0 0.2 1"><mpath href="#v-ph"/></animateMotion>
            <animate attributeName="opacity" dur="2.5s" begin="0s;ph-m.end+3.5s" values="0;1;1;0" keyTimes="0;0.05;0.85;1"/>
            <rect x="-7" y="-5" width="14" height="10" rx="1.5" fill="#ef4444"/>
            <polyline points="-7,-5 0,1 7,-5" fill="none" stroke="rgba(0,0,0,0.25)" stroke-width="1.2" stroke-linejoin="round"/>
            <line x1="-7" y1="5" x2="7" y2="5" stroke="none"/>
          </g>
          <circle cx="200" cy="200" fill="none" stroke="#a78bfa" stroke-width="1.5" opacity="0">
            <animate attributeName="r" from="8" to="40" dur="0.8s" begin="ph-m.end;ph-m.end+6s"/>
            <animate attributeName="opacity" from="0.9" to="0" dur="0.8s" begin="ph-m.end;ph-m.end+6s"/>
          </circle>
          <circle cx="200" cy="200" fill="none" stroke="#818cf8" stroke-width="0.8" opacity="0">
            <animate attributeName="r" from="8" to="55" dur="1s" begin="ph-m.end;ph-m.end+6s"/>
            <animate attributeName="opacity" from="0.5" to="0" dur="1s" begin="ph-m.end;ph-m.end+6s"/>
          </circle>

          <!-- DDoS (top) — icono paquetes HTTP, ciclo 8s, delay 1.5s -->
          <text x="172" y="5" font-size="7" fill="rgba(239,68,68,0.55)" font-family="monospace" font-weight="700">DDoS</text>
          <g opacity="0" filter="url(#glow-icon)">
            <animateMotion id="dd-m" dur="3s" begin="1.5s;dd-m.end+5s" calcMode="spline" keySplines="0.4 0 0.2 1"><mpath href="#v-dd"/></animateMotion>
            <animate attributeName="opacity" dur="3s" begin="1.5s;dd-m.end+5s" values="0;1;1;0" keyTimes="0;0.05;0.85;1"/>
            <rect x="-7" y="-6" width="6" height="2.5" rx="0.8" fill="#dc2626"/>
            <rect x="-7" y="-1.5" width="6" height="2.5" rx="0.8" fill="#dc2626"/>
            <rect x="-7" y="3.5" width="6" height="2.5" rx="0.8" fill="#dc2626"/>
            <path d="M0.5,-4.5 L5,0 L0.5,4.5" fill="#dc2626"/>
          </g>
          <circle cx="200" cy="200" fill="none" stroke="#c084fc" stroke-width="2" opacity="0">
            <animate attributeName="r" from="10" to="50" dur="1s" begin="dd-m.end;dd-m.end+8.5s"/>
            <animate attributeName="opacity" from="1" to="0" dur="1s" begin="dd-m.end;dd-m.end+8.5s"/>
          </circle>

          <!-- RANSOMWARE (right) — icono candado, ciclo 9s, delay 3s -->
          <text x="394" y="175" font-size="7" fill="rgba(239,68,68,0.55)" font-family="monospace" font-weight="700" text-anchor="end">RANSOM</text>
          <g opacity="0" filter="url(#glow-icon)">
            <animateMotion id="rw-m" dur="2.8s" begin="3s;rw-m.end+6.2s" calcMode="spline" keySplines="0.4 0 0.2 1"><mpath href="#v-rw"/></animateMotion>
            <animate attributeName="opacity" dur="2.8s" begin="3s;rw-m.end+6.2s" values="0;1;1;0" keyTimes="0;0.05;0.85;1"/>
            <path d="M-3.5,-5.5 L-3.5,-2 A3.5,3.5 0 0,0 3.5,-2 L3.5,-5.5" fill="none" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round"/>
            <rect x="-5" y="-2" width="10" height="8" rx="1.5" fill="#ef4444"/>
            <circle cx="0" cy="2.5" r="1.5" fill="rgba(0,0,0,0.35)"/>
          </g>
          <circle cx="200" cy="200" fill="none" stroke="#a78bfa" stroke-width="1.5" opacity="0">
            <animate attributeName="r" from="8" to="44" dur="0.9s" begin="rw-m.end;rw-m.end+9s"/>
            <animate attributeName="opacity" from="0.8" to="0" dur="0.9s" begin="rw-m.end;rw-m.end+9s"/>
          </circle>

          <!-- BRUTEFORCE (bottom-right) — icono llave, ciclo 7s, delay 4.5s -->
          <text x="334" y="378" font-size="7" fill="rgba(251,146,60,0.55)" font-family="monospace" font-weight="700">BRUTE</text>
          <g opacity="0">
            <animateMotion id="bf-m" dur="2.8s" begin="4.5s;bf-m.end+4.2s" calcMode="spline" keySplines="0.4 0 0.2 1"><mpath href="#v-bf"/></animateMotion>
            <animate attributeName="opacity" dur="2.8s" begin="4.5s;bf-m.end+4.2s" values="0;0.8;0.8;0" keyTimes="0;0.05;0.85;1"/>
            <circle cx="-4" cy="0" r="3.5" fill="none" stroke="#fb923c" stroke-width="1.8"/>
            <circle cx="-4" cy="0" r="1.5" fill="#fb923c"/>
            <line x1="-0.5" y1="0" x2="7" y2="0" stroke="#fb923c" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="4" y1="0" x2="4" y2="2.8" stroke="#fb923c" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="6.5" y1="0" x2="6.5" y2="2.8" stroke="#fb923c" stroke-width="1.5" stroke-linecap="round"/>
          </g>
          <circle cx="200" cy="200" fill="none" stroke="#818cf8" stroke-width="1.2" opacity="0">
            <animate attributeName="r" from="8" to="38" dur="0.8s" begin="bf-m.end;bf-m.end+7s"/>
            <animate attributeName="opacity" from="0.7" to="0" dur="0.8s" begin="bf-m.end;bf-m.end+7s"/>
          </circle>

          <!-- MALWARE (bottom-left) — icono bug, ciclo 10s, delay 6.5s -->
          <text x="50" y="395" font-size="7" fill="rgba(239,68,68,0.55)" font-family="monospace" font-weight="700">MALWARE</text>
          <g opacity="0" filter="url(#glow-icon)">
            <animateMotion id="ml-m" dur="3s" begin="6.5s;ml-m.end+7s" calcMode="spline" keySplines="0.4 0 0.2 1"><mpath href="#v-ml"/></animateMotion>
            <animate attributeName="opacity" dur="3s" begin="6.5s;ml-m.end+7s" values="0;1;1;0" keyTimes="0;0.05;0.85;1"/>
            <ellipse cx="0" cy="0.5" rx="3.5" ry="5" fill="#ef4444"/>
            <line x1="-6" y1="-3" x2="-3.5" y2="-1" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="-6" y1="0.5" x2="-3.5" y2="0.5" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="-6" y1="4" x2="-3.5" y2="2" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="6" y1="-3" x2="3.5" y2="-1" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="6" y1="0.5" x2="3.5" y2="0.5" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="6" y1="4" x2="3.5" y2="2" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="-1.5" y1="-5.5" x2="-1.5" y2="-7.5" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="1.5" y1="-5.5" x2="1.5" y2="-7.5" stroke="#ef4444" stroke-width="1.2" stroke-linecap="round"/>
          </g>
          <circle cx="200" cy="200" fill="none" stroke="#c084fc" stroke-width="1.5" opacity="0">
            <animate attributeName="r" from="8" to="46" dur="0.9s" begin="ml-m.end;ml-m.end+10s"/>
            <animate attributeName="opacity" from="0.8" to="0" dur="0.9s" begin="ml-m.end;ml-m.end+10s"/>
          </circle>

          <!-- EXPLOIT (left) — icono terminal, ciclo 8s, delay 8s -->
          <text x="5" y="115" font-size="7" fill="rgba(251,146,60,0.55)" font-family="monospace" font-weight="700">EXPLOIT</text>
          <g opacity="0">
            <animateMotion id="ex-m" dur="2.6s" begin="8s;ex-m.end+5.4s" calcMode="spline" keySplines="0.4 0 0.2 1"><mpath href="#v-ex"/></animateMotion>
            <animate attributeName="opacity" dur="2.6s" begin="8s;ex-m.end+5.4s" values="0;0.8;0.8;0" keyTimes="0;0.05;0.85;1"/>
            <rect x="-7.5" y="-6" width="15" height="12" rx="2" fill="#1e1b4b"/>
            <rect x="-7.5" y="-6" width="15" height="12" rx="2" fill="none" stroke="#fb923c" stroke-width="1"/>
            <path d="M-5.5,-2 L-2.5,0 L-5.5,2" fill="none" stroke="#fb923c" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="-1" y1="2.5" x2="4" y2="2.5" stroke="#fb923c" stroke-width="1.5" stroke-linecap="round"/>
          </g>
          <circle cx="200" cy="200" fill="none" stroke="#818cf8" stroke-width="1.2" opacity="0">
            <animate attributeName="r" from="8" to="36" dur="0.7s" begin="ex-m.end;ex-m.end+8s"/>
            <animate attributeName="opacity" from="0.7" to="0" dur="0.7s" begin="ex-m.end;ex-m.end+8s"/>
          </circle>

          <!-- Zona central protegida -->
          <circle cx="200" cy="200" r="44" fill="url(#rg-center-v)">
            <animate attributeName="r" values="44;47;44" dur="3s" repeatCount="indefinite"/>
          </circle>
          <circle cx="200" cy="200" r="44" fill="none" stroke="rgba(167,139,250,0.5)" stroke-width="1.2">
            <animate attributeName="r" values="44;47;44" dur="3s" repeatCount="indefinite"/>
          </circle>
          <!-- Escudo SVG -->
          <path d="M200,184 L217,191 L217,207 C217,216 209.5,222 200,224 C190.5,222 183,216 183,207 L183,191 Z" fill="rgba(167,139,250,0.15)" stroke="#a78bfa" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M194,204 L197.5,208.5 L208,197" fill="none" stroke="#c084fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>

          <!-- Pulso de defensa permanente -->
          <circle cx="200" cy="200" fill="none" stroke="rgba(167,139,250,0.2)" stroke-width="1">
            <animate attributeName="r" values="50;80;50" dur="4s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.6;0;0.6" dur="4s" repeatCount="indefinite"/>
          </circle>

          <!-- Puntos de origen (fijos) -->
          <circle cx="340" cy="50"  r="3.5" fill="rgba(239,68,68,0.7)"/>
          <circle cx="200" cy="10"  r="3.5" fill="rgba(239,68,68,0.7)"/>
          <circle cx="390" cy="180" r="3"   fill="rgba(239,68,68,0.7)"/>
          <circle cx="320" cy="360" r="3"   fill="rgba(251,146,60,0.7)"/>
          <circle cx="80"  cy="380" r="3.5" fill="rgba(239,68,68,0.7)"/>
          <circle cx="10"  cy="120" r="3"   fill="rgba(251,146,60,0.7)"/>

          <!-- Borde exterior -->
          <circle cx="200" cy="200" r="188" fill="none" stroke="rgba(129,140,248,0.2)" stroke-width="1"/>
        </svg>

        <!-- Popup: ataque interceptado en el centro -->
        <div id="cs-attack-card" class="absolute z-30 pointer-events-none" style="left:50%;top:72%;transform:translate(-50%,-50%);opacity:0;transition:opacity 0.25s;min-width:128px;text-align:center;">
          <div id="cs-ack-inner" style="background:rgba(2,8,23,0.93);border:1px solid rgba(239,68,68,0.4);border-radius:8px;padding:0.45rem 0.75rem;">
            <div id="cs-ack-icon" style="font-size:0.95rem;line-height:1.3;"></div>
            <div id="cs-ack-type" style="font-size:0.56rem;font-family:monospace;font-weight:800;letter-spacing:0.12em;color:#f87171;"></div>
            <div style="height:1px;background:rgba(239,68,68,0.18);margin:0.25rem 0;"></div>
            <div id="cs-ack-prov" style="font-size:0.52rem;font-family:monospace;color:#94a3b8;letter-spacing:0.03em;margin-bottom:0.25rem;white-space:nowrap;"></div>
            <span style="font-size:0.46rem;font-family:monospace;font-weight:700;letter-spacing:0.1em;color:#4ade80;background:rgba(74,222,128,0.1);border:1px solid rgba(74,222,128,0.28);padding:1px 5px;border-radius:3px;">✓ BLOQUEADO</span>
          </div>
        </div>

        <!-- Estado "ACTIVO" -->
        <div class="absolute" style="bottom:0;right:0;font-family:monospace;font-size:0.68rem;color:#a78bfa;letter-spacing:0.06em;">
          <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#a78bfa;margin-right:5px;animation:cs-pulse 2s infinite;"></span>MONITORIZANDO
        </div>
      </div>

      <!-- ─── HEADLINE ─── -->
      <div class="flex-1">
        <p style="font-size:0.72rem;letter-spacing:0.18em;color:#818cf8;margin-bottom:1.25rem;font-family:monospace;text-transform:uppercase;">Defensa por capas · 10 dominios de seguridad</p>

        <h1 class="font-bold leading-tight mb-6" style="font-size:clamp(2rem,3.8vw,3.8rem);letter-spacing:-0.03em;color:#f0f9ff;">
          Cada capa de tu empresa,<br/>
          <span style="background:linear-gradient(135deg,#60a5fa 0%,#818cf8 50%,#c084fc 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">protegida</span>
        </h1>

        <p class="mb-8 leading-relaxed" style="color:#94a3b8;font-size:1.05rem;max-width:500px;">
          La ciberseguridad no es un producto — es un conjunto de capas. Desde el firewall perimetral hasta la concienciación de tu equipo, cubrimos todos los vectores de ataque.
        </p>

        <!-- Stats -->
        <div class="flex flex-wrap gap-8 mb-8">
          <div>
            <div class="font-mono text-2xl font-bold" style="color:#818cf8;">7</div>
            <div class="text-xs mt-0.5" style="color:#475569;">sistemas de seguridad</div>
          </div>
          <div>
            <div class="font-mono text-2xl font-bold" style="color:#a78bfa;">+50</div>
            <div class="text-xs mt-0.5" style="color:#475569;">controles implementables</div>
          </div>
          <div>
            <div class="font-mono text-2xl font-bold" style="color:#c084fc;">ENS</div>
            <div class="text-xs mt-0.5" style="color:#475569;">ISO 27001 · RGPD</div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/presupuesto?plan=ciberseguridad" style="color:white;background:linear-gradient(135deg,#4f46e5,#7c3aed);box-shadow:0 8px 32px rgba(139,92,246,0.3);" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl font-semibold text-sm transition-all hover:-translate-y-0.5">
            Analizar mi empresa
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/calculadora-it" style="color:#a78bfa;border-color:rgba(167,139,250,0.25);background:rgba(139,92,246,0.06);" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl font-semibold text-sm border transition-all hover:-translate-y-0.5">
