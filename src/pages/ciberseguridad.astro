<style>
  /* Radar sweep animation */
  #cs-sweep {
    animation: cs-radar-spin 4s linear infinite;
  }
  @keyframes cs-radar-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* Domain panels */
  .cs-domain {
    position: relative;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.07);
    border-left: 3px solid var(--dc, #22d3ee);
    border-radius: 0 12px 12px 0;
    overflow: hidden;
    transition: background 0.2s, border-color 0.2s;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
  }
  .cs-domain:hover {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.12);
  }

  .cs-domain-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
  }

  .cs-domain-icon {
    flex-shrink: 0;
    line-height: 1;
  }

  .cs-tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-family: monospace;
    letter-spacing: 0.02em;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.6);
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s;
  }
  .cs-domain:hover .cs-tag {
    border-color: rgba(var(--dc), 0.2);
  }

  .cs-badge {
    font-size: 0.65rem;
    font-family: monospace;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(var(--bc), 0.1);
    border: 1px solid rgba(var(--bc), 0.3);
    color: var(--bc, #ef4444);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Domain detail (collapsed by default) */
  .cs-domain-detail {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding: 0 1.5rem;
  }
  .cs-domain.open .cs-domain-detail {
    max-height: 600px;
    padding: 0 1.5rem 1.5rem;
  }
  .cs-domain.open .cs-chevron {
    transform: rotate(180deg);
  }

  .cs-detail-item {
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #94a3b8;
  }

  @media (max-width: 640px) {
    .cs-domain-num { display: none; }
    .cs-domain-header { gap: 0.75rem; flex-wrap: wrap; }
  }
</style>

<script is:inline>
  document.querySelectorAll('.cs-domain').forEach(domain => {
    const header = domain.querySelector('.cs-domain-header');
    if (header) {
      header.addEventListener('click', () => {
        domain.classList.toggle('open');
      });
    }
  });
</script>

