---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConsultoriaHero from "../components/consultoria/ConsultoriaHero.astro";
import ConsultoriaIdeaForm from "../components/consultoria/ConsultoriaIdeaForm.astro";
import "../styles/consultoria-ia.css";

const title = "Consultoría de IA para Empresas por Departamentos | AI Security";
const description = "Consultoría IA para empresas: descubre casos de uso por departamento para mejorar tareas y procesos junto a tu equipo. Primera consulta gratuita.";
const canonical = "https://aisecurity.es/consultoria-ia";

const faqs = [
          {
            q: "¿Necesito conocimientos técnicos para trabajar con vosotros?",
            a: "No. Nos encargamos de toda la parte técnica: configuración, integración con tus herramientas actuales y puesta en marcha. Tu equipo solo necesita aprender a usar las soluciones, que es precisamente lo que cubrimos en la formación."
          },
          {
            q: "¿Cuánto tarda en implementarse una solución de IA?",
            a: "Depende de la complejidad. Un chatbot básico o un flujo de automatización puede estar funcionando en 2-3 semanas. Una implementación completa por departamentos puede llevar 2-3 meses. En la propuesta siempre indicamos plazos concretos."
          },
          {
            q: "¿Trabajáis con empresas pequeñas o solo con grandes corporaciones?",
            a: "La mayoría de nuestros clientes son PyMEs de 10 a 150 empleados. Adaptamos la propuesta y la inversión al tamaño real de cada empresa. No tiene sentido instalar un sistema complejo donde no se va a aprovechar."
          },
          {
            q: "¿Qué pasa si una herramienta de IA queda obsoleta?",
            a: "El ecosistema IA cambia constantemente. Por eso ofrecemos mantenimiento y revisión periódica. Si una herramienta queda obsoleta o aparece una mejor alternativa, te lo comunicamos y gestionamos la transición."
          },
          {
            q: "¿Tengo que cambiar el software que ya uso?",
            a: "No necesariamente. Integramos las soluciones de IA con las herramientas que ya tenéis: ERP, CRM, email, Google Workspace, etc. El objetivo es añadir automatización por encima de lo que ya funciona, no reemplazar todo."
          },
          {
            q: "¿Cuándo se nota el retorno de la inversión?",
            a: "Depende de la solución. Un flujo de automatización de facturas o emails suele amortizarse en el primer mes. Soluciones más completas como gestores documentales o chatbots integrados con ERP, en 2-4 meses. En la propuesta siempre incluimos una estimación de ahorro mensual."
          },
          {
            q: "¿La consultoría incluye formación para mi equipo?",
            a: "Sí, siempre. No entregamos una herramienta y desaparecemos. Formamos a las personas que la van a usar con sesiones prácticas adaptadas a su nivel, guías de uso y soporte durante el periodo de adaptación."
          },
        ];

const departamentos = [
  {
    "id": "comunicacion",
    "nombre": "Comunicación",
    "icon": "🎨",
    "color": "#38bdf8",
    "resumen": "Del borrador a la publicación, con el criterio y la voz de tu equipo.",
    "objetivos": [
      {
        "icono": "✓",
        "texto": "Dedicar más tiempo al mensaje y menos a preparar versiones."
      },
      {
        "icono": "✓",
        "texto": "Mantener un tono coherente en los distintos canales."
      }
    ],
    "casos": [
      {
        "nombre": "Convertir una idea en varias piezas",
        "uso": "A partir de una novedad de tu empresa, preparar borradores para un email, una publicación y un guion de vídeo. El equipo revisa el mensaje antes de publicarlo."
      },
      {
        "nombre": "Reutilizar lo que ya tenéis",
        "uso": "Convertir una presentación o un webinar en un resumen, preguntas frecuentes y propuestas de contenido para redes."
      },
      {
        "nombre": "Preparar una campaña",
        "uso": "Organizar un calendario de contenidos y proponer textos y conceptos visuales a partir del público y los objetivos que defináis."
      },
      {
        "nombre": "Adaptar mensajes a cada público",
        "uso": "Crear versiones de una comunicación para clientes, distribuidores o empleados, revisando datos, tono y traducciones."
      }
    ]
  },
  {
    "id": "comercial",
    "nombre": "Comercial & SEO",
    "icon": "📊",
    "color": "#86a9ff",
    "resumen": "Preparar propuestas y seguimientos con la información que ya maneja tu equipo.",
    "objetivos": [
      {
        "icono": "✓",
        "texto": "Reducir el trabajo de copiar datos entre reuniones, propuestas y CRM."
      },
      {
        "icono": "✓",
        "texto": "Llegar a cada conversación con un contexto más claro."
      }
    ],
    "casos": [
      {
        "nombre": "Pasar de reunión a propuesta",
        "uso": "Usar notas de una reunión para preparar un borrador con necesidades, alcance y próximos pasos. El comercial valida precios y compromisos."
      },
      {
        "nombre": "Dar seguimiento a las oportunidades",
        "uso": "Preparar recordatorios y borradores de email según lo hablado con cada cliente y el estado registrado en el CRM."
      },
      {
        "nombre": "Entender qué pasa con las ventas",
        "uso": "Resumir los datos disponibles: oportunidades sin respuesta, motivos de pérdida y cambios por producto o periodo."
      },
      {
        "nombre": "Priorizar mejoras de la web",
        "uso": "Cruzar consultas de buscadores con las páginas que reciben visitas para proponer contenidos y mejoras que el equipo pueda valorar."
      }
    ]
  },
  {
    "id": "callcenter",
    "nombre": "Call Center & Soporte",
    "icon": "📞",
    "color": "#60a5fa",
    "resumen": "Ayudar a atender consultas y entregar al equipo humano el contexto que necesita.",
    "objetivos": [
      {
        "icono": "✓",
        "texto": "Evitar que el cliente tenga que repetir toda su consulta."
      },
      {
        "icono": "✓",
        "texto": "Reservar la atención del equipo para los casos que requieren criterio."
      }
    ],
    "casos": [
      {
        "nombre": "Resolver preguntas frecuentes",
        "uso": "Responder sobre horarios, servicios o procedimientos usando información aprobada. Si falta información, derivar la consulta a una persona."
      },
      {
        "nombre": "Recoger una solicitud fuera de horario",
        "uso": "Tomar el motivo del contacto y los datos necesarios para que el equipo pueda responder después, sin prometer una solución inmediata."
      },
      {
        "nombre": "Preparar al agente antes de responder",
        "uso": "Resumir el historial disponible y sugerir una respuesta basada en los procedimientos internos para que el agente la revise."
      },
      {
        "nombre": "Ordenar las incidencias entrantes",
        "uso": "Clasificar solicitudes por tema y prioridad según criterios acordados y dirigirlas al equipo adecuado."
      }
    ]
  },
  {
    "id": "proyectos",
    "nombre": "Gestión de Proyectos",
    "icon": "📋",
    "color": "#a5b4fc",
    "resumen": "Convertir conversaciones y actualizaciones en un seguimiento más fácil de mantener.",
    "objetivos": [
      {
        "icono": "✓",
        "texto": "Reducir el tiempo dedicado a preparar actas e informes de estado."
      },
      {
        "icono": "✓",
        "texto": "Hacer más visibles los acuerdos, los pendientes y los bloqueos."
      }
    ],
    "casos": [
      {
        "nombre": "Convertir reuniones en tareas",
        "uso": "Preparar un acta con decisiones, responsables propuestos y fechas a partir de las notas. Los participantes confirman los acuerdos."
      },
      {
        "nombre": "Preparar el informe semanal",
        "uso": "Reunir las actualizaciones del gestor de tareas y resumir avances, pendientes y bloqueos para cada responsable."
      },
      {
        "nombre": "Detectar pendientes sin seguimiento",
        "uso": "Señalar tareas sin responsable, fechas vencidas o dependencias registradas que pueden afectar a la entrega."
      },
      {
        "nombre": "Recuperar el contexto de una decisión",
        "uso": "Encontrar acuerdos y documentos de un proyecto, mostrando la fuente para que el equipo pueda comprobarlos."
      }
    ]
  },
  {
    "id": "administracion",
    "nombre": "Administración",
    "icon": "🧾",
    "color": "#a5b4fc",
    "resumen": "Menos copiar y pegar; más tiempo para revisar documentos, importes y excepciones.",
    "objetivos": [
      {
        "icono": "✓",
        "texto": "Reducir la introducción repetitiva de datos."
      },
      {
        "icono": "✓",
        "texto": "Facilitar la revisión antes de registrar, enviar o aprobar documentos."
      }
    ],
    "casos": [
      {
        "nombre": "Preparar el registro de facturas",
        "uso": "Extraer proveedor, fecha, base e impuestos de las facturas y proponer su registro. El equipo revisa importes y posibles duplicados."
      },
      {
        "nombre": "Organizar el correo administrativo",
        "uso": "Separar facturas, solicitudes y avisos, y proponer respuestas o tareas según el procedimiento de la empresa."
      },
      {
        "nombre": "Revisar vencimientos",
        "uso": "Preparar un listado de cobros y pagos pendientes a partir de los datos disponibles y borradores de recordatorio para validar."
      },
      {
        "nombre": "Encontrar datos en contratos",
        "uso": "Localizar plazos, renovaciones y condiciones en los documentos, con referencias al original para su revisión."
      }
    ]
  },
  {
    "id": "desarrollo",
    "nombre": "Desarrollo",
    "icon": "💻",
    "color": "#b7a0fa",
    "resumen": "Ayudar al equipo a entender, escribir y revisar código dentro de sus propios procesos.",
    "objetivos": [
      {
        "icono": "✓",
        "texto": "Reducir tareas repetitivas de programación y documentación."
      },
      {
        "icono": "✓",
        "texto": "Dar más contexto a las revisiones y las pruebas."
      }
    ],
    "casos": [
      {
        "nombre": "Entender un proyecto existente",
        "uso": "Explorar el código para explicar dónde se realiza una operación y qué componentes podrían verse afectados por un cambio."
      },
      {
        "nombre": "Preparar una primera implementación",
        "uso": "Generar un borrador a partir de requisitos y convenciones del proyecto. Los desarrolladores revisan el código antes de integrarlo."
      },
      {
        "nombre": "Ampliar las pruebas",
        "uso": "Proponer casos normales, errores y situaciones límite, y ayudar a escribir pruebas que el equipo ejecuta y valida."
      },
      {
        "nombre": "Mantener documentación útil",
        "uso": "Preparar instrucciones de uso, notas de versión y explicaciones de cambios a partir del código revisado."
      }
    ]
  },
  {
    "id": "devops",
    "nombre": "DevOps",
    "icon": "⚙️",
    "color": "#a78bfa",
    "resumen": "Dar apoyo al equipo que prepara despliegues y mantiene los servicios en funcionamiento.",
    "objetivos": [
      {
        "icono": "✓",
        "texto": "Reunir información para investigar fallos con menos pasos manuales."
      },
      {
        "icono": "✓",
        "texto": "Preparar cambios más fáciles de revisar y repetir."
      }
    ],
    "casos": [
      {
        "nombre": "Investigar un despliegue fallido",
        "uso": "Resumir los registros del proceso y proponer comprobaciones para encontrar por qué una versión no se ha desplegado."
      },
      {
        "nombre": "Preparar una configuración repetible",
        "uso": "Ayudar a escribir y revisar los archivos que configuran un entorno, probándolos antes de aplicarlos en producción."
      },
      {
        "nombre": "Revisar diferencias entre entornos",
        "uso": "Comparar configuraciones de pruebas y producción para señalar diferencias que el equipo deba comprobar."
      },
      {
        "nombre": "Documentar cómo recuperar un servicio",
        "uso": "Preparar una guía con comprobaciones, pasos de recuperación y vuelta atrás a partir de procedimientos validados."
      }
    ]
  },
  {
    "id": "sistemas",
    "nombre": "Sistemas",
    "icon": "🖥️",
    "color": "#c084fc",
    "resumen": "Ayudar a resolver incidencias, mantener documentación y preparar tareas de administración.",
    "objetivos": [
      {
        "icono": "✓",
        "texto": "Reducir el tiempo de recopilar información antes de actuar."
      },
      {
        "icono": "✓",
        "texto": "Hacer que el conocimiento técnico sea más fácil de consultar y compartir."
      }
    ],
    "casos": [
      {
        "nombre": "Investigar una incidencia",
        "uso": "Reunir los registros y cambios recientes de un servidor, resumir qué ha ocurrido y proponer comprobaciones. El técnico decide qué acciones ejecutar."
      },
      {
        "nombre": "Documentar una intervención",
        "uso": "A partir del ticket y las acciones registradas, preparar un borrador para la wiki: qué falló, cómo se resolvió y qué conviene revisar."
      },
      {
        "nombre": "Preparar altas y bajas",
        "uso": "Convertir una solicitud en una lista de cuentas, permisos y equipos que revisar. Las acciones se ejecutan con la aprobación del responsable."
      },
      {
        "nombre": "Entender y priorizar alertas",
        "uso": "Resumir las alertas de las herramientas de monitorización y seguridad, relacionarlas con los equipos afectados y ayudar al técnico a investigar."
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <!-- Schema JSON-LD — Service + FAQPage para GEO -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Consultoría de Inteligencia Artificial para Empresas",
    "alternateName": "Consultoría IA empresas España",
    "description": "Servicio de análisis, implementación y formación de herramientas de IA adaptadas a cada departamento de la empresa. Cubre administración, comercial, atención al cliente, comunicación, gestión de proyectos, desarrollo y sistemas.",
    "provider": {
      "@type": "Organization",
      "name": "AI Security",
      "url": "https://aisecurity.es",
      "areaServed": "ES"
    },
    "serviceType": "Consultoría de Inteligencia Artificial para empresas",
    "areaServed": "España",
    "availableChannel": {
      "@type": "ServiceChannel",
      "serviceUrl": "https://aisecurity.es/consultoria-ia",
      "availableLanguage": ["Spanish", "Catalan", "English"]
    },
    "offers": {
      "@type": "Offer",
      "description": "Primera consulta gratuita. Propuesta personalizada sin compromiso. Implementaciones desde 1.500€ por departamento.",
      "availability": "https://schema.org/InStock"
    }
  }
  </script>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: faqs.map(({q, a}) => ({"@type": "Question", name: q, acceptedAnswer: {"@type": "Answer", text: a}}))
  })} />

  <div class="consulting-page">
  <ConsultoriaHero />

  <!-- Modal overlay para demos -->
  <div id="demo-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" tabindex="-1" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.88); backdrop-filter:blur(6px);">
    <div style="position:relative; width:100%; height:100%; display:flex; flex-direction:column;">
      <div style="background: linear-gradient(135deg, #0f1117, #161b25); border-bottom: 1px solid rgba(255,255,255,0.1); padding: 14px 24px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0;">
        <div style="display:flex; align-items:center; gap:12px;">
          <div style="display:flex; gap:6px;">
            <div style="width:10px;height:10px;border-radius:50%;background:#ef4444;"></div>
            <div style="width:10px;height:10px;border-radius:50%;background:#eab308;"></div>
            <div style="width:10px;height:10px;border-radius:50%;background:#22c55e;"></div>
          </div>
          <span id="modal-title" style="color:#e2e8f0; font-size:0.9rem; font-weight:600; font-family:monospace;"></span>
        </div>
        <button id="close-modal-btn" style="color:#94a3b8; font-size:1.4rem; font-weight:300; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.12); cursor:pointer; line-height:1; padding:6px 12px; border-radius:8px; transition:all .15s;">✕ Cerrar</button>
      </div>
      <iframe title="Demo interactiva del servicio" id="demo-iframe" src="" style="flex:1; border:none; width:100%;" loading="lazy"></iframe>
    </div>
  </div>

  <!-- DIAGRAMA INTERACTIVO -->
  <section id="departamentos" class="ci-departments" style="background: #0a0d1a; padding: 80px 0; position: relative; overflow: hidden;">
    <!-- Fondo sutil: sala de servidores -->
    <div class="absolute inset-0" style="background-image: url('/images/consultoria-bg.jpg'); background-size: cover; background-position: center; opacity: 0.20;"></div>
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(10,13,26,0.55) 0%, rgba(15,22,40,0.35) 50%, rgba(10,13,26,0.6) 100%);"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-3" style="color: #e2e8f0;">
          ¿Qué IA puede usar cada departamento?
        </h2>
        <p style="color: #a4b2c8; font-size: 1.05rem; max-width: 480px; margin: 0 auto;">Selecciona un departamento y descubre ejemplos de tareas que podemos mejorar con tu equipo.</p>
      </div>

      <div class="ci-department-picker" role="group" aria-label="Seleccionar departamento">
        {departamentos.map(dep => <button type="button" data-department={dep.id} aria-pressed="false">{dep.nombre}</button>)}
      </div>
      <!-- Diagram + Panel layout -->
      <div class="ci-department-layout">

        <!-- Diagram + descripción debajo -->
        <div id="diagram-container" style="width: 100%; max-width: 560px; flex-shrink: 0; display: flex; flex-direction: column; gap: 16px;">
          <svg id="diagram-svg" viewBox="0 0 560 560" style="display: block; margin: 0 auto; width: min(100%, 560px); height: auto;">
            <!-- Anillo de cuenta atrás: se vacía en 10s durante auto-rotación -->
            <circle id="cc-ring" cx="280" cy="280" r="72" fill="none" stroke="#4f7cff" stroke-width="3" stroke-dasharray="452 452" stroke-linecap="round" transform="rotate(-90 280 280)" style="opacity:0;"/>
            <g id="lines"></g>
            <g id="center-node">
              <circle cx="280" cy="280" r="62" fill="#1a1d27" stroke="#4f7cff" stroke-width="2"/>
              <circle cx="280" cy="280" r="56" fill="#0f1628" stroke="#4f7cff" stroke-width="1" opacity="0.5"/>
              <text x="280" y="272" text-anchor="middle" fill="#e2e8f0" font-size="14" font-weight="700">Tu</text>
              <text x="280" y="290" text-anchor="middle" fill="#e2e8f0" font-size="14" font-weight="700">Empresa</text>
              <text x="280" y="308" text-anchor="middle" fill="#4f7cff" font-size="10">+ IA</text>
            </g>
            <g id="nodes"></g>
          </svg>
        </div>

        <!-- Panel de beneficios y casos de uso -->
        <div id="info-panel" style="flex: 1; min-width: 300px; max-width: 480px; position: sticky; top: 24px;">
          <div id="panel-default" style="background: #1a1d27; border: 1px solid #2a2d3a; border-radius: 16px; padding: 32px; text-align: center;">
            <div style="font-size: 48px; margin-bottom: 16px; opacity: 0.4;">👆</div>
            <p style="color: #a4b2c8; font-size: 1rem;">Selecciona un departamento para descubrir casos de uso en su trabajo diario.</p>
          </div>
          <div id="panel-active" style="display: none; background: #1a1d27; border-radius: 16px; overflow: hidden; min-height: 560px;">
            <div id="panel-header" style="padding: 20px 24px; display: flex; align-items: center; gap: 12px;">
              <span id="panel-icon" style="font-size: 28px;"></span>
              <div>
                <div id="panel-title" style="font-size: 1.2rem; font-weight: 700; color: #e2e8f0; margin-bottom: 4px;"></div>
                <p id="panel-resumen" style="font-size: 0.85rem; color: #94a3b8;"></p>
              </div>
            </div>
            <!-- OBJETIVOS -->
            <div style="padding: 0 24px 4px;">
              <p style="font-size: 0.75rem; font-weight: 600; color: #a78bfa; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; margin-top: 16px;">Qué gana tu empresa</p>
              <div id="panel-objetivos" style="display: flex; flex-direction: column; gap: 6px;"></div>
            </div>
            <div style="padding: 0 24px;">
              <p style="font-size: 0.75rem; font-weight: 600; color: #4f7cff; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; margin-top: 12px;">Ejemplos en el día a día</p>
              <div id="panel-tools" class="ci-use-cases" style="display: flex; flex-direction: column; gap: 8px;"></div>
            </div>
            <div style="padding: 0 24px 24px; margin-top: 16px;">
              <a href="/presupuesto?plan=Consultoria-IA" style="display: block; text-align: center; background: linear-gradient(135deg, #4f7cff, #7c3aed); color: #ffffff; border-radius: 10px; padding: 12px; font-size: 0.9rem; font-weight: 600; text-decoration: none;">
                Quiero explorar estos casos →
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


<section class="ci-custom-case" aria-labelledby="ci-custom-title">
    <div class="ci-shell ci-custom-case-inner">
      <div><p class="ci-eyebrow">Tu caso también cuenta</p><h2 id="ci-custom-title">¿Se podría automatizar esto en mi empresa?</h2><p>Cuéntanos qué tarea os quita tiempo, cómo la hacéis y qué programas utilizáis. Valoramos si tiene sentido automatizarla, qué información haría falta y dónde debe intervenir una persona.</p></div>
      <ConsultoriaIdeaForm />
    </div>
  </section>

  <!-- CIUDADES COMUNITAT VALENCIANA -->
  <!-- FAQ -->
  <section class="ci-faq" style="background: linear-gradient(135deg, #0a0d1a 0%, #0f1628 100%); padding: 80px 0; border-top: 1px solid rgba(255,255,255,0.06);">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: #e2e8f0;">¿Qué nos preguntan antes de empezar?</h2>
        <p style="color: #a4b2c8; font-size: 1.05rem; max-width: 480px; margin: 0 auto; line-height: 1.7;">Respuestas directas a las dudas más habituales sobre implementar IA en tu empresa.</p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        {faqs.map((item, i) => (
          <div class="faq-item" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; overflow: hidden;">
            <button class="faq-btn" aria-expanded="false" aria-controls={"ci-faq-" + i} style="width:100%; display:flex; align-items:center; justify-content:space-between; gap:12px; padding: 18px 24px; background:none; border:none; cursor:pointer; text-align:left;">
              <h3 style="font-size: 0.95rem; font-weight: 700; color: #e2e8f0; margin: 0; line-height: 1.4;">{item.q}</h3>
              <svg class="faq-chevron" style="width:18px;height:18px;flex-shrink:0;color:#4f7cff;transition:transform .25s ease;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-body" id={"ci-faq-" + i} style="display:none; padding: 0 24px 18px;">
              <p style="color: #94a3b8; font-size: 0.875rem; line-height: 1.75; margin: 0; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 14px;">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="ci-closing" style="background: linear-gradient(135deg, #0f1628 0%, #1a0a2e 50%, #0a0d1a 100%); padding: 80px 0; position: relative; overflow: hidden;">
    <div class="absolute inset-0 pointer-events-none opacity-30" style="background-image: radial-gradient(circle at 50% 50%, rgba(79,124,255,0.3), transparent 60%);"></div>
    <div class="max-w-3xl mx-auto px-6 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium mb-6" style="background: rgba(79,124,255,0.15); border: 1px solid rgba(79,124,255,0.3); color: #7da4ff;">
        <span>🎯</span> Primera consulta gratuita
      </div>
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: #fff;">¿Listo para ver qué IA puede hacer por tu empresa?</h2>
      <p class="text-lg mb-8" style="color: #94a3b8; line-height: 1.7;">Sin compromiso. Te decimos honestamente qué tiene sentido implementar en tu caso y qué retorno puedes esperar.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/presupuesto?plan=Consultoria-IA"
          class="inline-flex items-center gap-3 px-8 py-4 rounded-xl font-bold text-lg transition-all"
          style="background: linear-gradient(135deg, #4f7cff, #7c3aed); color: #ffffff;">
          Solicitar consulta gratuita →
        </a>
        <a href="/reunion"
          class="inline-flex items-center gap-3 px-8 py-4 rounded-xl font-bold text-lg transition-all"
          style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15); color: #cbd5e1;">
          Reservar reunión
        </a>
      </div>
    </div>
  </section>

  <!-- Enlace discreto a páginas provinciales (SEO local, sin ocupar protagonismo) -->
  <div style="background: #0a0d1a; padding: 18px 0; border-top: 1px solid rgba(255,255,255,0.05);">
    <p class="text-center" style="color: #a4b2c8; font-size: 0.75rem;">
      También en
      <a href="/consultoria-ia-valencia" style="color: #a4b2c8; text-decoration: underline; text-underline-offset: 2px;">Valencia</a>,
      <a href="/consultoria-ia-castellon" style="color: #a4b2c8; text-decoration: underline; text-underline-offset: 2px;">Castellón</a>
      y <a href="/consultoria-ia-alicante" style="color: #a4b2c8; text-decoration: underline; text-underline-offset: 2px;">Alicante</a>
    </p>
  </div>

  </div>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('[data-demo-url]').forEach(button => {
    button.addEventListener('click', () => openDemo(button.dataset.demoUrl, button.dataset.demoTitle));
  });
  let demoTrigger = null;
  // Modal de demos
  function openDemo(url, title) {
    demoTrigger = document.activeElement;
    document.getElementById('modal-title').textContent = title;
    document.getElementById('demo-iframe').src = url;
    document.getElementById('demo-modal').style.display = 'block';
    document.body.style.overflow = 'hidden';
    document.getElementById('close-modal-btn').focus();

  }
  function closeDemo() {
    document.getElementById('demo-modal').style.display = 'none';
    document.getElementById('demo-iframe').src = '';
    document.body.style.overflow = '';
    if (demoTrigger) demoTrigger.focus();
  }
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeDemo(); });
  document.getElementById('close-modal-btn').addEventListener('click', closeDemo);

  // FAQ acordeón
  document.querySelectorAll('.faq-item').forEach(function(item) {
    var btn = item.querySelector('.faq-btn');
    var body = item.querySelector('.faq-body');
    var chevron = item.querySelector('.faq-chevron');
    btn.addEventListener('click', function() {
      var isOpen = body.style.display === 'block';
      document.querySelectorAll('.faq-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(!isOpen));
      document.querySelectorAll('.faq-body').forEach(function(b) { b.style.display = 'none'; });
      document.querySelectorAll('.faq-chevron').forEach(function(c) { c.style.transform = ''; });
      if (!isOpen) { body.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });
</script>

<script define:vars={{ departamentos }} is:inline>
  const SVG_SIZE = 560;
  const CENTER = SVG_SIZE / 2;
  const ORBIT_RADIUS = 200;
  const NODE_RADIUS = 46;

  const linesGroup = document.getElementById('lines');
  const nodesGroup = document.getElementById('nodes');
  const panelDefault = document.getElementById('panel-default');
  const panelActive = document.getElementById('panel-active');
  const panelHeader = document.getElementById('panel-header');
  const panelIcon = document.getElementById('panel-icon');
  const panelTitle = document.getElementById('panel-title');
  const panelResumen = document.getElementById('panel-resumen');
  const panelTools = document.getElementById('panel-tools');

  let activeId = null;
  let userSelected = false; // true = el usuario ha fijado un departamento
  let autoTimer = null;

  function getPos(index, total) {
    const angle = (index / total) * 2 * Math.PI - Math.PI / 2;
    return { x: CENTER + ORBIT_RADIUS * Math.cos(angle), y: CENTER + ORBIT_RADIUS * Math.sin(angle) };
  }

  // Draw lines
  departamentos.forEach((dep, i) => {
    const pos = getPos(i, departamentos.length);
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', CENTER); line.setAttribute('y1', CENTER);
    line.setAttribute('x2', pos.x); line.setAttribute('y2', pos.y);
    line.setAttribute('stroke', dep.color);
    line.setAttribute('stroke-width', '1.5');
    line.style.opacity = '0.3';
    line.id = `line-${dep.id}`;
    linesGroup.appendChild(line);
  });

  // Draw nodes
  departamentos.forEach((dep, i) => {
    const pos = getPos(i, departamentos.length);
    const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    g.setAttribute('cursor', 'pointer');
    g.id = `node-${dep.id}`;

    const bg = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    bg.setAttribute('cx', pos.x); bg.setAttribute('cy', pos.y); bg.setAttribute('r', NODE_RADIUS);
    bg.setAttribute('fill', '#1a1d27'); bg.setAttribute('stroke', dep.color);
    bg.setAttribute('stroke-width', '1.5'); bg.setAttribute('opacity', '0.8');
    bg.id = `bg-${dep.id}`;

    const icon = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    icon.setAttribute('x', pos.x); icon.setAttribute('y', pos.y - 8);
    icon.setAttribute('text-anchor', 'middle'); icon.setAttribute('dominant-baseline', 'middle');
    icon.setAttribute('font-size', '20');
    icon.textContent = dep.icon;

    const words = dep.nombre.split(' & ');
    if (words.length > 1) {
      const t1 = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t1.setAttribute('x', pos.x); t1.setAttribute('y', pos.y + 10);
      t1.setAttribute('text-anchor', 'middle'); t1.setAttribute('fill', '#cbd5e1');
      t1.setAttribute('font-size', '9'); t1.setAttribute('font-weight', '600');
      t1.textContent = words[0];
      const t2 = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t2.setAttribute('x', pos.x); t2.setAttribute('y', pos.y + 22);
      t2.setAttribute('text-anchor', 'middle'); t2.setAttribute('fill', '#4f7cff');
      t2.setAttribute('font-size', '8'); t2.setAttribute('font-weight', '600');
      t2.textContent = '& ' + words[1];
      g.appendChild(bg); g.appendChild(icon); g.appendChild(t1); g.appendChild(t2);
    } else {
      const nameWords = dep.nombre.split(' ');
      if (nameWords.length > 2) {
        const t1 = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        t1.setAttribute('x', pos.x); t1.setAttribute('y', pos.y + 10);
        t1.setAttribute('text-anchor', 'middle'); t1.setAttribute('fill', '#cbd5e1');
        t1.setAttribute('font-size', '9'); t1.setAttribute('font-weight', '600');
        t1.textContent = nameWords.slice(0, 2).join(' ');
        const t2 = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        t2.setAttribute('x', pos.x); t2.setAttribute('y', pos.y + 22);
        t2.setAttribute('text-anchor', 'middle'); t2.setAttribute('fill', '#cbd5e1');
        t2.setAttribute('font-size', '9'); t2.setAttribute('font-weight', '600');
        t2.textContent = nameWords.slice(2).join(' ');
        g.appendChild(bg); g.appendChild(icon); g.appendChild(t1); g.appendChild(t2);
      } else {
        const name = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        name.setAttribute('x', pos.x); name.setAttribute('y', pos.y + 16);
        name.setAttribute('text-anchor', 'middle'); name.setAttribute('fill', '#cbd5e1');
        name.setAttribute('font-size', '9.5'); name.setAttribute('font-weight', '600');
        name.textContent = dep.nombre;
        g.appendChild(bg); g.appendChild(icon); g.appendChild(name);
      }
    }

    // Click: fijar departamento y detener auto-rotación
    g.addEventListener('click', () => {
      userSelected = true;
      stopCountdown();
      removePulse();
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
      selectDep(dep.id);
    });
    g.addEventListener('mouseenter', () => {
      if (activeId !== dep.id) { g.style.opacity = '0.78'; bg.setAttribute('stroke-width', '2'); }
    });
    g.addEventListener('mouseleave', () => {
      if (activeId !== dep.id) { g.style.opacity = '0.75'; bg.setAttribute('stroke-width', '1.5'); }
    });

    nodesGroup.appendChild(g);
  });

  // --- Anillo de cuenta atrás (círculo central) ---
  function startCountdown() {
    const ring = document.getElementById('cc-ring');
    if (!ring) return;
    ring.style.animation = 'none';
    ring.style.opacity = '0';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      ring.style.animation = 'ccCountdown 10s linear forwards';
    }));
  }
  function stopCountdown() {
    const ring = document.getElementById('cc-ring');
    if (!ring) return;
    ring.style.animation = 'none';
    ring.style.opacity = '0';
  }

  // --- Pulso expansivo alrededor del nodo activo (auto-modo) ---
  let pulseCircle = null;
  function addNodePulse(dep) {
    removePulse();
    const bg = document.getElementById(`bg-${dep.id}`);
    if (!bg) return;
    const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('cx', bg.getAttribute('cx'));
    c.setAttribute('cy', bg.getAttribute('cy'));
    c.setAttribute('r', '50');
    c.setAttribute('fill', 'none');
    c.setAttribute('stroke', dep.color);
    c.setAttribute('stroke-width', '2.5');
    c.setAttribute('pointer-events', 'none');
    c.style.animation = 'ccNodePulse 1.8s ease-out infinite';
    const ng = document.getElementById('nodes');
    ng.insertBefore(c, ng.firstChild);
    pulseCircle = c;
  }
  function removePulse() {
    if (pulseCircle && pulseCircle.parentNode) {
      pulseCircle.parentNode.removeChild(pulseCircle);
      pulseCircle = null;
    }
  }

  function setLineAnim(line, isAuto) {
    // Limpiar inline opacity + usar double rAF para reinicio fiable
    line.style.animation = 'none';
    line.style.opacity = '';
    requestAnimationFrame(() => requestAnimationFrame(() => {
      line.style.strokeDasharray = '7 5';
      if (isAuto) {
        line.style.animation = 'ccDash .8s linear infinite, ccAutoSeq 10s linear forwards';
      } else {
        line.style.animation = 'ccDash .8s linear infinite, ccLightUp .6s ease-out forwards';
      }
    }));
  }

  function selectDep(id) {
    activeId = id;
    document.querySelectorAll('[data-department]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.department === id)));
    const dep = departamentos.find(d => d.id === id);
    if (!dep) return;

    departamentos.forEach(d => {
      const g   = document.getElementById(`node-${d.id}`);
      const bg  = document.getElementById(`bg-${d.id}`);
      const line = document.getElementById(`line-${d.id}`);
      const on  = d.id === id;

      if (g) {
        g.classList.toggle('cc-active', on);
        g.style.opacity = on ? '1' : '0.75';
        g.style.filter  = on ? `drop-shadow(0 0 12px ${dep.color})` : 'none';
      }
      if (bg) {
        bg.setAttribute('fill', on ? dep.color + '40' : '#1a1d27');
        bg.setAttribute('stroke-width', on ? '3.5' : '1.5');
        bg.setAttribute('opacity', '1');
      }
      if (line) {
        line.setAttribute('stroke-width', on ? '3' : '1.5');
        if (on) {
          setLineAnim(line, !userSelected);
        } else {
          line.style.animation = '';
          line.style.strokeDasharray = '';
          line.style.opacity = '0.12';
        }
      }
    });

    panelDefault.style.display = 'none';
    panelActive.style.display = 'block';
    panelActive.style.border = `1px solid ${dep.color}40`;
    panelHeader.style.background = `${dep.color}18`;
    panelHeader.style.borderBottom = `1px solid ${dep.color}30`;
    panelIcon.textContent = dep.icon;
    panelTitle.textContent = dep.nombre;
    panelTitle.style.color = dep.color;
    panelResumen.textContent = dep.resumen;

    const panelObjetivos = document.getElementById('panel-objetivos');
    if (panelObjetivos) {
      panelObjetivos.innerHTML = dep.objetivos.map(o => `
        <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;background:${dep.color}12;border:1px solid ${dep.color}28;border-radius:8px;">
          <span style="font-size:15px;flex-shrink:0;">${o.icono}</span>
          <span style="font-size:0.82rem;font-weight:600;color:#e2e8f0;line-height:1.4;">${o.texto}</span>
        </div>`).join('');
    }

    panelTools.innerHTML = '';
    dep.casos.forEach((h, index) => {
      const item = document.createElement('div');
      item.style.cssText = `background: rgba(255,255,255,0.04); border-radius: 8px; padding: 10px 12px; border-left: 3px solid ${dep.color};`;
      item.innerHTML = `
        <div style="font-size: 0.85rem; font-weight: 600; color: #e2e8f0; margin-bottom: 2px;">${h.nombre}</div>
        <div style="font-size: 0.78rem; color: #a4b2c8;">${h.uso}</div>
      `;
      if (index < 3) {
        panelTools.appendChild(item);
      } else {
        let more = panelTools.querySelector('details');
        if (!more) {
          more = document.createElement('details');
          more.className = 'ci-more-cases';
          const summary = document.createElement('summary');
          summary.textContent = 'Ver más casos';
          more.appendChild(summary);
          panelTools.appendChild(more);
        }
        more.appendChild(item);
      }
    });

    // Efectos de auto-rotación: anillo + pulso en nodo activo
    if (!userSelected) {
      addNodePulse(dep);
      startCountdown();
    } else {
      removePulse();
    }
  }

  document.querySelectorAll('[data-department]').forEach(button => {
    button.addEventListener('click', () => {
      userSelected = true; stopCountdown(); removePulse();
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
      selectDep(button.dataset.department);
    });
  });
  // Inicio + auto-rotación cada 10 s
  let ccStarted = false;
  function ccInit() {
    if (ccStarted) return; ccStarted = true;
    selectDep('sistemas');

    userSelected = true;
    stopCountdown();
    removePulse();
  }
  document.addEventListener('DOMContentLoaded', ccInit);
  if (document.readyState === 'complete' || document.readyState === 'interactive') { ccInit(); }
</script>

<style is:global>
  #nodes g { transition: transform .35s cubic-bezier(0.34,1.56,0.64,1), opacity .25s ease, filter .25s ease; transform-box: fill-box; transform-origin: center; }
  #nodes g.cc-active { transform: scale(1.24); }
  #lines line { transition: stroke-width .3s ease; }

  @keyframes ccDash { to { stroke-dashoffset: -22; } }

  /* Flash instantáneo al seleccionar en auto-modo, se atenúa los últimos 2s */
  @keyframes ccAutoSeq {
    0%   { opacity: 0;    }
    3%   { opacity: 1;    }
    12%  { opacity: 0.85; }
    78%  { opacity: 0.8;  }
    94%  { opacity: 0.15; }
    100% { opacity: 0;    }
  }

  /* Flash de encendido para departamento fijado por clic — permanece brillante */
  @keyframes ccLightUp {
    0%   { opacity: 0; }
    20%  { opacity: 1; }
    100% { opacity: 1; }
  }

  /* Anillo de cuenta atrás: azul → morado → rojo en 10s */
  @keyframes ccCountdown {
    0%   { stroke-dashoffset: 0;   stroke: #4f7cff; opacity: 0.9; }
    60%  { stroke: #a78bfa; }
    88%  { stroke: #f97316; }
    100% { stroke-dashoffset: 452; stroke: #ef4444; opacity: 0.5; }
  }

  /* Pulso expansivo en nodo activo (auto-modo) */
  @keyframes ccNodePulse {
    0%   { r: 50;  opacity: 0.85; }
    100% { r: 96;  opacity: 0;    }
  }

  @media (prefers-reduced-motion: reduce) {
    #nodes g { transition: none; }
    #lines line { animation: none !important; }
    #cc-ring { animation: none !important; opacity: 0 !important; }
  }
</style>
