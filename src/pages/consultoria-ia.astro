        </div>

        <!-- 3 Service Cards -->
        <div style="background: linear-gradient(135deg, #0f1628 0%, #1a1040 100%); padding: 2rem;">
          <p style="text-align:center; color:#64748b; font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:1.5rem;">Haz clic para abrir la demo interactiva</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

            <!-- Card 1: Atención Llamadas -->
            <button onclick="openDemo('/servicios/atencion-llamadas', '📞 Atención de Llamadas IA')"
              style="background: rgba(37,99,235,0.1); border: 1px solid rgba(37,99,235,0.25); border-radius: 1rem; padding: 1.5rem; cursor: pointer; transition: all .25s ease; width: 100%; text-align: left;"
              onmouseover="this.style.background='rgba(37,99,235,0.18)';this.style.borderColor='rgba(96,165,250,0.5)';this.style.transform='translateY(-4px)'"
              onmouseout="this.style.background='rgba(37,99,235,0.1)';this.style.borderColor='rgba(37,99,235,0.25)';this.style.transform=''">
              <div style="font-size:2rem; margin-bottom:0.75rem;">📞</div>
              <div style="font-size:1rem; font-weight:700; color:#e2e8f0; margin-bottom:0.4rem;">Atención Llamadas IA</div>
              <div style="font-size:0.82rem; color:#94a3b8; line-height:1.5; margin-bottom:1rem;">Recepcionista virtual con voz natural. Atiende, filtra y deriva llamadas las 24 horas.</div>
              <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 12px; background:rgba(37,99,235,0.15); border-radius:0.5rem; margin-bottom:1rem;">
                <span style="color:#93c5fd; font-size:0.75rem; font-weight:600;">~85% llamadas resueltas</span>
                <span style="color:#60a5fa; font-size:1.1rem; font-weight:700;">24/7</span>
              </div>
              <div style="display:flex; align-items:center; justify-content:center; gap:6px; padding:8px 0; color:#60a5fa; font-size:0.85rem; font-weight:600;">
                Ver demo interactiva
                <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
              </div>
            </button>

            <!-- Card 2: Chatbot -->
            <button onclick="openDemo('/servicios/chatbot', '🤖 Chatbot Inteligente')"
              style="background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); border-radius: 1rem; padding: 1.5rem; cursor: pointer; transition: all .25s ease; width: 100%; text-align: left;"
              onmouseover="this.style.background='rgba(99,102,241,0.18)';this.style.borderColor='rgba(165,180,252,0.5)';this.style.transform='translateY(-4px)'"
              onmouseout="this.style.background='rgba(99,102,241,0.1)';this.style.borderColor='rgba(99,102,241,0.25)';this.style.transform=''">
              <div style="font-size:2rem; margin-bottom:0.75rem;">🤖</div>
              <div style="font-size:1rem; font-weight:700; color:#e2e8f0; margin-bottom:0.4rem;">Chatbot Empresarial</div>
              <div style="font-size:0.82rem; color:#94a3b8; line-height:1.5; margin-bottom:1rem;">Chat inteligente con acceso a tu base de conocimiento. Responde en segundos, siempre disponible.</div>
              <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 12px; background:rgba(99,102,241,0.15); border-radius:0.5rem; margin-bottom:1rem;">
                <span style="color:#c7d2fe; font-size:0.75rem; font-weight:600;">~70% tickets resueltos</span>
                <span style="color:#a5b4fc; font-size:1.1rem; font-weight:700;">-60%</span>
              </div>
              <div style="display:flex; align-items:center; justify-content:center; gap:6px; padding:8px 0; color:#a5b4fc; font-size:0.85rem; font-weight:600;">
                Ver demo interactiva
                <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
              </div>
            </button>

            <!-- Card 3: Gestor Documental -->
            <button onclick="openDemo('/servicios/gestor-documental', '📄 Gestor Documental IA')"
              style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.25); border-radius: 1rem; padding: 1.5rem; cursor: pointer; transition: all .25s ease; width: 100%; text-align: left;"
              onmouseover="this.style.background='rgba(16,185,129,0.18)';this.style.borderColor='rgba(52,211,153,0.5)';this.style.transform='translateY(-4px)'"
              onmouseout="this.style.background='rgba(16,185,129,0.1)';this.style.borderColor='rgba(16,185,129,0.25)';this.style.transform=''">
              <div style="font-size:2rem; margin-bottom:0.75rem;">📄</div>
              <div style="font-size:1rem; font-weight:700; color:#e2e8f0; margin-bottom:0.4rem;">Gestor Documental IA</div>
              <div style="font-size:0.82rem; color:#94a3b8; line-height:1.5; margin-bottom:1rem;">Búsqueda semántica en todos tus documentos. Encuentra en segundos lo que antes tardabas minutos.</div>
              <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 12px; background:rgba(16,185,129,0.15); border-radius:0.5rem; margin-bottom:1rem;">
                <span style="color:#6ee7b7; font-size:0.75rem; font-weight:600;">Búsqueda &lt;30 segundos</span>
                <span style="color:#34d399; font-size:1.1rem; font-weight:700;">10x</span>
              </div>
              <div style="display:flex; align-items:center; justify-content:center; gap:6px; padding:8px 0; color:#34d399; font-size:0.85rem; font-weight:600;">
                Ver demo interactiva
                <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
              </div>
            </button>

          </div>
        </div>

        <!-- Note -->
        <div style="padding: 14px 24px; background: rgba(0,0,0,0.3); border-top: 1px solid rgba(255,255,255,0.06); text-align:center;">
          <p style="color:#475569;font-size:0.8rem;margin:0;">Demos interactivas reales. Sin registro. Experimenta cómo funcionaría en tu empresa.</p>
        </div>
      </div>

      <!-- Stats + CTAs -->
      <div class="text-center">
        <div class="flex flex-wrap justify-center gap-6 mb-8">
          <div class="text-center">
            <div class="text-3xl font-bold" style="color: #60a5fa;">8</div>
            <div class="text-xs mt-1" style="color: #64748b;">Departamentos cubiertos</div>
          </div>
          <div class="w-px h-10 self-center" style="background: rgba(255,255,255,0.1);"></div>
          <div class="text-center">
            <div class="text-3xl font-bold" style="color: #a78bfa;">~80%</div>
            <div class="text-xs mt-1" style="color: #64748b;">Tareas repetitivas automatizadas</div>
          </div>
          <div class="w-px h-10 self-center" style="background: rgba(255,255,255,0.1);"></div>
          <div class="text-center">
            <div class="text-3xl font-bold" style="color: #60a5fa;">2-3m</div>
            <div class="text-xs mt-1" style="color: #64748b;">Para ver el ROI</div>
          </div>
          <div class="w-px h-10 self-center" style="background: rgba(255,255,255,0.1);"></div>
