---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Consultoría de IA para Empresas por Departamentos | AI Security";
const description = "Consultoría IA para PYMES en España: analizamos tu empresa por departamentos e implementamos las mejores herramientas. Primera consulta gratuita. ROI en 2-3 meses.";
const canonical = "https://aisecurity.es/consultoria-ia";

const departamentos = [
  {
    id: "comunicacion",
    nombre: "Comunicación",
    icon: "🎨",
    color: "#38bdf8",
    resumen: "Genera contenido visual, vídeos y creatividades con IA generativa",
    descripcion: "Transforma la producción de contenido visual de tu equipo. Crear imágenes profesionales, vídeos de producto o creatividades para redes sociales pasa de horas a minutos.",
    objetivos: [
      { icono: "⏱️", texto: "Reduce un 70% el tiempo de producción de contenido visual" },
      { icono: "📈", texto: "Multiplica por 10 el volumen de publicaciones sin ampliar el equipo" },
    ],
    herramientas: [
      { nombre: "Midjourney", uso: "Imágenes y creatividades profesionales por prompt" },
      { nombre: "HeyGen", uso: "Avatares de vídeo con voz natural en español" },
      { nombre: "Canva AI", uso: "Diseño asistido, fondo automático, redimensionado inteligente" },
    ],
    ahorro: "Reduce hasta un 70% el tiempo de producción de contenido visual"
  },
  {
    id: "comercial",
    nombre: "Comercial & SEO",
    icon: "📊",
    color: "#4f7cff",
    resumen: "Analítica automática, SEO con IA y seguimiento de oportunidades",
    descripcion: "Scripts que recogen datos de Google Search Console y Analytics cada semana, generan informes y detectan oportunidades de negocio sin intervención manual.",
    objetivos: [
      { icono: "📬", texto: "Informes semanales automáticos enviados a tu email sin trabajo manual" },
      { icono: "🎯", texto: "Detecta keywords y oportunidades de captación antes que la competencia" },
    ],
    herramientas: [
      { nombre: "Claude + Excel/Word", uso: "Genera propuestas comerciales, analiza datos de ventas y resume reuniones por chat" },
      { nombre: "GSC + GA4 Automation", uso: "Scripts propios que analizan tu web semanalmente con IA" },
      { nombre: "n8n + LLM", uso: "Flujos automáticos de seguimiento de leads y CRM" },
    ],
    ahorro: "Informes semanales automáticos sin dedicar horas a exportar datos"
  },
  {
    id: "callcenter",
    nombre: "Call Center & Soporte",
    icon: "📞",
    color: "#60a5fa",
    resumen: "Atención telefónica y chat con IA que nunca descansa",
    descripcion: "Recepcionistas virtuales y chatbots que gestionan el 80% de las consultas habituales. Voz natural en español, integración con CRM y derivación a agente humano cuando es necesario.",
    objetivos: [
      { icono: "🤖", texto: "Resuelve el 80% de consultas habituales sin intervención humana" },
      { icono: "🕐", texto: "Disponible 24/7 sin coste adicional de personal" },
    ],
    herramientas: [
      { nombre: "Atención Llamadas IA", uso: "Recepcionista virtual 24/7 con voz natural en español" },
      { nombre: "Chatbot Empresarial IA", uso: "Chat con acceso a tu base de datos y ERP en tiempo real" },
      { nombre: "ElevenLabs", uso: "Voces IA ultra-realistas en español para agentes telefónicos" },
    ],
    ahorro: "Atiende el 80% de consultas comunes sin coste de personal adicional"
  },
  {
    id: "proyectos",
    nombre: "Gestión de Proyectos",
    icon: "📋",
    color: "#6366f1",
    resumen: "IA integrada en tu herramienta de proyectos para acelerar entregas",
    descripcion: "Conectamos tu gestor de proyectos con IA para generar tareas automáticamente, resumir el estado del sprint y detectar bloqueos sin reuniones extra.",
    objetivos: [
      { icono: "⚡", texto: "Reduce un 50% el tiempo de planificación y reporting de sprints" },
      { icono: "🔍", texto: "Detecta bloqueos y riesgos antes de que impacten en el plazo" },
    ],
    herramientas: [
      { nombre: "Jira + Atlassian Intelligence", uso: "Creación automática de subtareas, resumen de issues" },
      { nombre: "Notion AI", uso: "Documentación de proyectos y wikis que se actualizan solas" },
      { nombre: "n8n", uso: "Automatiza notificaciones, asignaciones y reportes entre herramientas" },
    ],
    ahorro: "Reduce el tiempo de planificación y reporting hasta un 50%"
  },
  {
    id: "administracion",
    nombre: "Administración",
    icon: "🧾",
    color: "#818cf8",
    resumen: "Facturas, presupuestos y contabilidad gestionados de forma automática",
    descripcion: "Automatizamos la captura de facturas de proveedores, la generación de presupuestos y el seguimiento de pagos. El equipo deja de hacer trabajo repetitivo.",
    objetivos: [
      { icono: "🧾", texto: "Procesa facturas en segundos en vez de 5-10 minutos por documento" },
      { icono: "✅", texto: "Elimina errores de introducción manual de datos contables" },
    ],
    herramientas: [
      { nombre: "Claude + Excel/Word", uso: "Redacta presupuestos, analiza hojas de cálculo y resume contratos por chat" },
      { nombre: "Mindee", uso: "OCR inteligente que extrae datos de facturas y recibos automáticamente" },
      { nombre: "n8n + ChatGPT", uso: "Flujos que clasifican, registran y notifican facturas entrantes" },
    ],
    ahorro: "Procesa facturas en segundos en vez de 5-10 minutos por documento"
  },
  {
    id: "desarrollo",
    nombre: "Desarrollo",
    icon: "💻",
    color: "#8b5cf6",
    resumen: "Acelera tu equipo de desarrollo con IA en cada paso del ciclo",
    descripcion: "Desde la generación de código hasta la documentación automática y los pipelines de CI/CD. Todos los devs trabajando al mismo ritmo con IA.",
    objetivos: [
      { icono: "🚀", texto: "Multiplica por 2-3x la velocidad de entrega de features" },
      { icono: "🛡️", texto: "Reduce un 60% los bugs que llegan a producción" },
    ],
    herramientas: [
      { nombre: "Claude Code", uso: "Agente de desarrollo que lee tu repo y ejecuta tareas completas" },
      { nombre: "GitHub Copilot", uso: "Autocompletado de código en tiempo real en el IDE" },
      { nombre: "GitHub Actions + IA", uso: "Pipelines que generan tests y detectan bugs automáticamente" },
    ],
    ahorro: "Multiplica por 2-3x la velocidad de entrega de features"
  },
  {
    id: "devops",
    nombre: "DevOps",
    icon: "⚙️",
    color: "#a78bfa",
    resumen: "Infraestructura como código y automatización de despliegues con IA",
    descripcion: "La IA detecta anomalías antes de que sean incidencias y propone soluciones de escalado automáticamente. Despliegues sin downtime.",
    objetivos: [
      { icono: "📡", texto: "Resuelve incidencias hasta 3x más rápido con diagnóstico automático" },
      { icono: "🔄", texto: "Despliegues continuos sin downtime ni intervención manual" },
    ],
    herramientas: [
      { nombre: "Ansible + IA", uso: "Playbooks generados automáticamente para configuración de servidores" },
      { nombre: "Kubernetes + K8sGPT", uso: "Diagnóstico automático de errores en clústeres K8s" },
      { nombre: "Datadog AI", uso: "Monitorización con detección de anomalías y alertas inteligentes" },
    ],
    ahorro: "Despliegues sin downtime y resolución de incidencias hasta 3x más rápida"
  },
  {
    id: "sistemas",
    nombre: "Sistemas",
    icon: "🖥️",
    color: "#c084fc",
    resumen: "Administración de sistemas con documentación automática y seguridad IA",
    descripcion: "Cada cambio en un servidor queda documentado automáticamente. La seguridad se monitoriza en tiempo real con Wazuh y las automatizaciones reducen las tareas repetitivas.",
    objetivos: [
      { icono: "🛡️", texto: "Detección de amenazas en tiempo real con cumplimiento ENS automático" },
      { icono: "📝", texto: "Cada cambio en producción genera documentación automática en la wiki" },
    ],
    herramientas: [
      { nombre: "Wazuh", uso: "SIEM open-source: detección de amenazas y cumplimiento ENS" },
      { nombre: "Ansible + LLM", uso: "Automatiza tareas repetitivas de administración por lenguaje natural" },
      { nombre: "Netdata", uso: "Monitorización en tiempo real de servidores con IA predictiva" },
    ],
    ahorro: "Documenta cambios automáticamente y reduce incidencias por errores humanos"
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <!-- Schema JSON-LD — Service + FAQPage para GEO -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Consultoría de Inteligencia Artificial para Empresas",
    "alternateName": "Consultoría IA empresas España",
    "description": "Servicio de análisis, implementación y formación de herramientas de IA adaptadas a cada departamento de la empresa. Cubre administración, comercial, atención al cliente, comunicación, gestión de proyectos, desarrollo y sistemas.",
    "provider": {
      "@type": "Organization",
      "name": "AI Security",
      "url": "https://aisecurity.es",
      "areaServed": "ES"
    },
    "serviceType": "Consultoría de Inteligencia Artificial para empresas",
    "areaServed": "España",
    "availableChannel": {
      "@type": "ServiceChannel",
      "serviceUrl": "https://aisecurity.es/consultoria-ia",
      "availableLanguage": ["Spanish", "Catalan", "English"]
    },
    "offers": {
      "@type": "Offer",
      "description": "Primera consulta gratuita. Propuesta personalizada sin compromiso. Implementaciones desde 1.500€ por departamento.",
      "availability": "https://schema.org/InStock"
    }
  }
  </script>
  <script slot="head" type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué es la consultoría de IA para empresas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La consultoría de IA para empresas es un servicio de análisis, implementación y formación de herramientas de inteligencia artificial adaptadas a los procesos específicos de tu empresa. Incluye diagnóstico por departamento, propuesta personalizada, puesta en marcha y formación del equipo."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto cuesta implementar IA en una empresa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El coste depende del alcance. Ofrecemos una primera consulta gratuita y propuesta personalizada. Las implementaciones concretas parten desde 1.500€ para un único departamento (ej: chatbot de atención al cliente o automatización de procesos documentales) hasta soluciones multiárea de mayor envergadura."
        }
      },
      {
        "@type": "Question",
        "name": "¿Necesito equipo técnico propio para implementar IA en mi empresa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. AI Security se encarga de toda la parte técnica: configuración, integración con tus herramientas actuales (ERP, CRM, email, Google Workspace) y puesta en marcha. La formación del equipo está incluida para que puedas usarlo de forma autónoma desde el primer día."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué herramientas de IA podéis implementar en mi empresa?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Implementamos herramientas como Claude y ChatGPT para tareas de texto y análisis, n8n para automatización de flujos, chatbots empresariales con acceso a tu base de datos, gestores documentales con búsqueda semántica, recepcionistas virtuales con voz IA, y automatización de procesos repetitivos (RPA con IA)."
        }
      },
      {
        "@type": "Question",
        "name": "¿En cuánto tiempo se ve el retorno de la inversión en IA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "En la mayoría de implementaciones el ROI empieza a ser visible en los primeros 2-3 meses. Por ejemplo, un chatbot de atención al cliente que resuelve el 80% de consultas supone un ahorro medio de 10-15 horas semanales de personal. Un gestor documental IA reduce el tiempo de búsqueda de 10-15 minutos a menos de 30 segundos por consulta."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué departamentos de una empresa pueden beneficiarse de la IA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Prácticamente todos: Administración (facturas, presupuestos con Claude+Excel), Comercial (propuestas, análisis de ventas), Atención al cliente (chatbot 24/7), Comunicación (contenido visual con IA generativa), Gestión de proyectos (Notion AI, Jira Intelligence), Desarrollo (Claude Code, GitHub Copilot) y Sistemas (Wazuh, Ansible+IA)."
        }
      }
    ]
  }
  </script>

  <!-- HERO + DEMOS -->
  <section style="background: linear-gradient(135deg, #0a0d1a 0%, #0f1628 50%, #0a0d1a 100%); padding: 80px 0 60px; position: relative; overflow: hidden;">
    <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 30%, #4f7cff 0%, transparent 50%), radial-gradient(circle at 80% 70%, #a78bfa 0%, transparent 50%);"></div>

    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <!-- Badge + Título -->
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium mb-6" style="background: rgba(79,124,255,0.15); border: 1px solid rgba(79,124,255,0.3); color: #7da4ff;">
          <span>🤖</span> Consultoría de Inteligencia Artificial
        </div>
        <h1 class="text-5xl md:text-6xl font-bold mb-6 leading-tight" style="color: #fff;">
          IA aplicada a tu empresa,<br/>
          <span style="background: linear-gradient(90deg, #4f7cff, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">departamento a departamento</span>
        </h1>
        <p class="text-xl max-w-3xl mx-auto" style="color: #94a3b8; line-height: 1.7;">
          Analizamos cómo trabajáis e implementamos las herramientas de IA con mejor retorno. Formación incluida. ROI visible en 2-3 meses.
        </p>
      </div>

      <!-- Demo Container -->
      <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 1.5rem; overflow: hidden; margin-bottom: 2.5rem;">
        <!-- Terminal bar -->
        <div style="background: rgba(0,0,0,0.4); padding: 14px 24px; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="display: flex; gap: 6px;">
              <div style="width:12px;height:12px;border-radius:50%;background:#ef4444;"></div>
              <div style="width:12px;height:12px;border-radius:50%;background:#eab308;"></div>
              <div style="width:12px;height:12px;border-radius:50%;background:#22c55e;"></div>
            </div>
            <span style="color: #64748b; font-size: 0.875rem; font-family: monospace;">Demos interactivas — servicios IA para empresas</span>
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: #22c55e;">
            <span style="width:8px;height:8px;background:#22c55e;border-radius:50%;display:inline-block;" class="animate-pulse"></span>
            Demo en vivo
