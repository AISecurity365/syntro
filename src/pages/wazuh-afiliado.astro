    .calc-range::-moz-range-thumb { width:22px; height:22px; border-radius:50%; background:#60a5fa; cursor:pointer; border:3px solid #0b1220; box-shadow:0 0 0 1px rgba(96,165,250,0.6); }
  </style>

  <script is:inline>
    (function () {
      const clientesEl = document.getElementById('calc-clientes');
      const precioEl = document.getElementById('calc-precio');
      const clientesVal = document.getElementById('calc-clientes-val');
      const precioVal = document.getElementById('calc-precio-val');
      const implEl = document.getElementById('calc-impl');
      const recuEl = document.getElementById('calc-recu');
      const totalEl = document.getElementById('calc-total');
      const y5El = document.getElementById('calc-y5');
      if (!clientesEl || !precioEl) return;

      const COMISION_IMPL = 0.20;      // 20% de la implementación
      const GESTIONADO_MES = 200;      // €/mes servicio gestionado
      const COMISION_RECU = 0.10;      // 10% del gestionado
      const RECU_ANUAL_CLIENTE = GESTIONADO_MES * COMISION_RECU * 12; // 240 €/año por cliente

      const fmt = (n) => Math.round(n).toLocaleString('es-ES') + ' €';

      function update() {
        const clientes = parseInt(clientesEl.value, 10);
        const precio = parseInt(precioEl.value, 10);

        const impl = clientes * precio * COMISION_IMPL;
        const recu = clientes * RECU_ANUAL_CLIENTE;
        const total = impl + recu;
        const y5 = clientes * 5 * RECU_ANUAL_CLIENTE; // recurrente acumulado si sostienes el ritmo 5 años

        clientesVal.textContent = clientes;
        precioVal.textContent = fmt(precio);
        implEl.textContent = fmt(impl);
        recuEl.textContent = fmt(recu) + '/año';
        totalEl.textContent = fmt(total);
        y5El.textContent = fmt(y5) + '/año';
      }

      clientesEl.addEventListener('input', update);
      precioEl.addEventListener('input', update);
      update();
    })();
  </script>

