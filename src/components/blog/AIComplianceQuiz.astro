<section id="ai-check" class="ai-check" aria-label="Autodiagnóstico de uso de IA">
  <div class="quiz-top"><span>Tu uso de IA, paso a paso</span><span id="quiz-progress">1 / 5</span></div>
  <progress id="quiz-bar" max="5" value="1" aria-label="Progreso"></progress>
  <form id="ai-check-form">
    <div id="quiz-screen"></div>
    <p id="quiz-error" role="alert"></p>
    <div class="quiz-nav"><button type="button" id="quiz-back">Anterior</button><button type="submit" id="quiz-next">Continuar →</button></div>
  </form>
  <p class="quiz-foot">Selecciona varias IA y usos. Revisamos cada herramienta por separado. Sin registro. Las respuestas se procesan en esta página; no se envían con el formulario ni se guardan al recargar.</p>
  <noscript>Activa JavaScript para usar el cuestionario. Debajo tienes los criterios y fuentes para revisar tu caso sin el test.</noscript>
</section>
<script>
  import {providers, uses, dataTypes, controlsFor, assess, conclusion, reviewed} from '../../lib/ai-compliance.mjs';
  const root=document.getElementById('ai-check')!;
  const form=root.querySelector('form')!;
  const screen=root.querySelector('#quiz-screen')!;
  const next=root.querySelector('#quiz-next') as HTMLButtonElement;
  const back=root.querySelector('#quiz-back') as HTMLButtonElement;
  const error=root.querySelector('#quiz-error')!;
  let step=0;
  let selected:string[]=[];
  let entries:Record<string,any>={};
  const cases=()=>selected.flatMap(id=>entries[id].uses.map((use:string)=>({...entries[id],use})));
  const toolControls=(id:string)=>Array.from(new Map(entries[id].uses.flatMap((use:string)=>controlsFor({...entries[id],use})).map((c:any)=>[c.id,c])).values()) as Array<{id:string,label:string,area:string}>;
  const esc=(s:string)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
  function options(name:string, list:Array<[string,string]>, selected:string|string[], multiple=false) {
    return list.map(([value,label])=>`<label class="quiz-option"><input type="${multiple?'checkbox':'radio'}" name="${name}" value="${esc(value)}" ${(Array.isArray(selected)?selected.includes(value):String(selected)===value)?'checked':''} ${multiple?'':'required'}><span>${esc(label)}</span></label>`).join('');
  }
  function render(focus=false) {
    error.textContent='';
    (root.querySelector('progress') as HTMLProgressElement).value=Math.min(step+1,5);
    root.querySelector('#quiz-progress')!.textContent=step===5?'Tu orientación':`${step+1} / 5`;
    back.hidden=step===0;
    next.hidden=step===5;
    next.textContent=step===4?'Ver mi orientación →':'Continuar →';
    let title='',body='';
    if(step===0){title='¿Qué IA utiliza tu empresa?';body='<p class="quiz-hint">Puedes seleccionar varias opciones.</p>'+options('providers',Object.entries(providers).map(([id,p])=>[id,p.name]),selected,true);}
    if(step===1){title='¿Qué plan tenéis en cada herramienta?';body=selected.map(id=>{const p=providers[id];return `<fieldset class="quiz-tool"><legend>${esc(p.name)}</legend>${options('plan-'+id,p.plans.map((p:any,i:number)=>[String(i),p.label]),entries[id].plan)}<p class="quiz-hint">${esc(p.note)} <a href="${p.url}" target="_blank" rel="noopener noreferrer">Condiciones oficiales ↗</a></p></fieldset>`;}).join('');}
    if(step===2){title='¿Para qué utilizáis cada IA?';body='<p class="quiz-hint">Marca uno o varios usos por herramienta.</p>'+selected.map(id=>`<fieldset class="quiz-tool"><legend>${esc(providers[id].name)}</legend>${options('uses-'+id,Object.entries(uses),entries[id].uses,true)}</fieldset>`).join('');}
    if(step===3){title='¿Qué datos trata cada herramienta?';body='<p class="quiz-hint">Incluye prompts, adjuntos, correo y conectores. Para cada IA, elige el tipo más sensible entre todos sus usos seleccionados.</p>'+selected.map(id=>`<fieldset class="quiz-tool"><legend>${esc(providers[id].name)}</legend>${options('data-'+id,Object.entries(dataTypes),entries[id].data)}</fieldset>`).join('');}
    if(step===4){title='¿Qué habéis comprobado de verdad?';body='<p class="quiz-hint">Marca solo medidas verificadas para todos los usos seleccionados de esa herramienta. Lo que no sepas quedará pendiente.</p>'+selected.map(id=>`<fieldset class="quiz-tool"><legend>${esc(providers[id].name)}</legend>${toolControls(id).map(c=>`<label class="quiz-option"><input type="checkbox" name="controls-${id}" value="${c.id}" ${entries[id].controls.includes(c.id)?'checked':''}><span><small>${c.area}</small>${esc(c.label)}</span></label>`).join('')}</fieldset>`).join('');}
    if(step===5){
      title='Tu resultado y próximos pasos';
      body='<p class="quiz-hint">Lee el resultado de cada herramienta y uso. Empieza por los casos que necesitan revisión especializada.</p>'+cases().map(answers=>{
        const r=assess(answers), c=conclusion(answers);
        return `<section class="quiz-tool"><h3>${esc(r.provider.name)} · ${esc(r.plan.label)}</h3><p class="quiz-hint">${esc(uses[answers.use])}</p>
          <div class="quiz-conclusion"><strong>${esc(c.title)}</strong><p>${esc(c.explanation)}</p></div>
          <h4>${c.actions.length?'Empieza por aquí':'Tu siguiente paso'}</h4>
          ${c.actions.length?'<ol>'+c.actions.slice(0,3).map(p=>`<li>${esc(p)}</li>`).join('')+'</ol>':'<p>Reúne las evidencias de las medidas que has marcado y comprueba que cubren este uso concreto.</p>'}
          <details><summary>Ver revisión completa${c.actions.length>3?' · '+(c.actions.length-3)+' acciones más':''}</summary>
            ${c.actions.length>3?'<h4>Después, continúa con estas medidas</h4><ul>'+c.actions.slice(3).map(p=>`<li>${esc(p)}</li>`).join('')+'</ul>':''}
            <div class="quiz-results"><div><h4>AI Act</h4><strong>${esc(r.aiStatus)}</strong></div><div><h4>RGPD</h4><strong>${esc(r.gdprStatus)}</strong><p>${esc(r.gdprNote)}</p></div></div>
            <p class="quiz-hint">${esc(r.provider.note)} <a href="${r.provider.url}" target="_blank" rel="noopener noreferrer">Fuente del proveedor ↗</a></p>
          </details></section>`;
      }).join('')+`<p class="quiz-hint">Orientación basada en tus respuestas, no una auditoría ni un certificado. Fuentes revisadas: ${reviewed}.</p><div class="quiz-nav"><button type="button" id="quiz-download">Descargar mi lista de acciones</button><button type="button" id="quiz-reset">Evaluar otro uso</button></div><p><a href="/presupuesto?plan=Revision-IA-Act-RGPD">Quiero ayuda para resolver estos puntos →</a></p>`;
    }
    screen.innerHTML=`<fieldset><legend tabindex="-1">${title}</legend><div class="quiz-options">${body}</div></fieldset>`;
    if(focus)(screen.querySelector('legend') as HTMLElement).focus({preventScroll:true});
    root.querySelector('#quiz-reset')?.addEventListener('click',()=>{selected=[];entries={};step=0;render(true);});
    root.querySelector('#quiz-download')?.addEventListener('click',()=>{const text=cases().map(answers=>{const result=assess(answers), c=conclusion(answers);return ['ORIENTACIÓN DE USO DE IA — NO CERTIFICA CUMPLIMIENTO',`Revisión de fuentes: ${reviewed}`,result.provider.name,result.plan.label,uses[answers.use],dataTypes[answers.data],c.title,c.explanation,...c.actions,`AI Act: ${result.aiStatus}`,`RGPD: ${result.gdprStatus}`,result.gdprNote,result.provider.url].join('\n\n');}).join('\n\n──────────\n\n');const url=URL.createObjectURL(new Blob([text],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='revision-uso-ia.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
  }
  function save(){
    const fd=new FormData(form);
    if(step===0){
      const ids=fd.getAll('providers') as string[];
      if(!ids.length)return false;
      selected=ids;
      entries=Object.fromEntries(ids.map(id=>[id,entries[id]||{provider:id,plan:'',uses:[],data:'',controls:[]}]));
    } else if(step<4){
      const field=['','plan','uses','data'][step];
      const values=selected.map(id=>field==='uses'?fd.getAll(field+'-'+id):fd.get(field+'-'+id));
      if(values.some(v=>Array.isArray(v)?!v.length:!v))return false;
      selected.forEach((id,i)=>{if(JSON.stringify(entries[id][field])!==JSON.stringify(values[i]))entries[id].controls=[];entries[id][field]=values[i];});
    } else if(step===4) selected.forEach(id=>entries[id].controls=fd.getAll('controls-'+id));
    return true;
  }
  form.addEventListener('submit',e=>{e.preventDefault();if(!save()){error.textContent='Selecciona al menos una opción para cada herramienta antes de continuar.';return;}step++;render(true);});
  back.addEventListener('click',()=>{if(step<5)save();step=Math.max(0,step-1);render(true);});
  render();
</script>
<style is:global>
  #ai-check{padding:clamp(1rem,3vw,2rem);margin:2rem 0;border:1px solid #414267;border-radius:18px;background:linear-gradient(145deg,#131c30,#17162b);color:#e2e8f0;min-width:0}
  #ai-check .quiz-top{display:flex;justify-content:space-between;gap:1rem;font-size:.85rem;color:#c4b5fd}
  #ai-check progress{width:100%;height:5px;accent-color:#a78bfa;margin:1rem 0 1.75rem}
  #ai-check fieldset{border:0;padding:0;margin:0;min-width:0}
  #ai-check legend{font-size:clamp(1.3rem,3vw,1.8rem);line-height:1.3;font-weight:700;color:white;margin-bottom:1rem}
  #ai-check .quiz-tool{display:grid;gap:.7rem;margin:1rem 0;padding:1rem 0;border-bottom:1px solid #454761}
  #ai-check .quiz-tool legend{font-size:1.15rem;color:#c4b5fd}
  #ai-check .quiz-options{display:grid;gap:.7rem}
  #ai-check .quiz-option{display:flex;align-items:flex-start;gap:.8rem;padding:1rem;border:1px solid #454761;border-radius:10px;background:#171f32;cursor:pointer;font-size:.95rem;line-height:1.5}
  #ai-check .quiz-option:has(input:checked){border-color:#b7a3ff;background:#30284b}
  #ai-check input{margin-top:.3rem;accent-color:#a78bfa;flex-shrink:0}
  #ai-check small{display:block;color:#c4b5fd;margin-bottom:.25rem}
  #ai-check p{color:#d0d5e4;margin:.5rem 0;line-height:1.65}
  #ai-check .quiz-hint,#ai-check .quiz-foot{font-size:.85rem;color:#bcc5d6}
  #ai-check .quiz-foot{margin-top:1.5rem}
  #ai-check .quiz-nav{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.2rem}
  #ai-check button{padding:.8rem 1.2rem;background:#373057;border:1px solid #9380c2;color:white;border-radius:8px;font-size:.95rem;cursor:pointer}
  #ai-check #quiz-next{background:#5140a0;margin-left:auto}
  #ai-check [hidden]{display:none!important}
  #ai-check :focus-visible{outline:3px solid #c4b5fd;outline-offset:4px}
  #ai-check .quiz-conclusion{padding:1.2rem;background:#282440;border-left:3px solid #a78bfa;border-radius:8px}
  #ai-check .quiz-conclusion>strong{font-size:1.25rem;color:white}
  #ai-check summary{cursor:pointer;color:#c4b5fd;padding:1rem 0}
  #ai-check .quiz-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  #ai-check .quiz-results>div{padding:1rem;border:1px solid #686084;border-radius:10px}
  #ai-check h4{margin:.6rem 0;color:#c4b5fd}
  #ai-check li{font-size:.95rem;line-height:1.65}
  #ai-check a{color:#c4b5fd;text-decoration:underline}
  @media(max-width:600px){#ai-check .quiz-results{grid-template-columns:1fr}}
</style>
