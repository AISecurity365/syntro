---
const demos = [
  {title: "Atención de llamadas", tag: "VOZ + ATENCIÓN", url: "/servicios/atencion-llamadas", icon: "M5 4h4l2 5-3 2a14 14 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2C9 21 3 15 3 6a2 2 0 0 1 2-2Z", text: "Recepcionista virtual con voz natural. Atiende, filtra y deriva llamadas las 24 horas.", note: "Una conversación, muchas posibilidades."},
  {title: "Chatbot empresarial", tag: "CONVERSACIÓN + CONOCIMIENTO", url: "/servicios/chatbot", icon: "M21 11a8 8 0 0 1-8 8H5l-3 3V5a2 2 0 0 1 2-2h9a8 8 0 0 1 8 8ZM7 8h9M7 12h6", text: "Chat inteligente con acceso a tu base de conocimiento. Respuestas en segundos, siempre disponible.", note: "La información de tu empresa, accesible."},
  {title: "Gestor documental", tag: "DOCUMENTOS + BÚSQUEDA", url: "/servicios/gestor-documental", icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h5", text: "Búsqueda semántica en tus documentos. Encuentra la información que necesitas sin recorrer carpetas.", note: "De buscar archivos a encontrar respuestas."}
];
---
<section class="ci-hero">
  <div class="ci-shell">
    <div class="ci-hero-grid">
      <div class="ci-intro">
        <p class="ci-eyebrow"><span></span> Consultoría de inteligencia artificial</p>
        <h1>IA aplicada<br/>a tu empresa.<br/><span>Departamento<br/>a departamento.</span></h1>
        <p class="ci-lead">Analizamos cómo trabajáis e implementamos las herramientas de IA con mejor retorno. Formación incluida.</p>
        <div class="ci-actions">
          <a class="ci-primary" href="/presupuesto?plan=Consultoria-IA">Solicitar consulta gratuita <span aria-hidden="true">↗</span></a>
          <a class="ci-text-link" href="#departamentos">Explorar departamentos <span aria-hidden="true">↓</span></a>
        </div>
        <p class="ci-note">Primera consulta gratuita · Propuesta personalizada</p>
      </div>
      <div class="ci-blueprint" aria-label="Proceso de consultoría: analizar, implementar y formar">
        <div class="ci-board-top"><span>DE LOS PROCESOS A LA PRÁCTICA</span><span aria-hidden="true">↗</span></div>
        <div class="ci-board-center">
          <div class="ci-orbit" aria-hidden="true"><span>IA</span></div>
          <div><small>EL PUNTO DE PARTIDA</small><h2>Tu empresa.<br/>Tu forma de trabajar.</h2></div>
        </div>
        <ol class="ci-process">
          <li><span>01</span><div><strong>Analizamos</strong><p>Procesos, necesidades y oportunidades.</p></div><span aria-hidden="true">↗</span></li>
          <li><span>02</span><div><strong>Implementamos</strong><p>Herramientas conectadas a tu día a día.</p></div><span aria-hidden="true">↗</span></li>
          <li><span>03</span><div><strong>Formamos</strong><p>Tu equipo aprende a utilizarlas.</p></div><span aria-hidden="true">↗</span></li>
        </ol>
        <div class="ci-board-bottom"><span>Personas + procesos + tecnología</span><span class="ci-status">Conectados</span></div>
      </div>
    </div>
    <div class="ci-summary">
      <div><strong>08</strong><span>Departamentos<br/>donde aplicar IA</span></div>
      <div><strong>03</strong><span>Demos interactivas<br/>para experimentar</span></div>
      <div><strong>A medida</strong><span>Integración con<br/>tus herramientas</span></div>
      <a href="/consultoria-it">¿Buscas consultoría IT? <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<section class="ci-demos" id="demos">
  <div class="ci-shell">
    <div class="ci-section-head">
      <div><p class="ci-eyebrow">01 / Pruébalo</p><h2>Menos imaginar.<br/>Más experimentar.</h2></div>
      <p>Tres ejemplos de IA aplicada al trabajo diario.<br/>Abre una demo y explora cómo funciona, sin registro.</p>
    </div>
    <div class="ci-demo-grid">
      {demos.map((demo, i) => (
        <button type="button" class="ci-demo-card" data-demo-url={demo.url} data-demo-title={demo.title}>
          <span class="ci-card-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d={demo.icon} stroke-linecap="round" stroke-linejoin="round"/></svg><span>0{i+1}</span></span>
          <span class="ci-card-tag">{demo.tag}</span>
          <span class="ci-card-title">{demo.title}</span><span class="ci-card-description">{demo.text}</span>
          <span class="ci-card-note">{demo.note}</span>
          <span class="ci-card-action">Abrir demo interactiva <span aria-hidden="true">↗</span></span>
        </button>
      ))}
    </div>
  </div>
</section>
