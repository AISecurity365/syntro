<section class="workflow" data-workflow data-phase="0" data-playing="false" data-apps="false" aria-labelledby="workflow-title">
  <div class="workflow-head"><div><p class="eyebrow">DE LOS PROCESOS A LA PRÁCTICA</p><h2 id="workflow-title">Tu empresa aporta la base.<br/><span>El agente la convierte en trabajo hecho.</span></h2></div><button class="control" type="button" data-play>Pausar recorrido</button></div>
  <div class="step-tabs" role="group" aria-label="Pasos del recorrido">
    <button type="button" data-step="0" aria-pressed="true"><small>PASO 1</small>Documentar la empresa</button>
    <button type="button" data-step="1" aria-pressed="false"><small>PASO 2</small>Preparar al agente</button>
    <button type="button" data-step="2" aria-pressed="false"><small>PASO 3</small>Realizar la tarea</button>
  </div>
  <div class="map" aria-label="El equipo documenta contexto y sistemas; el agente aprende a utilizarlos con su ayuda.">
    <div class="foundation-frame"><span>PASO 1 · LA BASE DE TU EMPRESA</span></div>
    <svg class="wires" viewBox="0 0 1000 380" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path data-edge="document" d="M160 190H185Q200 190 200 170V100Q200 80 220 80H250"/>
      <path data-edge="systems" d="M160 190H185Q200 190 200 210V280Q200 300 220 300H250"/>
      <path data-edge="learn" d="M440 80H480Q500 80 500 110V160Q500 190 530 190H570"/>
      <path data-edge="tools" d="M440 300H480Q500 300 500 270V220Q500 190 530 190H570"/>
      <path data-edge="team" d="M85 140V35Q85 15 115 15H635Q665 15 665 45V140"/>
      <path data-edge="ask" d="M570 190H530Q500 190 500 160V110Q500 80 480 80H440"/>
      <path data-edge="use" d="M570 190H530Q500 190 500 220V270Q500 300 480 300H440"/>
      <path data-edge="incoming" d="M910 245V335Q910 360 885 360H475Q455 360 455 340V320Q455 300 440 300"/>
      <path data-edge="delivery" d="M440 300Q455 300 455 320V340Q455 360 475 360H885Q910 360 910 335V245"/>
      <path class="flow-particle" data-flow pathLength="100" d="M210 190H240Q260 190 260 170V100Q260 80 285 80H330"/>
    </svg>
    <svg class="wires mobile-wires" viewBox="0 0 1000 650" preserveAspectRatio="none" fill="none" aria-hidden="true"><path data-edge="document" d="M500 125V145Q500 165 480 165H235Q215 165 215 185V190"/><path data-edge="systems" d="M500 125V145Q500 165 520 165H765Q785 165 785 185V190"/><path data-edge="learn" d="M215 280V310Q215 330 245 330H470Q500 330 500 350V355"/><path data-edge="tools" d="M785 280V310Q785 330 755 330H530Q500 330 500 350V355"/><path data-edge="team" d="M750 75H940Q960 75 960 95V380Q960 400 940 400H825"/><path data-edge="ask" d="M500 355V350Q500 330 470 330H245Q215 330 215 310V280"/><path data-edge="use" d="M500 355V350Q500 330 530 330H755Q785 330 785 310V280"/><path data-edge="incoming" d="M800 535H920Q950 535 950 505V310Q950 280 920 280H785"/><path data-edge="delivery" d="M785 280H920Q950 280 950 310V505Q950 535 920 535H800"/><path class="flow-particle" data-flow pathLength="100" d="M500 125V145Q500 165 480 165H235Q215 165 215 185V190"/></svg>
    <div class="node company" data-node="company"><span class="symbol" aria-hidden="true">◎</span><strong>Tu empresa y tu equipo</strong><p>Documentan cómo trabajáis.</p></div>
    <div class="node context" data-node="context"><span class="symbol" aria-hidden="true">▤</span><strong>Contexto</strong><p>Conocimiento y reglas de la empresa.</p><div class="documents"><span>▤ PDF</span><span>▧ Guías</span><span>▤ Procesos</span></div></div>
    <div class="node systems" data-node="systems"><span class="symbol" aria-hidden="true">⌘</span><strong>Sistemas que usáis</strong><p data-systems-note>Herramientas y accesos necesarios.</p>
      <div class="apps">
        <span class="app" data-app="erp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0"/></svg>ERP</span>
        <span class="app" data-app="gmail"><svg viewBox="0 0 32 24" aria-hidden="true"><path fill="#4285f4" d="M0 4h5v20H0z"/><path fill="#34a853" d="M27 4h5v20h-5z"/><path fill="#ea4335" d="M0 0h5l11 9L27 0h5v7L16 19 0 7z"/><path fill="#fbbc04" d="m27 0 5 4v3l-5 4z"/></svg>Gmail</span>
      </div>
    </div>
    <div class="client-zone" aria-hidden="true"><span>FUERA DE TU EMPRESA</span></div>
    <div class="node client" data-node="client"><span class="symbol" aria-hidden="true">♙</span><small>CLIENTE</small><strong>Lucía Martín</strong><p data-client-state>Envía una consulta y recibe su respuesta.</p><span class="client-received" hidden data-client-received>✓ Correo + PDF recibidos<br/><strong>≈ 10 min ahorrados</strong><small>Al equipo · Estimación de este ejemplo</small></span></div>
    <span class="transfer-marker" data-transfer-marker aria-hidden="true">✉</span>
    <div class="transfer" data-transfer>
      <div class="gmail-heading"><svg viewBox="0 0 32 24" aria-hidden="true"><path fill="#4285f4" d="M0 4h5v20H0z"/><path fill="#34a853" d="M27 4h5v20h-5z"/><path fill="#ea4335" d="M0 0h5l11 9L27 0h5v7L16 19 0 7z"/><path fill="#fbbc04" d="m27 0 5 4v3l-5 4z"/></svg><span>Gmail</span><small data-mail-label>Correo</small></div>
      <div class="gmail-person"><span class="gmail-avatar" aria-hidden="true">L</span><span data-mail-person>Lucía Martín</span></div>
      <span class="transfer-route" data-transfer-route></span>
      <strong data-transfer-title></strong>
      <p data-transfer-body></p>
      <span class="transfer-file" data-transfer-file hidden>▤ Factura_F-2026-0842.pdf · 30,00 €</span>
      <small data-transfer-status>En camino →</small>
    </div>
    <div class="node agent" data-node="agent"><span class="symbol" aria-hidden="true">✦</span><strong>Agente IA</strong><p>Lee el contexto, usa las herramientas y mejora con tu equipo.</p></div>
  </div>
  <div class="narration" aria-live="off"><span data-count>01 / 08</span><div><strong data-action>Tu equipo documenta el contexto.</strong><p data-explanation>Cómo trabajáis, qué necesita cada cliente y qué criterios seguís.</p></div><button type="button" class="control" data-next>Siguiente →</button></div>
  <div class="case-row"><p data-mode>Ejemplo completo · La factura de Lucía · Datos ficticios.</p></div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-workflow]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    // One directed connection per scene, including the external client.
    const scenes = [
      {step:0, edge:'document', from:'company', to:'context', title:'Tu equipo documenta el contexto.', text:'Cómo trabajáis, qué necesita cada cliente y qué criterios seguís.', app:''},
      {step:0, edge:'systems', from:'company', to:'systems', title:'Tu equipo documenta los sistemas y da acceso.', text:'Qué herramientas utilizáis y qué información o acciones necesita el agente.', app:''},
      {step:1, edge:'learn', from:'context', to:'agent', title:'El agente aprende a trabajar con vuestro contexto.', text:'Le damos instrucciones basadas en el conocimiento y las reglas de la empresa.', app:''},
      {step:1, edge:'tools', from:'systems', to:'agent', title:'El agente aprende a usar las herramientas necesarias.', text:'Configuramos cómo consultar y actuar, con los permisos justos para su tarea.', app:''},
      {step:1, edge:'team', from:'company', to:'agent', title:'El equipo prueba, corrige y mejora al agente.', text:'Ajustamos sus instrucciones con vuestro feedback y decidimos cuándo debe pedir ayuda.', app:''},
      {step:2, edge:'ask', from:'agent', to:'context', title:'Llega una tarea: el agente consulta el contexto.', text:'Entiende qué necesita el cliente y qué reglas debe seguir antes de actuar.', app:''},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente busca la información en el ERP.', text:'Consulta los datos que necesita para resolver la petición.', app:'erp'},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente utiliza Gmail para responder.', text:'Con aprobación humana o automáticamente, según las reglas acordadas. Tarea completada.', app:'gmail'},
    ];
    const invoice = [
      {step:2, edge:'incoming', from:'client', to:'systems', title:'Lucía envía su consulta por correo.', text:'Su petición llega a Gmail con su DNI para buscar su ficha de cliente.', app:'gmail'},
      {step:2, edge:'tools', from:'systems', to:'agent', title:'Gmail entrega la petición al agente.', text:'Lucía Martín pide la factura de su compra de 30 €. El agente lee el correo.', app:'gmail'},
      {step:2, edge:'ask', from:'agent', to:'context', title:'El agente consulta las reglas de facturación.', text:'Pregunta qué datos debe contrastar y cuándo necesita la aprobación del equipo.', app:''},
      {step:2, edge:'learn', from:'context', to:'agent', title:'El contexto aporta los criterios para identificar a Lucía.', text:'El agente recibe las reglas de facturación y comprueba la identidad del cliente antes de consultar sus datos.', app:''},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente pasa el DNI al ERP para validar al cliente.', text:'DNI: 48271639K. El ERP contrasta la ficha y la compra de 30 €. El DNI por sí solo no autoriza el envío.', app:'erp'},
      {step:2, edge:'tools', from:'systems', to:'agent', title:'El ERP devuelve la validación del cliente.', text:'Coinciden la ficha de Lucía, el correo registrado y la compra. La simulación permite recuperar su factura.', app:'erp'},
      {step:2, edge:'tools', from:'systems', to:'agent', title:'El ERP devuelve los datos y el PDF al agente.', text:'Factura F-2026-0842 · Lucía Martín · Total: 30,00 €. El agente recibe el documento que debe adjuntar.', app:'erp'},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente redacta el correo en Gmail.', text:'Prepara una respuesta personalizada y adjunta el PDF de la factura. Todavía no se ha enviado.', app:'gmail'},
      {step:2, edge:'team', from:'company', to:'agent', title:'El equipo aprueba el correo y el adjunto.', text:'En esta simulación, una persona revisa destinatario, importe y documento, y autoriza el envío.', app:''},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente envía el correo con la factura.', text:'Gmail envía a Lucía la respuesta aprobada con Factura_F-2026-0842.pdf adjunta.', app:'gmail'},
      {step:2, edge:'delivery', from:'systems', to:'client', title:'Gmail entrega el correo redactado a Lucía.', text:'La respuesta y el PDF viajan hasta el cliente. Al llegar, la petición queda resuelta.', app:'gmail'},
    ];
    const payloads = [
      {kind:'mail', title:'✉ Consulta de Lucía', body:'«¿Me enviáis mi factura de 30 €? Mi DNI es 48271639K».'},
      {kind:'mail', title:'✉ ¿Me enviáis mi factura?', body:'Lucía Martín: «Necesito la factura de mi compra de 30 €. Gracias.»'},
      {kind:'query', title:'⌕ Consultar el contexto', body:'¿Cómo valido al cliente y qué reglas sigo para enviar su factura?'},
      {kind:'note', title:'▤ Reglas de la empresa', body:'Verificar al cliente. Consultar su compra. Pedir aprobación antes de enviar.'},
      {kind:'query', title:'⌕ Validar cliente en ERP', body:'DNI: 48271639K. Contrastar ficha, correo registrado y compra de 30 €.'},
      {kind:'note', title:'✓ Cliente validado', body:'Ficha de Lucía localizada. Correo y compra coinciden. Factura vinculada: F-2026-0842.'},
      {kind:'pdf', title:'PDF · F-2026-0842', body:'Lucía Martín · Empresa Ejemplo. Total: 30,00 €. Documento recuperado.'},
      {kind:'mail', title:'✎ Borrador para Lucía', body:'Hola, Lucía: te adjunto la factura F-2026-0842 de tu compra de 30 €. Un saludo, el equipo de atención al cliente.'},
      {kind:'approval', title:'✓ Envío aprobado', body:'El equipo ha revisado el destinatario, el importe y el PDF. Ya puedes enviarlo.'},
      {kind:'mail', title:'✉ Enviar a Lucía Martín', body:'Hola, Lucía: aquí tienes tu factura de 30 €. Si necesitas algo más, estamos a tu disposición.'},
      {kind:'mail', title:'✉ Tu factura F-2026-0842', body:'Hola, Lucía:\n\nTe adjunto tu factura de 30 €. Si necesitas algo más, estamos a tu disposición.\n\nUn saludo, tu equipo de atención.'},
    ];
    const map = root.querySelector<HTMLElement>('.map')!;
    const transfer = root.querySelector<HTMLElement>('[data-transfer]')!;
    const duration = 3200;
    let elapsed = 0, lastTime = 0, frame = 0, manualTravel = false;
    function positionTransfer() {
      const svg = [...root!.querySelectorAll<SVGSVGElement>('.wires')].find(el => el.getBoundingClientRect().width > 0)!;
      const path = svg.querySelector<SVGPathElement>('[data-flow]')!;
      const progress = Math.min(elapsed / duration, 1);
      const point = path.getPointAtLength(path.getTotalLength() * progress);
      const box = svg.viewBox.baseVal;
      const x = point.x / box.width * map.clientWidth;
      const y = point.y / box.height * map.clientHeight;
      const w = transfer.offsetWidth, h = transfer.offsetHeight;
      const left = Math.max(0, Math.min(map.clientWidth - w, x - w / 2));
      const top = Math.max(0, Math.min(map.clientHeight - h, y - h - 85));
      transfer.style.left = left + 'px';
      transfer.style.top = top + 'px';
      // The marker stays exactly on the SVG path, even when its readable card reaches a map edge.
      const marker = root!.querySelector<HTMLElement>('[data-transfer-marker]')!;
      marker.style.left = x + 'px';
      marker.style.top = y + 'px';
      marker.hidden = progress === 1;
      transfer.style.setProperty('--tether-x', (x - left) + 'px');
      transfer.style.setProperty('--tether-length', Math.max(0, y - top - h) + 'px');
      transfer.dataset.arrived = String(progress === 1);
      root!.querySelector<HTMLElement>('[data-client-received]')!.hidden = !(example && index === invoice.length - 1 && progress === 1);
      transfer.querySelector('[data-transfer-status]')!.textContent = progress === 1 ? (example && index === invoice.length - 1 ? '✓ RESUELTO · ≈ 10 min ahorrados al equipo (estimación)' : '✓ Recibido') : 'En camino →';
    }
    function animate(now: number) {
      if (lastTime && elapsed < duration && visible && !document.hidden && (!paused || manualTravel)) {
        elapsed = Math.min(duration, elapsed + now - lastTime);
        positionTransfer();
      }
      lastTime = now;
      frame = requestAnimationFrame(animate);
    }
    let index = 0, example = true, paused = motion.matches, visible = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function render(manual = false) {
      const list = example ? invoice : scenes;
      const scene = list[index];
      root!.dataset.phase = String(scene.step);
      root!.dataset.resolved = String(example && index === invoice.length - 1);
      root!.querySelector<HTMLElement>('[data-client-state]')!.textContent = example ? 'Consulta: mi factura de 30 €.' : 'Envía una consulta y recibe su respuesta.';
      root!.querySelector<HTMLElement>('[data-client-received]')!.hidden = true;
      steps.forEach((button, i) => button.setAttribute('aria-pressed', String(i === scene.step)));
      root!.querySelectorAll<HTMLElement>('[data-node]').forEach(node => { node.dataset.active = String(node.dataset.node === scene.to); node.dataset.source = String(node.dataset.node === scene.from); });
      root!.querySelectorAll<HTMLElement>('[data-app]').forEach(app => { app.dataset.active = String(app.dataset.app === scene.app); });
      root!.querySelectorAll('.wires').forEach(svg => svg.querySelector('[data-flow]')!.setAttribute('d', svg.querySelector(`[data-edge="${scene.edge}"]`)!.getAttribute('d')!));
      root!.querySelector('.narration')!.setAttribute('aria-live', manual ? 'polite' : 'off');
      root!.querySelector('[data-count]')!.textContent = `${String(index + 1).padStart(2, '0')} / ${String(list.length).padStart(2, '0')}`;
      root!.querySelector('[data-action]')!.textContent = scene.title;
      root!.querySelector('[data-explanation]')!.textContent = scene.text;
      root!.querySelector('[data-next]')!.textContent = index === list.length - 1 ? 'Volver al inicio ↺' : 'Siguiente →';
      root!.querySelector('[data-mode]')!.textContent = example ? 'Simulación con datos ficticios · Avanza para ver cada acción.' : 'Un mismo agente, con tu contexto y tus herramientas.';
      const payload = example ? payloads[index] : {title:scene.title, body:scene.text, kind:'note'};
      const names: Record<string,string> = {company:'Tu equipo', context:'Contexto', systems:scene.app === 'erp' ? 'ERP' : scene.app === 'gmail' ? 'Gmail' : 'Sistemas', agent:'Agente IA', client:'Lucía Martín'};
      transfer.dataset.kind = payload.kind;
      const incomingMail = example && index <= 1;
      transfer.querySelector('[data-mail-person]')!.textContent = incomingMail ? 'De: Lucía Martín · Para: tu empresa' : 'De: tu empresa · Para: Lucía Martín';
      transfer.querySelector('[data-mail-label]')!.textContent = incomingMail ? 'Recibidos' : index >= 9 ? 'Enviados' : 'Borrador';
      transfer.querySelector('.gmail-avatar')!.textContent = incomingMail ? 'L' : 'AI';
      root!.querySelector<HTMLElement>('[data-transfer-marker]')!.textContent = payload.kind === 'pdf' ? 'PDF' : payload.kind === 'mail' ? '✉' : '▤';
      transfer.querySelector('[data-transfer-route]')!.textContent = names[scene.from] + ' → ' + names[scene.to];
      transfer.querySelector('[data-transfer-title]')!.textContent = payload.title;
      transfer.querySelector('[data-transfer-body]')!.textContent = payload.body;
      transfer.querySelector<HTMLElement>('[data-transfer-file]')!.hidden = !(example && [6,7,9,10].includes(index));
      elapsed = motion.matches ? duration : 0;
      manualTravel = manual;
      lastTime = 0;
      positionTransfer();
    }

    function schedule() {
      clearTimeout(timer);
      const running = !paused && visible && !document.hidden;
      root!.dataset.playing = String(running);
      play.textContent = paused ? 'Reproducir recorrido' : 'Pausar recorrido';
      if (running) timer = setTimeout(() => {
        const count = (example ? invoice : scenes).length;
        if (index === count - 1) paused = true;
        else { index++; render(); }
        schedule();
      }, 7000);
    }
    root.querySelector('[data-next]')!.addEventListener('click', () => { index = (index + 1) % (example ? invoice : scenes).length; paused = true; render(true); schedule(); });
    steps.forEach((button, i) => button.addEventListener('click', () => { example = i === 2; index = [0,2,0][i]; paused = true; render(true); schedule(); }));
    play.addEventListener('click', () => { if (paused && index === (example ? invoice : scenes).length - 1) { index = 0; render(); } paused = !paused; manualTravel = false; schedule(); });
    const onMotion = () => { paused = motion.matches; if (motion.matches) elapsed = duration; schedule(); };
    motion.addEventListener('change', onMotion);
    document.addEventListener('visibilitychange', schedule);
    const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; schedule(); });
    const resize = new ResizeObserver(positionTransfer); resize.observe(map);
    observer.observe(root); render(); schedule(); frame = requestAnimationFrame(animate);
    document.addEventListener('astro:before-swap', () => { clearTimeout(timer); cancelAnimationFrame(frame); observer.disconnect(); resize.disconnect(); motion.removeEventListener('change', onMotion); document.removeEventListener('visibilitychange', schedule); }, {once:true});
  }
</script>
<style>
  .workflow { padding:32px; border:1px solid #3e5271; border-radius:24px; background:radial-gradient(ellipse at 60% 0,#21314c,transparent 70%),#101a2b; }
  .workflow-head { display:flex; justify-content:space-between; align-items:start; gap:24px; }
  .workflow .eyebrow { color:#a9c9f2; font:10px/1.6 monospace; letter-spacing:.12em; margin:0 0 12px; }
  .workflow h2 { margin:0; color:#f0f6ff; font-size:clamp(25px,3vw,36px); line-height:1.2; letter-spacing:-.03em; }
  h2 span { color:#a9c9f2; }
  .control { padding:10px 14px; border:1px solid #657b9a; border-radius:20px; background:#16253a; color:#dceaff; font-size:12px; white-space:nowrap; cursor:pointer; }
  button:focus-visible { outline:2px solid #b3ddff; outline-offset:4px; }
  .step-tabs { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin:28px 0 22px; }
  .step-tabs button { padding:13px 15px; text-align:left; border:1px solid #405875; border-radius:9px; background:#132238; color:#c5d7ef; font-size:14px; cursor:pointer; }
  .step-tabs small { display:block; font:10px monospace; margin-bottom:6px; color:#a5cfff; }
  .step-tabs [aria-pressed="true"] { border-color:#a5dfff; background:#244361; color:#fff; }
  .map { position:relative; height:520px; margin:0 0 20px; }
  .foundation-frame { position:absolute; left:0; top:0; width:47%; height:100%; border:1px dashed #546e8d; border-radius:16px; }
  .foundation-frame>span { position:absolute; bottom:10px; left:16px; font:9px monospace; letter-spacing:.07em; color:#a5bddb; }
  [data-phase="0"] .foundation-frame { border-color:#8db9e8; background:#88baff05; }
  .wires { position:absolute; inset:0; width:100%; height:100%; }
  .mobile-wires { display:none; }
  .wires path { stroke:#47607d; stroke-width:1.3; }
  .wires [data-edge="ask"],.wires [data-edge="use"] { stroke:none; }
  .wires [data-edge="incoming"] { stroke-dasharray:4 5; } .wires [data-edge="delivery"] { stroke:none; }
  .wires [data-edge="team"] { stroke-dasharray:3 6; stroke:#536885; }
  .wires .flow-particle { stroke:#bbebff; stroke-width:2; stroke-linecap:round; opacity:.7; }
  .node { position:absolute; width:19%; min-height:112px; padding:16px; transform:translateY(-50%); border:1px solid #5b7392; border-radius:12px; background:#14243a; transition:background .4s,border-color .4s,box-shadow .4s; }
  .company { left:1%; top:50%; width:15%; --node-bg:#21365a; --node-accent:#9bbfff; }
  .context { left:25%; top:21.05%; --node-bg:#153b3e; --node-accent:#74ded5; }
  .systems { left:25%; top:78.95%; --node-bg:#173547; --node-accent:#83ccec; }
  .agent { left:57%; top:50%; width:19%; --node-bg:#362650; --node-accent:#cfadff; }
  .client { left:83%; top:50%; width:17%; --node-bg:#352d41; --node-accent:#e8bddc; }
  .node { background:var(--node-bg); border-color:var(--node-accent); border-top-width:3px; }
  .node .symbol { color:var(--node-accent); }
  .client small { display:block; color:#e8bddc; font:9px monospace; margin-bottom:8px; }
  .client-zone { position:absolute; inset:0 0 0 80%; border-left:1px dashed #8c7899; }
  .client-zone>span { position:absolute; bottom:10px; left:10px; color:#d4bddb; font:8px/1.5 monospace; }
  .documents { display:flex; flex-wrap:wrap; gap:5px; margin-top:10px; }
  .documents span { padding:4px 5px; border:1px solid #63a7a4; border-radius:4px; color:#c9fff3; font:9px monospace; }
  .client-received { display:block; margin-top:12px; font-size:11px; line-height:1.5; color:#a7f4cf; }
  .client-received strong { margin-top:10px; color:#a7f4cf; font-size:17px; }
  .client .client-received small { color:#b9dacc; font:10px/1.5 sans-serif; margin:5px 0 0; }
