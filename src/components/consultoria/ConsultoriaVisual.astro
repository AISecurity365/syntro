<section class="workflow" data-workflow data-phase="0" data-playing="false" data-apps="false" aria-labelledby="workflow-title">
  <div class="workflow-head"><div><p class="eyebrow">DE LOS PROCESOS A LA PRÁCTICA</p><h2 id="workflow-title">Tu empresa aporta la base.<br/><span>El agente la convierte en trabajo hecho.</span></h2></div><button class="control" type="button" data-play>Pausar recorrido</button></div>
  <div class="step-tabs" role="group" aria-label="Pasos del recorrido">
    <button type="button" data-step="0" aria-pressed="true"><small>PASO 1</small>Documentar la empresa</button>
    <button type="button" data-step="1" aria-pressed="false"><small>PASO 2</small>Preparar al agente</button>
    <button type="button" data-step="2" aria-pressed="false"><small>PASO 3</small>Realizar la tarea</button>
  </div>
  <div class="map" aria-label="El equipo documenta contexto y sistemas; el agente aprende a utilizarlos con su ayuda.">
    <div class="foundation-frame"><span>PASO 1 · LA BASE DE TU EMPRESA</span></div>
    <svg class="wires" viewBox="0 0 1000 380" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path data-edge="document" d="M210 190H240Q260 190 260 170V100Q260 80 285 80H330"/>
      <path data-edge="systems" d="M210 190H240Q260 190 260 210V280Q260 300 285 300H330"/>
      <path data-edge="learn" d="M530 80H590Q620 80 620 110V160Q620 190 650 190H730"/>
      <path data-edge="tools" d="M530 300H590Q620 300 620 270V220Q620 190 650 190H730"/>
      <path data-edge="team" d="M110 140V35Q110 15 140 15H800Q830 15 830 45V140"/>
      <path data-edge="ask" d="M730 190H650Q620 190 620 160V110Q620 80 590 80H530"/>
      <path data-edge="use" d="M730 190H650Q620 190 620 220V270Q620 300 590 300H530"/>
      <path class="flow-particle" data-flow pathLength="100" d="M210 190H240Q260 190 260 170V100Q260 80 285 80H330"/>
    </svg>
    <svg class="wires mobile-wires" viewBox="0 0 1000 500" preserveAspectRatio="none" fill="none" aria-hidden="true"><path data-edge="document" d="M500 125V145Q500 165 480 165H235Q215 165 215 185V190"/><path data-edge="systems" d="M500 125V145Q500 165 520 165H765Q785 165 785 185V190"/><path data-edge="learn" d="M215 280V310Q215 330 245 330H470Q500 330 500 350V355"/><path data-edge="tools" d="M785 280V310Q785 330 755 330H530Q500 330 500 350V355"/><path data-edge="team" d="M750 75H940Q960 75 960 95V380Q960 400 940 400H825"/><path data-edge="ask" d="M500 355V350Q500 330 470 330H245Q215 330 215 310V280"/><path data-edge="use" d="M500 355V350Q500 330 530 330H755Q785 330 785 310V280"/><path class="flow-particle" data-flow pathLength="100" d="M500 125V145Q500 165 480 165H235Q215 165 215 185V190"/></svg>
    <div class="node company" data-node="company"><span class="symbol" aria-hidden="true">◎</span><strong>Tu empresa y tu equipo</strong><p>Documentan cómo trabajáis.</p></div>
    <div class="node context" data-node="context"><span class="symbol" aria-hidden="true">▤</span><strong>Contexto</strong><p>Conocimiento y reglas de la empresa.</p></div>
    <div class="node systems" data-node="systems"><span class="symbol" aria-hidden="true">⌘</span><strong>Sistemas que usáis</strong><p data-systems-note>Herramientas y accesos necesarios.</p>
      <div class="apps" hidden>
        <span class="app" data-app="erp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0"/></svg>ERP</span>
        <span class="app" data-app="gmail"><svg viewBox="0 0 32 24" aria-hidden="true"><path fill="#4285f4" d="M0 4h5v20H0z"/><path fill="#34a853" d="M27 4h5v20h-5z"/><path fill="#ea4335" d="M0 0h5l11 9L27 0h5v7L16 19 0 7z"/><path fill="#fbbc04" d="m27 0 5 4v3l-5 4z"/></svg>Gmail</span>
      </div>
    </div>
    <div class="node agent" data-node="agent"><span class="symbol" aria-hidden="true">✦</span><strong>Agente IA</strong><p>Lee el contexto, usa las herramientas y mejora con tu equipo.</p></div>
  </div>
  <div class="narration" aria-live="off"><span data-count>01 / 08</span><div><strong data-action>Tu equipo documenta el contexto.</strong><p data-explanation>Cómo trabajáis, qué necesita cada cliente y qué criterios seguís.</p></div><button type="button" class="control" data-next>Siguiente →</button></div>
  <div class="invoice-preview" data-invoice-preview hidden>
    <div class="mail-preview">
      <div class="mail-heading"><span data-mail-status>GMAIL · RECIBIDO</span><span data-resolution hidden>✓ RESUELTO</span></div>
      <p class="mail-address" data-mail-address>De: Lucía Martín · Empresa Ejemplo</p>
      <strong data-mail-subject>Asunto: ¿Me enviáis mi factura de 30 €?</strong>
      <p class="mail-body" data-mail-body>Hola, soy Lucía Martín. Necesito la factura de mi compra de 30 €. ¿Me la podéis enviar por aquí? Gracias.</p>
      <div class="mail-attachment" data-mail-attachment hidden><span aria-hidden="true">▤</span><div><strong>Factura_F-2026-0842.pdf</strong><small>Adjunto · 30,00 €</small></div><span data-attachment-status>Preparado</span></div>
    </div>
    <div class="data-preview">
      <span class="data-label" data-data-label>DATOS QUE RECIBE EL AGENTE</span>
      <p data-data-text>Petición recibida de Lucía Martín. El agente necesita identificar su factura.</p>
      <div class="pdf-preview" data-pdf-preview hidden>
        <div><span>PDF · FACTURA</span><strong>F-2026-0842</strong></div>
        <p>Cliente: Lucía Martín<br/>Empresa Ejemplo</p>
        <div class="pdf-total"><span>Total</span><strong>30,00 €</strong></div>
        <small>Documento simulado</small>
      </div>
    </div>
  </div>
  <div class="case-row"><button type="button" class="case-button" data-case aria-pressed="false">¿Cómo sería con una petición de factura? ↗</button><p data-mode>Un mismo agente, con tu contexto y tus herramientas.</p></div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-workflow]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const caseButton = root.querySelector<HTMLButtonElement>('[data-case]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    // One directed connection per scene. The same four nodes tell the whole story.
    const scenes = [
      {step:0, edge:'document', from:'company', to:'context', title:'Tu equipo documenta el contexto.', text:'Cómo trabajáis, qué necesita cada cliente y qué criterios seguís.', app:''},
      {step:0, edge:'systems', from:'company', to:'systems', title:'Tu equipo documenta los sistemas y da acceso.', text:'Qué herramientas utilizáis y qué información o acciones necesita el agente.', app:''},
      {step:1, edge:'learn', from:'context', to:'agent', title:'El agente aprende a trabajar con vuestro contexto.', text:'Le damos instrucciones basadas en el conocimiento y las reglas de la empresa.', app:''},
      {step:1, edge:'tools', from:'systems', to:'agent', title:'El agente aprende a usar las herramientas necesarias.', text:'Configuramos cómo consultar y actuar, con los permisos justos para su tarea.', app:''},
      {step:1, edge:'team', from:'company', to:'agent', title:'El equipo prueba, corrige y mejora al agente.', text:'Ajustamos sus instrucciones con vuestro feedback y decidimos cuándo debe pedir ayuda.', app:''},
      {step:2, edge:'ask', from:'agent', to:'context', title:'Llega una tarea: el agente consulta el contexto.', text:'Entiende qué necesita el cliente y qué reglas debe seguir antes de actuar.', app:''},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente busca la información en el ERP.', text:'Consulta los datos que necesita para resolver la petición.', app:'erp'},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente utiliza Gmail para responder.', text:'Con aprobación humana o automáticamente, según las reglas acordadas. Tarea completada.', app:'gmail'},
    ];
    const invoice = [
      {step:2, edge:'tools', from:'systems', to:'agent', title:'Gmail entrega la petición al agente.', text:'Lucía Martín pide la factura de su compra de 30 €. El agente lee el correo.', app:'gmail'},
      {step:2, edge:'learn', from:'context', to:'agent', title:'El contexto aporta los criterios para identificar a Lucía.', text:'El agente recibe las reglas de facturación y comprueba la identidad del cliente antes de consultar sus datos.', app:''},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente solicita la factura al ERP.', text:'Busca la compra de 30 € vinculada a Lucía Martín, de Empresa Ejemplo.', app:'erp'},
      {step:2, edge:'tools', from:'systems', to:'agent', title:'El ERP devuelve los datos y el PDF al agente.', text:'Factura F-2026-0842 · Lucía Martín · Total: 30,00 €. El agente recibe el documento que debe adjuntar.', app:'erp'},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente redacta el correo en Gmail.', text:'Prepara una respuesta personalizada y adjunta el PDF de la factura. Todavía no se ha enviado.', app:'gmail'},
      {step:2, edge:'team', from:'company', to:'agent', title:'El equipo aprueba el correo y el adjunto.', text:'En esta simulación, una persona revisa destinatario, importe y documento, y autoriza el envío.', app:''},
      {step:2, edge:'use', from:'agent', to:'systems', title:'El agente envía el correo con la factura.', text:'Gmail envía a Lucía la respuesta aprobada con Factura_F-2026-0842.pdf adjunta.', app:'gmail'},
      {step:2, edge:'tools', from:'systems', to:'agent', title:'Resuelto: Lucía recibe su factura de 30 €.', text:'Gmail confirma el envío. Lucía tiene el PDF y el agente da por atendida la petición.', app:'gmail'},
    ];
    let index = 0, example = false, paused = motion.matches, visible = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function render(manual = false) {
      const list = example ? invoice : scenes;
      const scene = list[index];
      root!.dataset.phase = String(scene.step);
      root!.dataset.resolved = String(example && index === invoice.length - 1);
      root!.dataset.apps = String(example || scene.step === 2);
      root!.querySelector<HTMLElement>('.apps')!.hidden = !(example || scene.step === 2);
      root!.querySelector<HTMLElement>('[data-systems-note]')!.hidden = example || scene.step === 2;
      steps.forEach((button, i) => button.setAttribute('aria-pressed', String(i === scene.step)));
      root!.querySelectorAll<HTMLElement>('[data-node]').forEach(node => { node.dataset.active = String(node.dataset.node === scene.to); node.dataset.source = String(node.dataset.node === scene.from); });
      root!.querySelectorAll<HTMLElement>('[data-app]').forEach(app => { app.dataset.active = String(app.dataset.app === scene.app); });
      root!.querySelectorAll('.wires').forEach(svg => svg.querySelector('[data-flow]')!.setAttribute('d', svg.querySelector(`[data-edge="${scene.edge}"]`)!.getAttribute('d')!));
      root!.querySelector('.narration')!.setAttribute('aria-live', manual ? 'polite' : 'off');
      root!.querySelector('[data-count]')!.textContent = `${String(index + 1).padStart(2, '0')} / ${String(list.length).padStart(2, '0')}`;
      root!.querySelector('[data-action]')!.textContent = scene.title;
      root!.querySelector('[data-explanation]')!.textContent = scene.text;
      root!.querySelector('[data-next]')!.textContent = index === list.length - 1 ? 'Volver al inicio ↺' : 'Siguiente →';
      caseButton.setAttribute('aria-pressed', String(example));
      caseButton.textContent = example ? 'Volver al recorrido general ↺' : '¿Cómo sería con una petición de factura? ↗';
      root!.querySelector('[data-mode]')!.textContent = example ? 'Simulación con datos ficticios · Avanza para ver cada acción.' : 'Un mismo agente, con tu contexto y tus herramientas.';
      root!.querySelector<HTMLElement>('[data-invoice-preview]')!.hidden = !example;
      if (example) {
        const reply = index >= 4, sent = index >= 6, resolved = index === 7;
        const setText = (selector: string, value: string) => { root!.querySelector(selector)!.textContent = value; };
        setText('[data-mail-status]', resolved ? 'GMAIL · RECIBIDO POR LUCÍA' : sent ? 'GMAIL · ENVIADO' : reply ? 'GMAIL · BORRADOR DEL AGENTE' : 'GMAIL · PETICIÓN DEL CLIENTE');
        setText('[data-mail-address]', reply ? 'Para: Lucía Martín · Empresa Ejemplo' : 'De: Lucía Martín · Empresa Ejemplo');
        setText('[data-mail-subject]', reply ? 'Asunto: Tu factura F-2026-0842 · 30,00 €' : 'Asunto: ¿Me enviáis mi factura de 30 €?');
        setText('[data-mail-body]', reply ? 'Hola, Lucía:\n\nTe adjunto la factura F-2026-0842 correspondiente a tu compra, por un total de 30,00 €.\n\nSi necesitas cualquier otra cosa, estamos a tu disposición.\n\nUn saludo,\nEl equipo de atención al cliente' : 'Hola, soy Lucía Martín. Necesito la factura de mi compra de 30 €. ¿Me la podéis enviar por aquí? Gracias.');
        root!.querySelector<HTMLElement>('[data-resolution]')!.hidden = !resolved;
        root!.querySelector<HTMLElement>('[data-mail-attachment]')!.hidden = !reply;
        root!.querySelector<HTMLElement>('[data-pdf-preview]')!.hidden = index < 3;
        setText('[data-attachment-status]', sent ? 'Enviado ✓' : 'Adjunto listo');
        setText('[data-data-label]', index >= 3 ? 'ERP → AGENTE · DOCUMENTO RECUPERADO' : 'DATOS QUE RECIBE EL AGENTE');
        setText('[data-data-text]', ['Petición recibida de Lucía Martín. El agente necesita identificar su factura.', 'Contexto: criterios de identificación, reglas de facturación y aprobación antes del envío.', 'Consulta al ERP: cliente verificado + compra de 30 €. Esperando el documento.', 'El ERP devuelve el número de factura, el cliente, el importe y el archivo PDF.', 'El agente usa los datos del ERP para redactar el correo y adjunta el PDF recibido.', 'Aprobación recibida del equipo. El correo está listo para enviarse.', 'Correo y PDF enviados a Lucía a través de Gmail.', '✓ Petición resuelta. Lucía ha recibido su factura de 30,00 €.'][index]);
      }
    }
    function schedule() {
      clearTimeout(timer);
      const running = !paused && visible && !document.hidden;
      root!.dataset.playing = String(running);
      play.textContent = paused ? 'Reproducir recorrido' : 'Pausar recorrido';
      if (running) timer = setTimeout(() => {
        const count = (example ? invoice : scenes).length;
        if (index === count - 1) paused = true;
        else index++;
        render(); schedule();
      }, 4500);
    }
    root.querySelector('[data-next]')!.addEventListener('click', () => { index = (index + 1) % (example ? invoice : scenes).length; paused = true; render(true); schedule(); });
    steps.forEach((button, i) => button.addEventListener('click', () => { example = false; index = [0,2,5][i]; paused = true; render(true); schedule(); }));
    play.addEventListener('click', () => { if (paused && index === (example ? invoice : scenes).length - 1) index = 0; paused = !paused; render(); schedule(); });
    caseButton.addEventListener('click', () => { example = !example; index = 0; paused = motion.matches; render(true); schedule(); });
    const onMotion = () => { paused = motion.matches; schedule(); };
    motion.addEventListener('change', onMotion);
    document.addEventListener('visibilitychange', schedule);
    const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; schedule(); });
    observer.observe(root); render(); schedule();
    document.addEventListener('astro:before-swap', () => { clearTimeout(timer); observer.disconnect(); motion.removeEventListener('change', onMotion); document.removeEventListener('visibilitychange', schedule); }, {once:true});
  }
</script>
<style>
  .workflow { padding:32px; border:1px solid #3e5271; border-radius:24px; background:radial-gradient(ellipse at 60% 0,#21314c,transparent 70%),#101a2b; }
  .workflow-head { display:flex; justify-content:space-between; align-items:start; gap:24px; }
  .workflow .eyebrow { color:#a9c9f2; font:10px/1.6 monospace; letter-spacing:.12em; margin:0 0 12px; }
  .workflow h2 { margin:0; color:#f0f6ff; font-size:clamp(25px,3vw,36px); line-height:1.2; letter-spacing:-.03em; }
  h2 span { color:#a9c9f2; }
  .control { padding:10px 14px; border:1px solid #657b9a; border-radius:20px; background:#16253a; color:#dceaff; font-size:12px; white-space:nowrap; cursor:pointer; }
  button:focus-visible { outline:2px solid #b3ddff; outline-offset:4px; }
  .step-tabs { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin:28px 0 22px; }
  .step-tabs button { padding:13px 15px; text-align:left; border:1px solid #405875; border-radius:9px; background:#132238; color:#c5d7ef; font-size:14px; cursor:pointer; }
  .step-tabs small { display:block; font:10px monospace; margin-bottom:6px; color:#a5cfff; }
  .step-tabs [aria-pressed="true"] { border-color:#a5dfff; background:#244361; color:#fff; }
  .map { position:relative; height:380px; margin:0 0 20px; }
  .foundation-frame { position:absolute; left:0; top:0; width:57%; height:100%; border:1px dashed #546e8d; border-radius:16px; }
  .foundation-frame>span { position:absolute; bottom:10px; left:16px; font:9px monospace; letter-spacing:.07em; color:#a5bddb; }
  [data-phase="0"] .foundation-frame { border-color:#8db9e8; background:#88baff05; }
  .wires { position:absolute; inset:0; width:100%; height:100%; }
  .mobile-wires { display:none; }
  .wires path { stroke:#47607d; stroke-width:1.3; }
  .wires [data-edge="ask"],.wires [data-edge="use"] { stroke:none; }
  .wires [data-edge="team"] { stroke-dasharray:3 6; stroke:#536885; }
  .wires .flow-particle { stroke:#bbebff; stroke-width:3.5; stroke-linecap:round; stroke-dasharray:9 91; animation:flow 2s linear infinite; }
  @keyframes flow { from { stroke-dashoffset:100; } to { stroke-dashoffset:0; } }
  .node { position:absolute; width:20%; min-height:112px; padding:16px; transform:translateY(-50%); border:1px solid #5b7392; border-radius:12px; background:#14243a; transition:background .4s,border-color .4s,box-shadow .4s; }
  .company { left:1%; top:50%; }
  .context { left:33%; top:21.05%; }
  .systems { left:33%; top:78.95%; }
  .agent { left:73%; top:50%; width:23%; }
  .symbol { display:block; font-size:24px; line-height:1; color:#b4d7ff; margin-bottom:10px; }
  .node strong { display:block; font-size:15px; color:#eff6ff; line-height:1.35; }
  .workflow .node p { margin:7px 0 0; color:#b6c8df; font-size:12px; line-height:1.5; }
  .node[data-source="true"] { border-color:#91c8ee; }
  .node[data-active="true"] { border-color:#b1e5ff; background:#264969; box-shadow:0 0 0 5px #a5dfff0a,0 8px 30px #0003; }
  .node[data-active="true"] .symbol { animation:pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { transform:translateY(-3px); color:#fff; } }
  [data-playing="false"] .map * { animation-play-state:paused; }
  .apps { display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; }
  .apps[hidden],[data-systems-note][hidden] { display:none; }
  .app { display:flex; align-items:center; gap:5px; padding:6px; border:1px solid #587594; border-radius:7px; font-size:10px; color:#d9ebff; background:#14243a; }
  .app svg { width:20px; height:20px; }
  .app[data-active="true"] { border-color:#a3efd4; background:#255246; color:#fff; }
  .narration { display:flex; gap:20px; align-items:center; border-top:1px solid #425978; padding:22px 0; min-height:125px; }
  [data-count] { color:#a5dfff; font:12px monospace; white-space:nowrap; }
  .narration>div { flex:1; }
  [data-action] { display:block; color:#eaf5ff; font-size:18px; line-height:1.35; }
  .workflow [data-explanation] { margin:7px 0 0; color:#b9cce4; font-size:13px; line-height:1.6; }
  .case-row { display:flex; align-items:center; justify-content:space-between; gap:22px; border-top:1px solid #344962; padding-top:20px; }
  .invoice-preview { display:grid; grid-template-columns:1.35fr 1fr; gap:20px; margin:0 0 24px; }
  .invoice-preview [hidden],.invoice-preview[hidden] { display:none; }
  .mail-preview,.data-preview { min-width:0; border:1px solid #4b6587; border-radius:12px; padding:22px; background:#14243a; }
  .mail-heading { display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; margin-bottom:18px; color:#b4d4ff; font:10px/1.6 monospace; }
  [data-resolution] { color:#a5f2ce; background:#1f4b3c; padding:4px 8px; border-radius:6px; font-weight:bold; }
  .workflow .mail-address { font-size:12px; color:#afc6e1; margin:0 0 12px; }
  [data-mail-subject] { color:#f1f6ff; font-size:15px; }
  .workflow .mail-body { white-space:pre-line; color:#d4e3f5; font-size:14px; line-height:1.75; margin:18px 0; }
  .mail-attachment { display:flex; align-items:center; gap:12px; padding:13px; border:1px solid #5d7c9d; border-radius:8px; color:#d9edff; background:#213954; }
  .mail-attachment>span:first-child { font-size:26px; }
  .mail-attachment strong { font-size:12px; overflow-wrap:anywhere; }
  .mail-attachment small { display:block; margin-top:5px; color:#b7cfe9; font-size:11px; }
  [data-attachment-status] { margin-left:auto; font-size:10px; color:#a5f2ce; }
  .data-label { color:#a9caff; font:10px/1.7 monospace; }
  .workflow [data-data-text] { color:#bdd2e9; font-size:13px; line-height:1.7; margin:12px 0 18px; }
  .pdf-preview { background:#eaf1f8; color:#1b3048; padding:20px; border-radius:5px; box-shadow:0 8px 20px #0003; }
  .pdf-preview>div:first-child { display:flex; flex-direction:column; gap:8px; font-size:12px; }
  .workflow .pdf-preview p { color:#334b64; font-size:12px; line-height:1.8; margin:20px 0; }
  .pdf-total { display:flex; justify-content:space-between; align-items:center; border-top:1px solid #b2c3d4; padding-top:15px; font-size:13px; }
  .pdf-total strong { font-size:24px; color:#16324f; }
  .pdf-preview small { display:block; margin-top:18px; color:#4a627b; font-size:10px; }
  [data-resolved="true"] .mail-preview { border-color:#82d9b6; background:#142c2c; }
  @media(max-width:700px) { .invoice-preview { grid-template-columns:1fr; } .mail-preview,.data-preview { padding:16px; } .mail-attachment { flex-wrap:wrap; } }
  .case-button { padding:13px 16px; border:1px solid #7ca5e0; border-radius:9px; background:#285399; color:#fff; font-size:13px; cursor:pointer; }
  .workflow [data-mode] { color:#a8bfdc; font-size:11px; line-height:1.6; margin:0; }
  @media(max-width:900px) { .workflow { padding:24px; } .node { padding:12px; } .node strong { font-size:13px; } .node p { font-size:11px; } .case-row { align-items:start; flex-direction:column; } }
  @media(max-width:600px) {
