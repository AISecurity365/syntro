---
const steps = [
  { label: "Entender", title: "Tu empresa.", accent: "Su contexto.", detail: "Centralizamos y documentamos lo más importante: cómo trabajáis, vuestro conocimiento y los sistemas que utilizáis.", color: "#a5dfff" },
  { label: "Conectar", title: "Tus sistemas.", accent: "Conectados.", detail: "Con esa base documentada, conectamos las herramientas para que el agente pueda consultarlas y utilizarlas con permisos definidos.", color: "#bdaaff" },
  { label: "Aplicar", title: "Un agente.", accent: "La tarea en marcha.", detail: "El agente usa el contexto y las herramientas: trabaja con tu equipo, pide aprobación o ejecuta automáticamente según las reglas acordadas.", color: "#9af1d8" }
];
---
<div class="ci-art" data-consulting-art data-stage="0" data-playing="false" style="--art-accent:#a5dfff">
  <div class="ci-art-top"><span>DE LOS PROCESOS A LA PRÁCTICA</span><button type="button" data-art-play aria-label="Reproducir animación">▶ Reproducir</button></div>
  <div class="ci-art-heading"><h2><span data-art-title>{steps[0].title}</span><br/><span data-art-accent>{steps[0].accent}</span></h2></div>
  <div class="ci-art-scene" role="img" aria-label="Contexto y sistemas centralizados y documentados alimentan al agente IA. El equipo humano lo guía y aprueba; el agente realiza tareas en los sistemas con el nivel de autonomía acordado.">
    <div class="ci-foundation">
      <div class="ci-source"><span class="ci-node-icon">◎</span><strong>Contexto de empresa</strong><p>Procesos, clientes, criterios y conocimiento del equipo.</p></div>
      <div class="ci-source"><span class="ci-node-icon">⌘</span><strong>Sistemas y herramientas</strong><p>Correo, CRM, documentos y aplicaciones que ya utilizáis.</p></div>
      <div class="ci-foundation-caption">01 · CENTRALIZADOS Y DOCUMENTADOS</div>
    </div>
    <div class="ci-flow">
      <svg class="ci-connections" fill="none" viewBox="0 0 600 250" preserveAspectRatio="none" aria-hidden="true">
        <g class="ci-wires"><path d="M150 0V28Q150 42 170 42H280Q300 42 300 62V90"/><path d="M450 0V28Q450 42 430 42H320Q300 42 300 62V90"/><path d="M85 110H300"/><path d="M300 110H515"/></g>
        <g class="ci-packets"><path pathLength="100" d="M150 0V28Q150 42 170 42H280Q300 42 300 62V90"/><path pathLength="100" d="M450 0V28Q450 42 430 42H320Q300 42 300 62V90"/></g>
        <path class="ci-human-packet" pathLength="100" d="M85 110H300"/>
        <path class="ci-result-packet" pathLength="100" d="M300 110H515"/>
      </svg>
      <div class="ci-flow-nodes">
        <div class="ci-person"><span class="ci-flow-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></svg></span><strong>Tu equipo</strong><small>Guía y aprueba</small></div>
        <div class="ci-agent"><span class="ci-flow-icon">✦</span><strong>Agente IA</strong><small data-node-agent>Recibe contexto</small></div>
        <div class="ci-result"><span class="ci-flow-icon" data-node-result>···</span><strong>Tarea hecha</strong><small>En tus sistemas</small></div>
      </div>
      <div class="ci-operation"><span>Con tu equipo</span><span>Con aprobación</span><span>Automático</span></div>
    </div>
  </div>
  <div class="ci-task" aria-label="Simulación de una solicitud de soporte">
    <div class="ci-task-top"><span>EJEMPLO ILUSTRATIVO</span><span data-task-status>01 / Contexto</span></div>
    <div class="ci-task-row"><span class="ci-task-icon" data-task-icon aria-hidden="true">≡</span><div><strong data-task-title>Conocer al cliente</strong><p data-task-text>Contrato y reglas de atención</p></div></div>
    <div class="ci-task-track" aria-hidden="true"><span></span></div>
  </div>
  <div class="ci-art-bottom">
    <div class="ci-art-steps" role="group" aria-label="Etapas de la consultoría">
      {steps.map((step,i)=><button type="button" data-art-step data-title={step.title} data-accent={step.accent} data-detail={step.detail} data-color={step.color} aria-pressed={i===0 ? "true" : "false"} aria-controls="ci-art-detail"><span>0{i+1}</span>{step.label}</button>)}
    </div>
    <p id="ci-art-detail" aria-live="off">{steps[0].detail}</p>
    <span class="ci-art-footnote">CON PERMISOS Y REGLAS DEFINIDOS POR TU EQUIPO</span>
  </div>
</div>
<script>
  const art = document.querySelector<HTMLElement>('[data-consulting-art]');
  if (art) {
    const buttons = [...art.querySelectorAll<HTMLButtonElement>('[data-art-step]')];
    const play = art.querySelector<HTMLButtonElement>('[data-art-play]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const scenes = [
      {status:'01 / Contexto', title:'Conocer al cliente', text:'Contrato y reglas de atención', icon:'≡'},
      {status:'02 / Conexión', title:'Correo + CRM + soporte', text:'Información disponible para el agente', icon:'⇄'},
      {status:'03 / En curso', title:'Nueva solicitud recibida', text:'Consultando contexto y asignando responsable…', icon:'↗'},
      {status:'✓ Completada', title:'Ticket creado y asignado', text:'La tarea se ha realizado automáticamente.', icon:'✓'}
    ];
    let stage = 0;
    let paused = reduceMotion.matches;
    let visible = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const setText = (selector: string, text: string) => { art.querySelector(selector)!.textContent = text; };
    function render(manual = false) {
      const step = buttons[Math.min(stage, 2)];
      const scene = scenes[stage];
      art.dataset.stage = String(stage);
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button === step)));
      art.querySelector('#ci-art-detail')!.setAttribute('aria-live', manual ? 'polite' : 'off');
      setText('[data-art-title]', stage === 3 ? 'Y la tarea…' : step.dataset.title!);
      setText('[data-art-accent]', stage === 3 ? 'Ya está hecha.' : step.dataset.accent!);
      setText('#ci-art-detail', stage === 3 ? 'En este ejemplo, la solicitud queda registrada y asignada sin copiar datos a mano. Los casos fuera de las reglas pasan al equipo.' : step.dataset.detail!);
      art.style.setProperty('--art-accent', step.dataset.color!);
      setText('[data-task-status]', scene.status);
      setText('[data-task-title]', scene.title);
      setText('[data-task-text]', scene.text);
      setText('[data-task-icon]', scene.icon);
      setText('[data-node-agent]', ['Recibe contexto', 'Accede a herramientas', 'Realiza la tarea', 'Trabajo completado'][stage]);
      setText('[data-node-result]', stage === 3 ? '✓' : '···');
    }
    function schedule() {
      clearTimeout(timer);
      const running = !paused && visible && !document.hidden;
      art.dataset.playing = String(running);
      play.textContent = paused ? '▶ Reproducir' : 'Ⅱ Pausar';
      play.setAttribute('aria-label', paused ? 'Reproducir animación' : 'Pausar animación');
      if (running) timer = setTimeout(() => { stage = (stage + 1) % scenes.length; render(); schedule(); }, stage === 3 ? 6000 : 5000);
    }
    buttons.forEach((button, index) => button.addEventListener('click', () => {
      paused = true; stage = index; render(true); schedule();
    }));
    play.addEventListener('click', () => { paused = !paused; schedule(); });
    reduceMotion.addEventListener('change', () => { paused = reduceMotion.matches; schedule(); });
    document.addEventListener('visibilitychange', schedule);
    const observer = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      schedule();
    });
    observer.observe(art);
    render();
    schedule();
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(timer); observer.disconnect(); document.removeEventListener('visibilitychange', schedule);
    }, {once:true});
  }
</script>
<style>
  .ci-art { position:relative; isolation:isolate; border:1px solid #38415c; border-radius:22px; overflow:hidden; background:radial-gradient(ellipse at 72% 20%,#202340 0,transparent 65%),#0a101e; box-shadow:0 28px 100px #0005,inset 0 1px 0 #c5d6ff16; }
  .ci-art::before { content:""; position:absolute; inset:0; z-index:-1; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' opacity='.2' filter='url(%23n)'/%3E%3C/svg%3E"); opacity:.13; pointer-events:none; }
  .ci-art-top { display:flex; justify-content:space-between; padding:23px 26px 0; color:#b0bcd3; font:9px/1.5 monospace; letter-spacing:.14em; }
  [data-art-play] { border:1px solid #485574; border-radius:20px; padding:5px 9px; background:#172238; color:#dce9ff; font-size:10px; line-height:1.2; letter-spacing:0; cursor:pointer; white-space:nowrap; }
  .ci-art button:focus-visible { outline:2px solid #a5dfff; outline-offset:4px; }
  .ci-art-heading { padding:25px 26px 0; }
  .ci-art-heading h2 { color:#eff4ff; font-size:clamp(26px,2.8vw,38px); font-weight:500; letter-spacing:-.045em; line-height:1.12; margin:0; min-height:86px; }
  [data-art-accent] { color:var(--art-accent); transition:color .4s; }
  .ci-art-scene { margin:22px 24px 0; }
  .ci-foundation { display:grid; grid-template-columns:1fr 1fr; gap:14px; border:1px solid #6081ac; border-radius:16px; padding:18px 16px 12px; background:#15243c; }
  .ci-source { min-width:0; }
  .ci-source strong { display:block; font-size:14px; color:#ebf3ff; margin:10px 0 7px; }
  .ci-source p { font-size:12px; line-height:1.6; color:#bbcae0; margin:0; }
  .ci-node-icon { display:grid; place-items:center; width:32px; height:32px; border-radius:9px; background:#a5dfff16; color:#a5dfff; font-size:24px; }
  .ci-foundation-caption { grid-column:1/-1; border-top:1px solid #405775; padding-top:12px; color:#b5d7ff; font:9px/1.5 monospace; letter-spacing:.05em; }
  .ci-flow { position:relative; height:275px; }
  .ci-connections { position:absolute; inset:0; width:100%; height:250px; }
  .ci-wires { stroke:#526c90; stroke-width:1.5; }
  .ci-packets,.ci-human-packet,.ci-result-packet { stroke:#a5dfff; stroke-width:3; stroke-linecap:round; stroke-dasharray:7 93; animation:ci-packet 2.5s linear infinite; }
  .ci-human-packet { stroke:#bdaaff; animation-direction:alternate; opacity:0; }
  .ci-result-packet { stroke:#9af1d8; opacity:0; }
  .ci-flow-nodes { position:relative; padding-top:78px; display:grid; grid-template-columns:1fr 1.3fr 1fr; gap:24px; align-items:start; }
  .ci-flow-nodes>div { text-align:center; min-width:0; }
  .ci-flow-icon { position:relative; display:grid; place-items:center; margin:0 auto 12px; width:64px; height:64px; border:1px solid #607897; border-radius:18px; background:#17263d; color:#c6d9f2; font-size:30px; }
  .ci-agent .ci-flow-icon { background:#253b5d; border-color:#a5dfff; color:#a5dfff; box-shadow:0 0 0 7px #a5dfff0b; animation:ci-node-pulse 3s ease-in-out infinite; }
  .ci-flow-nodes strong { display:block; color:#e7f0ff; font-size:13px; }
  .ci-flow-nodes small { display:block; color:#adbed7; font-size:10px; margin-top:4px; min-height:28px; }
  .ci-result { opacity:.45; transition:opacity .5s; }
  .ci-operation { display:flex; justify-content:center; gap:7px; position:relative; margin-top:14px; }
  .ci-operation span { padding:5px 7px; border:1px solid #405371; border-radius:20px; color:#bdd0e8; font-size:9px; }
  .ci-art[data-stage="2"] .ci-human-packet,.ci-art[data-stage="2"] .ci-result-packet { opacity:1; }
  .ci-art[data-stage="2"] .ci-agent .ci-flow-icon { animation-duration:1s; }
  .ci-art[data-stage="3"] .ci-result { opacity:1; }
  .ci-art[data-stage="3"] .ci-result .ci-flow-icon { background:#20473e; border-color:#9af1d8; color:#9af1d8; }
  .ci-art[data-playing="false"] * { animation-play-state:paused; }
  @keyframes ci-packet { from { stroke-dashoffset:100; } to { stroke-dashoffset:0; } }
  @keyframes ci-node-pulse { 0%,100% { transform:translateY(0); box-shadow:0 0 0 5px #a5dfff08; } 50% { transform:translateY(-5px); box-shadow:0 0 0 12px #a5dfff14; } }
  @keyframes ci-complete { from { box-shadow:0 0 0 12px #9af1d830; } to { box-shadow:0 0 0 0 #9af1d800; } }
  .ci-task { margin:0 26px 20px; padding:13px 15px 0; border:1px solid #3b4862; border-radius:12px; background:#152136; overflow:hidden; transition:border-color .5s,background .5s; }
  .ci-task-top { display:flex; justify-content:space-between; gap:8px; color:#b5c4dc; font:9px/1.5 monospace; }
  [data-task-status] { color:var(--art-accent); }
  .ci-task-row { display:flex; align-items:center; gap:12px; padding:12px 0 14px; min-height:72px; }
  .ci-task-icon { display:grid; place-items:center; width:32px; height:32px; flex-shrink:0; border-radius:9px; background:#bdaaff18; color:var(--art-accent); font-size:21px; }
  .ci-task-row strong { display:block; color:#edf4ff; font-size:13px; }
  .ci-task-row p { margin:4px 0 0; color:#b5c4dc; font-size:11px; line-height:1.5; min-height:33px; }
  .ci-task-track { height:3px; margin:0 -15px; background:#26344c; }
  .ci-task-track span { display:block; height:100%; width:15%; background:var(--art-accent); transition:width 1.2s ease; }
  .ci-art[data-stage="1"] .ci-task-track span { width:40%; }
  .ci-art[data-stage="2"] .ci-task-track span { width:70%; }
  .ci-art[data-stage="3"] .ci-task-track span { width:100%; }
  .ci-art[data-stage="3"] .ci-task { border-color:#64b8a0; background:#17302f; }
  .ci-art[data-stage="3"] .ci-task-icon { animation:ci-complete .8s ease-out; background:#9af1d822; }
  .ci-art-bottom { padding:0 26px 24px; }
  .ci-art-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:5px; border-top:1px solid #38415c; }
  .ci-art-steps button { background:none; padding:17px 0 12px; text-align:left; border:0; border-top:2px solid transparent; margin-top:-1px; color:#b5bfd3; font-size:12px; cursor:pointer; display:flex; gap:9px; align-items:center; transition:color .2s,border-color .2s; }
  .ci-art-steps button span { font:9px/1 monospace; opacity:.8; }
  .ci-art-steps button[aria-pressed="true"] { color:var(--art-accent); border-top-color:var(--art-accent); }
  .ci-art-steps button:hover { color:#fff; }
  .ci-art-bottom #ci-art-detail { font-size:13px; line-height:1.65; color:#b3bfd5; margin:4px 0 19px; min-height:65px; }
  .ci-art-footnote { font:8px/1.5 monospace; color:#9baac4; letter-spacing:.14em; }
  @media(max-width:680px) {
    .ci-art-heading h2 { font-size:29px; min-height:68px; }
    .ci-art-top { font-size:8px; padding:20px 20px 0; }
    .ci-art-heading { padding:22px 20px 0; }
    .ci-task { margin:0 20px 18px; }
    .ci-art-top { align-items:center; gap:10px; }
    .ci-art-bottom { padding:0 20px 22px; }
    .ci-art-steps button { font-size:11px; gap:6px; }
    .ci-art-scene { margin:20px 16px 0; }
    .ci-foundation { padding:14px 12px 10px; gap:12px; }
    .ci-source strong { font-size:12px; }
    .ci-source p { font-size:11px; }
    .ci-flow-nodes { gap:10px; }
    .ci-flow-icon { width:54px; height:54px; }
    .ci-operation { gap:4px; }
    .ci-operation span { font-size:8px; padding:5px; }
    .ci-art-bottom #ci-art-detail { min-height:86px; }
  }
  @media(prefers-reduced-motion:reduce) { .ci-art * { animation:none; transition:none; } }
</style>
