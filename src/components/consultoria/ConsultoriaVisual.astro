---
const steps = [
  { title: 'Documentar y conectar', description: 'Documentamos el contexto de tu empresa y damos acceso a los sistemas y herramientas que necesita el agente.', icon: '◎', nodes: ['Procesos y conocimiento', 'Clientes y criterios', 'Sistemas y permisos'], result: 'Una base centralizada y documentada.' },
  { title: 'Configurar y educar al agente', description: 'Le enseñamos cómo usar ese contexto y solo las herramientas justas y necesarias para su tarea.', icon: '✦', nodes: ['Instrucciones claras', 'Herramientas necesarias', 'Pruebas con tu equipo'], result: 'Sabe qué hacer, cómo hacerlo y cuándo preguntar.' },
  { title: 'Realizar la tarea', description: 'El agente utiliza lo aprendido y actúa en tus sistemas: junto a una persona, con su aprobación o automáticamente.', icon: '✓', nodes: ['Recibe una petición', 'Consulta y actúa', 'Entrega el resultado'], result: 'El trabajo se completa con las reglas acordadas.' },
];
---
<div class="workflow" data-workflow data-playing="false">
  <div class="workflow-head">
    <div><p class="eyebrow">DE LOS PROCESOS A LA PRÁCTICA</p><h2>Primero, tu empresa.<br/><span>Después, un agente que sabe trabajar en ella.</span></h2></div>
    <button type="button" class="play" data-workflow-play>Pausar recorrido</button>
  </div>
  <div class="steps" role="group" aria-label="Los tres pasos de implantación">
    {steps.map((step, i) => <button type="button" class="step" data-step={i} aria-pressed={i === 0 ? 'true' : 'false'}>
      <span class="step-number">PASO {i + 1}</span>
      <span class="node-icon" aria-hidden="true">{step.icon}</span>
      <strong class="step-title">{step.title}</strong>
      <span class="step-description">{step.description}</span>
      <span class="node-list">{step.nodes.map(node => <span>{node}</span>)}</span>
      <span class="step-result">{step.result}</span>
      {i < 2 && <span class="connector" aria-hidden="true"><span></span>→</span>}
    </button>)}
  </div>
  <div class="case-toggle-row">
    <p>Del concepto a una situación del día a día.</p>
    <button type="button" class="case-toggle" aria-expanded="false" aria-controls="invoice-example">¿Cómo sería esto con un caso real? <span aria-hidden="true">↗</span></button>
  </div>
  <section id="invoice-example" class="invoice-example" hidden aria-labelledby="invoice-title">
    <div class="case-heading"><div><p class="eyebrow">EJEMPLO ILUSTRATIVO · DATOS FICTICIOS</p><h3 id="invoice-title">«Hola, ¿me podéis enviar mi factura?»</h3><p>Así podría resolverlo un agente conectado al ERP y a Gmail de tu empresa.</p></div><button type="button" class="play" data-case-restart>Reiniciar ejemplo ↺</button></div>
    <div class="case-context"><strong>Lo que hemos preparado antes</strong><span>Cómo identificar al cliente y localizar su factura · Acceso de consulta al ERP · Permisos de Gmail · Aprobación humana antes de enviar.</span></div>
    <ol class="invoice-nodes">
      <li data-case-node="0"><span class="app-icon gmail" aria-hidden="true"><svg viewBox="0 0 32 24"><path fill="#4285f4" d="M0 5h5v19H0z"/><path fill="#34a853" d="M27 5h5v19h-5z"/><path fill="#ea4335" d="M0 0h5l11 9L27 0h5v7L16 19 0 7z"/><path fill="#fbbc04" d="m27 0 5 4v3l-5 4z"/></svg></span><strong>1. Gmail</strong><span>Llega la petición del cliente.</span></li>
      <li data-case-node="1"><span class="app-icon erp" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="16" cy="7" rx="11" ry="4"/><path d="M5 7v18c0 5 22 5 22 0V7M5 16c0 5 22 5 22 0"/></svg></span><strong>2. ERP</strong><span>El agente consulta la factura.</span></li>
      <li data-case-node="2"><span class="app-icon human" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="16" cy="9" r="5"/><path d="M5 29v-3a11 11 0 0 1 22 0v3"/></svg></span><strong>3. Tu equipo</strong><span>Revisa y aprueba la respuesta.</span></li>
      <li data-case-node="3"><span class="app-icon gmail" aria-hidden="true"><svg viewBox="0 0 32 24"><path fill="#4285f4" d="M0 5h5v19H0z"/><path fill="#34a853" d="M27 5h5v19h-5z"/><path fill="#ea4335" d="M0 0h5l11 9L27 0h5v7L16 19 0 7z"/><path fill="#fbbc04" d="m27 0 5 4v3l-5 4z"/></svg></span><strong>4. Gmail</strong><span>Envía la factura al cliente.</span></li>
    </ol>
    <div class="case-detail" aria-live="polite"><span data-case-count>01 / 04</span><div><strong data-case-title>El agente lee la petición en Gmail</strong><p data-case-text>«Hola, soy Marta de Empresa Ejemplo. ¿Podéis enviarme la factura de agosto?» Identifica al cliente siguiendo las reglas documentadas.</p></div></div>
    <div class="case-footer"><p>En este ejemplo se pide aprobación. También podemos configurar tareas automáticas. Si falta información o no se puede verificar el cliente, el agente consulta al equipo.</p><button type="button" class="case-next" data-case-next>Siguiente: consultar el ERP →</button></div>
  </section>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-workflow]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const play = root.querySelector<HTMLButtonElement>('[data-workflow-play]')!;
    const toggle = root.querySelector<HTMLButtonElement>('.case-toggle')!;
    const example = root.querySelector<HTMLElement>('#invoice-example')!;
    const next = root.querySelector<HTMLButtonElement>('[data-case-next]')!;
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = motion.matches, visible = false, step = 0, caseStep = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const cases = [
      ['El agente lee la petición en Gmail', '«Hola, soy Marta de Empresa Ejemplo. ¿Podéis enviarme la factura de agosto?» Identifica al cliente siguiendo las reglas documentadas.', 'Siguiente: consultar el ERP →'],
      ['Consulta el ERP con el contexto del cliente', 'Localiza la ficha de Empresa Ejemplo, comprueba que la factura corresponde a ese cliente y recupera el PDF F-2026-0842. Solo consulta los datos necesarios.', 'Siguiente: revisar la respuesta →'],
      ['Prepara el correo y pide aprobación', '«Hola, Marta. Te adjunto vuestra factura de agosto. Un saludo.» El equipo comprueba el destinatario, el texto y el PDF antes de autorizar el envío.', 'Simular aprobación y envío →'],
      ['Factura enviada desde Gmail', 'Con la aprobación recibida, el agente envía el correo con la factura adjunta. La petición queda atendida sin buscar y copiar datos manualmente entre aplicaciones.', 'Volver a ver el ejemplo ↺'],
    ];
    function renderCase() {
      root!.querySelectorAll<HTMLElement>('[data-case-node]').forEach((node, i) => { node.dataset.active = String(i === caseStep); node.dataset.done = String(i < caseStep); });
      root!.querySelector('[data-case-count]')!.textContent = `0${caseStep + 1} / 04`;
      root!.querySelector('[data-case-title]')!.textContent = cases[caseStep][0];
      root!.querySelector('[data-case-text]')!.textContent = cases[caseStep][1];
      next.textContent = cases[caseStep][2];
    }
    function schedule() {
      clearTimeout(timer);
      const running = !paused && visible && !document.hidden;
      root!.dataset.playing = String(running);
      play.textContent = paused ? 'Reproducir recorrido' : 'Pausar recorrido';
      steps.forEach((button, i) => button.setAttribute('aria-pressed', String(i === step)));
      if (running) timer = setTimeout(() => { step = (step + 1) % steps.length; schedule(); }, 6000);
    }
    steps.forEach((button, i) => button.addEventListener('click', () => { step = i; paused = true; schedule(); }));
    play.addEventListener('click', () => { paused = !paused; schedule(); });
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open)); example.hidden = !open;
      if (open) { paused = true; caseStep = 0; renderCase(); schedule(); }
    });
    next.addEventListener('click', () => { caseStep = (caseStep + 1) % cases.length; renderCase(); });
    root.querySelector('[data-case-restart]')!.addEventListener('click', () => { caseStep = 0; renderCase(); });
    const onMotion = () => { paused = motion.matches; schedule(); };
    motion.addEventListener('change', onMotion);
    document.addEventListener('visibilitychange', schedule);
    const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; schedule(); });
    observer.observe(root); renderCase(); schedule();
    document.addEventListener('astro:before-swap', () => { clearTimeout(timer); observer.disconnect(); motion.removeEventListener('change', onMotion); document.removeEventListener('visibilitychange', schedule); }, { once: true });
  }
</script>
<style>
  .workflow { padding:38px; border:1px solid #3e5271; border-radius:24px; background:radial-gradient(ellipse at 50% 0,#21314c,transparent 65%),#101a2b; }
  .workflow-head,.case-heading { display:flex; justify-content:space-between; align-items:start; gap:24px; }
  .workflow .eyebrow { color:#a9c9f2; font:10px/1.6 monospace; letter-spacing:.12em; margin:0 0 15px; }
  .workflow h2 { margin:0; font-size:clamp(27px,3vw,40px); line-height:1.2; letter-spacing:-.035em; color:#f0f6ff; }
  h2 span { color:#a9c9f2; }
  .play { padding:10px 14px; border:1px solid #657b9a; border-radius:20px; background:#16253a; color:#dceaff; font-size:12px; white-space:nowrap; cursor:pointer; }
  button:focus-visible { outline:2px solid #b3ddff; outline-offset:5px; }
  .steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:40px; margin:38px 0; }
  .step { position:relative; display:flex; flex-direction:column; align-items:start; text-align:left; min-width:0; border:1px solid #455b7a; border-radius:16px; padding:24px; color:#e9f2ff; background:#142238; cursor:pointer; transition:border-color .4s,background .4s,box-shadow .4s; }
  .step[aria-pressed="true"] { border-color:#a5dfff; background:#1b314d; box-shadow:0 0 30px #87bfff13; }
  .step-number { font:12px monospace; letter-spacing:.12em; color:#b1d8ff; }
  .node-icon { display:grid; place-items:center; width:56px; height:56px; margin:22px 0; border-radius:15px; background:#94c7ff12; border:1px solid #779ac4; font-size:30px; color:#b7dcff; }
  .step[aria-pressed="true"] .node-icon { animation:node-pulse 2s ease-in-out infinite; }
  .step-title { font-size:21px; line-height:1.3; min-height:55px; }
  .step-description { color:#bacbe1; font-size:14px; line-height:1.7; margin:12px 0 20px; }
  .node-list { display:flex; flex-direction:column; gap:8px; width:100%; margin-top:auto; }
  .node-list>span { padding:10px 12px; border:1px solid #415a7b; border-radius:8px; background:#0d1a2b; font-size:12px; }
  .step-result { color:#b2e9d7; font-size:12px; line-height:1.6; margin-top:20px; min-height:39px; }
  .connector { position:absolute; left:100%; top:50%; width:40px; color:#a5dfff; text-align:right; font-size:19px; }
  .connector::before { content:""; position:absolute; height:1px; background:#678dbb; left:0; right:0; top:50%; }
  .connector>span { position:absolute; width:7px; height:7px; border-radius:50%; top:calc(50% - 3px); background:#c5e7ff; opacity:0; }
  .step[aria-pressed="true"] .connector>span { animation:travel 2s linear infinite; }
  .invoice-nodes li[data-active="true"]:not(:last-child)::after { animation:case-travel 1.8s linear infinite; color:#d2edff; }
  @keyframes case-travel { from { transform:translateX(-5px); opacity:.25; } to { transform:translateX(5px); opacity:1; } }
  .workflow[data-playing="false"] .steps * { animation-play-state:paused; }
  @keyframes travel { from { left:0; opacity:0; } 25% { opacity:1; } to { left:90%; opacity:0; } }
  @keyframes node-pulse { 50% { transform:translateY(-4px); box-shadow:0 0 0 7px #a5dfff0b; } }
  .case-toggle-row { display:flex; justify-content:space-between; align-items:center; gap:20px; padding-top:24px; border-top:1px solid #3c516e; }
  .workflow p { color:#b8cae2; font-size:14px; line-height:1.7; margin:0; }
  .case-toggle,.case-next { border:1px solid #82aeec; border-radius:9px; padding:14px 18px; background:#285399; color:#fff; font-size:14px; font-weight:600; cursor:pointer; }
  .case-toggle span { margin-left:14px; }
  .invoice-example { margin-top:30px; padding-top:30px; border-top:1px solid #3c516e; }
  .invoice-example[hidden] { display:none; }
  .workflow h3 { color:#f0f6ff; font-size:25px; line-height:1.3; margin:0 0 12px; }
  .case-context { display:flex; gap:20px; padding:18px; margin:24px 0 30px; background:#1b2b43; border-radius:10px; font-size:13px; line-height:1.7; color:#bdd0e9; }
  .case-context strong { flex-shrink:0; color:#e3efff; }
  .invoice-nodes { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:32px; padding:0; margin:0 0 28px; list-style:none; }
  .invoice-nodes li { position:relative; border:1px solid #455d7c; background:#122137; border-radius:12px; padding:18px; transition:border-color .3s,background .3s; }
  .invoice-nodes li:not(:last-child)::after { content:'→'; position:absolute; left:100%; width:32px; text-align:center; top:42px; color:#8eb9ec; }
  .invoice-nodes li[data-active="true"] { border-color:#b6ddff; background:#243e60; }
  .invoice-nodes li[data-done="true"] { border-color:#75c7ab; }
  .app-icon { display:grid; place-items:center; width:48px; height:48px; background:#213752; border-radius:12px; color:#b9d7ff; margin-bottom:14px; }
  .app-icon svg { width:28px; height:28px; }
  .gmail { background:#fff; }
  .invoice-nodes strong { display:block; color:#edf5ff; font-size:15px; margin-bottom:6px; }
  .invoice-nodes li>span:last-child { color:#bed0e7; font-size:12px; line-height:1.6; }
  .case-detail { display:flex; gap:24px; padding:24px; border:1px solid #5c7ba3; border-radius:12px; background:#1b304b; min-height:145px; }
  [data-case-count] { color:#b3dcff; font:13px monospace; white-space:nowrap; }
  [data-case-title] { display:block; color:#f0f6ff; font-size:18px; margin-bottom:10px; }
  .case-footer { display:flex; justify-content:space-between; align-items:center; gap:30px; margin-top:22px; }
  .case-footer p { font-size:12px; max-width:65ch; }
  .case-next { flex-shrink:0; }
  @media(max-width:1000px) { .workflow { padding:25px; } .steps { gap:24px; } .step { padding:18px; } .connector { width:24px; } .step-title { font-size:18px; } .case-toggle-row,.case-footer { align-items:start; flex-direction:column; } .case-context { flex-direction:column; gap:6px; } }
  @media(max-width:700px) { .workflow { padding:22px 18px; } .workflow-head,.case-heading { flex-direction:column; } .steps { grid-template-columns:1fr; gap:30px; } .step-title,.step-result { min-height:0; } .node-icon { margin:16px 0; } .connector { left:50%; top:100%; height:30px; width:1px; font-size:0; } .connector::before { height:30px; width:1px; top:0; } .connector>span { display:none; } .invoice-nodes { grid-template-columns:1fr 1fr; gap:12px; } .invoice-nodes li { padding:14px; } .invoice-nodes li::after { display:none; } .case-detail { flex-direction:column; gap:12px; padding:18px; } .case-next,.case-toggle { width:100%; } }
  @media(prefers-reduced-motion:reduce) { .workflow * { animation:none !important; transition:none !important; } }
</style>
