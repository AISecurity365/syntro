---
// Formulario de candidatura para el Programa de Partners Wazuh LATAM — tema oscuro (estilo /wazuh)
---

<section id="candidatura" class="relative py-16 pb-24 overflow-hidden" style="background:#020817;">
  <!-- Grid de fondo -->
  <div class="absolute inset-0 pointer-events-none" style="background-image:linear-gradient(rgba(59,130,246,0.12) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,0.12) 1px,transparent 1px);background-size:40px 40px;opacity:0.6;"></div>
  <!-- Gradiente radial -->
  <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 80% 60% at 50% 20%,rgba(37,99,235,0.15) 0%,transparent 65%);"></div>

  <div class="relative max-w-2xl mx-auto px-6 md:px-10">

    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4 tracking-tight" style="color:#f0f6ff;">
        Súmate al programa
      </h2>
      <p class="text-lg max-w-xl mx-auto" style="color:rgba(240,246,255,0.65);">
        Cuéntanos quién eres y en qué país trabajas. Después de tu candidatura haremos una videollamada para ver si funciona y cómo trabajar juntos.
      </p>
    </div>

    <div id="partner-alert" class="mb-6 hidden"></div>

    <div class="rounded-2xl overflow-hidden" style="background:rgba(255,255,255,0.03);border:1px solid rgba(59,130,246,0.2);backdrop-filter:blur(12px);">
      <div class="px-6 py-4 flex items-center gap-3" style="background:rgba(37,99,235,0.15);border-bottom:1px solid rgba(59,130,246,0.2);">
        <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:rgba(59,130,246,0.2);">
          <svg class="w-4 h-4" fill="none" stroke="#60a5fa" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-3.13a4 4 0 10-4-4 4 4 0 004 4z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold" style="color:#f0f6ff;">Candidatura de partner</h3>
          <p class="text-xs" style="color:rgba(240,246,255,0.5);">Los campos con * son obligatorios</p>
        </div>
      </div>

      <div class="p-7">
        <form id="partner-form" class="space-y-5">

          <!-- Nombre -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color:rgba(240,246,255,0.5);">Nombre completo *</label>
            <input type="text" id="p-nombre" name="nombre" required
              class="w-full px-4 py-3 rounded-xl text-sm font-medium outline-none transition-all"
              style="background:rgba(255,255,255,0.05);border:1px solid rgba(59,130,246,0.2);color:#f0f6ff;"
              placeholder="Tu nombre y apellidos"
              onfocus="this.style.borderColor='rgba(59,130,246,0.6)';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.1)'"
              onblur="this.style.borderColor='rgba(59,130,246,0.2)';this.style.boxShadow='none'"
            />
          </div>

          <!-- País -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color:rgba(240,246,255,0.5);">País *</label>
            <select id="p-pais" name="pais" required
              class="w-full px-4 py-3 rounded-xl text-sm font-medium outline-none transition-all"
              style="background:#0b1220;border:1px solid rgba(59,130,246,0.2);color:#f0f6ff;"
              onfocus="this.style.borderColor='rgba(59,130,246,0.6)';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.1)'"
              onblur="this.style.borderColor='rgba(59,130,246,0.2)';this.style.boxShadow='none'">
              <option value="" disabled selected>Selecciona tu país</option>
              <option value="México">México</option>
              <option value="Colombia">Colombia</option>
              <option value="Argentina">Argentina</option>
              <option value="Chile">Chile</option>
              <option value="Perú">Perú</option>
              <option value="Ecuador">Ecuador</option>
              <option value="Uruguay">Uruguay</option>
              <option value="Paraguay">Paraguay</option>
              <option value="Bolivia">Bolivia</option>
              <option value="Venezuela">Venezuela</option>
              <option value="Costa Rica">Costa Rica</option>
              <option value="Panamá">Panamá</option>
              <option value="Guatemala">Guatemala</option>
              <option value="El Salvador">El Salvador</option>
              <option value="Honduras">Honduras</option>
              <option value="Nicaragua">Nicaragua</option>
              <option value="Rep. Dominicana">República Dominicana</option>
              <option value="Puerto Rico">Puerto Rico</option>
              <option value="Otro">Otro</option>
            </select>
          </div>

          <!-- Email -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color:rgba(240,246,255,0.5);">Email *</label>
            <input type="email" id="p-email" name="email" required
              class="w-full px-4 py-3 rounded-xl text-sm font-medium outline-none transition-all"
              style="background:rgba(255,255,255,0.05);border:1px solid rgba(59,130,246,0.2);color:#f0f6ff;"
              placeholder="tu@email.com"
              onfocus="this.style.borderColor='rgba(59,130,246,0.6)';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.1)'"
              onblur="this.style.borderColor='rgba(59,130,246,0.2)';this.style.boxShadow='none'"
            />
          </div>

          <!-- WhatsApp -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color:rgba(240,246,255,0.5);">WhatsApp / Teléfono *</label>
            <input type="tel" id="p-telefono" name="telefono" required
              class="w-full px-4 py-3 rounded-xl text-sm font-medium outline-none transition-all"
              style="background:rgba(255,255,255,0.05);border:1px solid rgba(59,130,246,0.2);color:#f0f6ff;"
              placeholder="+52 55 0000 0000"
              onfocus="this.style.borderColor='rgba(59,130,246,0.6)';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.1)'"
              onblur="this.style.borderColor='rgba(59,130,246,0.2)';this.style.boxShadow='none'"
            />
          </div>

          <!-- LinkedIn / Web -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color:rgba(240,246,255,0.5);">LinkedIn o web (opcional)</label>
            <input type="url" id="p-perfil" name="perfil"
              class="w-full px-4 py-3 rounded-xl text-sm font-medium outline-none transition-all"
              style="background:rgba(255,255,255,0.05);border:1px solid rgba(59,130,246,0.2);color:#f0f6ff;"
              placeholder="https://linkedin.com/in/tu-perfil"
              onfocus="this.style.borderColor='rgba(59,130,246,0.6)';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.1)'"
              onblur="this.style.borderColor='rgba(59,130,246,0.2)';this.style.boxShadow='none'"
            />
          </div>

          <!-- Experiencia -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider mb-2" style="color:rgba(240,246,255,0.5);">Tu experiencia en ciberseguridad / TI y tu red de contactos (opcional)</label>
            <textarea id="p-experiencia" name="experiencia" rows="3"
              class="w-full px-4 py-3 rounded-xl text-sm font-medium outline-none transition-all resize-none"
              style="background:rgba(255,255,255,0.05);border:1px solid rgba(59,130,246,0.2);color:#f0f6ff;"
              placeholder="Ej: 6 años como consultor IT, cartera de PyMEs y organismos públicos en mi región, conozco Wazuh/SIEM..."
              onfocus="this.style.borderColor='rgba(59,130,246,0.6)';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.1)'"
              onblur="this.style.borderColor='rgba(59,130,246,0.2)';this.style.boxShadow='none'"
            ></textarea>
          </div>

          <!-- Nota videollamada -->
          <div class="rounded-xl p-4 flex items-start gap-3" style="background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.22);">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="#60a5fa" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <p class="text-sm" style="color:rgba(240,246,255,0.7);line-height:1.5;">Después de recibir tu candidatura haremos una <strong style="color:#93c5fd;">videollamada</strong> para conocernos y ver si funciona.</p>
          </div>

          <button type="submit" id="p-submit"
            class="w-full px-6 py-4 rounded-xl font-bold text-sm transition-all"
            style="background:linear-gradient(135deg,#2563eb,#1d4ed8);color:white;box-shadow:0 6px 20px rgba(37,99,235,0.4);"
            onmouseover="this.style.opacity='0.92';this.style.transform='translateY(-1px)'"
            onmouseout="this.style.opacity='1';this.style.transform='translateY(0)'">
            <span id="p-btn-text">Enviar candidatura</span>
            <span id="p-btn-spinner" class="inline-flex items-center gap-2" style="display:none;">
              <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Enviando...
            </span>
          </button>
        </form>

        <div id="partner-success" class="hidden mt-6">
          <div class="rounded-2xl p-6 text-center" style="background:linear-gradient(135deg,rgba(34,197,94,0.12),rgba(16,185,129,0.08));border:1px solid rgba(74,222,128,0.28);">
            <div class="text-5xl mb-3">🤝</div>
            <h4 class="text-xl font-bold mb-2" style="color:#f0f6ff;">¡Candidatura recibida!</h4>
            <p class="text-sm font-medium" style="color:#4ade80;">Te escribimos en menos de 48 horas para agendar una videollamada y ver si encajamos.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  input::placeholder, textarea::placeholder { color: rgba(240,246,255,0.25); }
  #partner-form select option { background:#0b1220; color:#f0f6ff; }
</style>

<script>
  const form = document.getElementById('partner-form') as HTMLFormElement;
  const submitBtn = document.getElementById('p-submit') as HTMLButtonElement;
  const btnText = document.getElementById('p-btn-text');
  const btnSpinner = document.getElementById('p-btn-spinner');
  const successMessage = document.getElementById('partner-success');
  const alertContainer = document.getElementById('partner-alert');

  function showAlert(message: string, type: 'success' | 'error' = 'error') {
    if (!alertContainer) return;
    alertContainer.style.cssText = type === 'success'
      ? 'background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.25);color:#4ade80;padding:12px 16px;border-radius:12px;'
      : 'background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.25);color:#fca5a5;padding:12px 16px;border-radius:12px;';
    alertContainer.innerHTML = `<p class="text-sm font-medium">${message}</p>`;
    alertContainer.classList.remove('hidden');
    setTimeout(() => alertContainer.classList.add('hidden'), 6000);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) { submitBtn.disabled = true; submitBtn.style.opacity = '0.6'; }
    if (btnText) btnText.style.display = 'none';
    if (btnSpinner) btnSpinner.style.display = 'inline-flex';

    const formData = new FormData(form);
    const data = {
      nombre: formData.get('nombre'),
      pais: formData.get('pais'),
      email: formData.get('email'),
      telefono: formData.get('telefono'),
      perfil: formData.get('perfil') || '',
      experiencia: formData.get('experiencia') || '',
    };

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 20000);

    try {
      const response = await fetch('/api/send-partner-application', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        signal: controller.signal,
      });
      clearTimeout(timeoutId);

      const result = await response.json();

      if (response.ok) {
        form.classList.add('hidden');
        if (successMessage) {
          successMessage.classList.remove('hidden');
          successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } else {
        throw new Error(result.error || 'Error al enviar la candidatura');
      }
    } catch (error) {
      clearTimeout(timeoutId);
      console.error('Error:', error);
      const isTimeout = error instanceof DOMException && error.name === 'AbortError';
      showAlert(
        isTimeout
          ? '⏱️ La solicitud está tardando demasiado. Revisa tu conexión e inténtalo de nuevo.'
          : '❌ Error al enviar la candidatura. Por favor, inténtalo de nuevo.',
        'error'
      );
      if (submitBtn) { submitBtn.disabled = false; submitBtn.style.opacity = '1'; }
      if (btnText) btnText.style.display = '';
      if (btnSpinner) btnSpinner.style.display = 'none';
    }
  });
</script>