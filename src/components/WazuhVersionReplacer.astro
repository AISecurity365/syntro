---
interface Props {
  defaultVersion?: string;
}
const { defaultVersion = "4.9.2-1" } = Astro.props;
---

<div class="wv-replacer" data-default={defaultVersion} style="background:rgba(129,140,248,0.08);border:1px solid rgba(129,140,248,0.25);border-radius:10px;padding:1rem 1.25rem;margin:1.75rem 0;">
  <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
    <span style="font-size:1.1rem;line-height:1;">📦</span>
    <strong style="color:#e2e8f0;font-size:0.875rem;">Adapta los comandos a tu versión de Wazuh</strong>
    <div style="display:flex;align-items:center;gap:0.5rem;margin-left:auto;">
      <label for="wv-input" style="color:#94a3b8;font-size:0.8rem;white-space:nowrap;max-width:none;">Versión:</label>
      <input
        id="wv-input"
        type="text"
        placeholder={defaultVersion}
        style="background:#0f1419;border:1px solid rgba(129,140,248,0.35);border-radius:6px;padding:5px 10px;color:#a5b4fc;font-family:monospace;font-size:0.875rem;width:110px;outline:none;transition:border-color 0.15s;"
        onfocus="this.style.borderColor='rgba(129,140,248,0.7)'"
        onblur="this.style.borderColor='rgba(129,140,248,0.35)'"
      />
    </div>
  </div>
  <p style="color:#64748b;font-size:0.775rem;margin:0.5rem 0 0;max-width:none;">Los bloques de código de esta guía se actualizan con la versión que escribas. Encuéntrala en <a href="https://github.com/wazuh/wazuh/releases" target="_blank" rel="noopener" style="color:#818cf8;">github.com/wazuh/wazuh/releases</a>.</p>
</div>

<script is:inline>
(function () {
  var el = document.querySelector('.wv-replacer');
  if (!el) return;
  var defaultVer = el.dataset.default || '4.9.2-1';
  var LS_KEY = 'wazuh-version';
  var PLACEHOLDER = '__WAZUH_VERSION__';

  var input = document.getElementById('wv-input');
  if (!input) return;

  var saved = localStorage.getItem(LS_KEY);
  var currentVer = saved || defaultVer;
  input.value = currentVer;

  var blocks = Array.from(document.querySelectorAll('pre code'));
  var originals = blocks.map(function (b) { return b.textContent; });

  function apply(ver) {
    blocks.forEach(function (block, i) {
      if (originals[i].indexOf(PLACEHOLDER) !== -1) {
        block.textContent = originals[i].split(PLACEHOLDER).join(ver);
      }
    });
  }

  apply(currentVer);

  input.addEventListener('input', function () {
    var v = input.value.trim();
    if (!v) return;
    localStorage.setItem(LS_KEY, v);
    apply(v);
  });
})();
</script>